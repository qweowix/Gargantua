<!-- Значок плеера в уведомлении и на локскрине: чёрная дыра — светящееся кольцо горизонта и наклонный
     аккреционный диск вокруг него. Одноцветный: система сама красит такие значки под тему -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- кольцо горизонта: толстое снизу (ближний край диска заслоняет), тоньше сверху -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,5.6a6.4,6.4 0,1 1,0 12.8a6.4,6.4 0,1 1,0 -12.8zM12,7.9a4.2,4.0 0,1 0,0 8.0a4.2,4.0 0,1 0,0 -8.0z" />
    <!-- диск: наклонный эллипс, дальняя половина за кольцом не видна — рисуем только ближнюю и концы -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-18">
        <path
            android:pathData="M1.6,12.2C1.6,14.4 6.3,16.1 12,16.1C17.7,16.1 22.4,14.4 22.4,12.2C22.4,10.9 20.9,9.8 18.5,9.1"
            android:strokeWidth="1.7"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M5.5,9.1C3.1,9.8 1.6,10.9 1.6,12.2"
            android:strokeWidth="1.7"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
    </group>
</vector>
