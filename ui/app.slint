// подсказка у кнопки: кнопка под мышью пишет сюда текст и где она стоит, окно рисует плашку поверх всего
global Tip {
    in-out property <string> text;
    in-out property <length> x;      // центр кнопки
    in-out property <length> top;    // верх и низ кнопки — плашка встаёт под ней или над ней
    in-out property <length> bottom;
}

component Icon inherits Path {
    in property <string> d;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.d;
    fill: Theme.text;
    fill-rule: evenodd;
}

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <length> size: 36px;
    in property <bool> primary;
    in property <bool> active;
    in property <bool> danger;
    in property <float> glow;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    // включённая кнопка (повтор, очередь…) — с подложкой: одним цветом иконки в «Моно» не отличить
    background: root.primary ? Theme.accent : root.active ? Theme.c1.transparentize(ta.has-hover ? 0.65 : 0.78) : (ta.has-hover ? #ffffff16 : #ffffff00);
    drop-shadow-blur: root.primary ? 16px : 0px;
    drop-shadow-color: root.primary ? Theme.c1.transparentize(0.33) : #00000000;
    if root.primary: Rectangle {
        x: -root.size * 0.6;
        y: -root.size * 0.6;
        width: root.size * 2.2;
        height: root.size * 2.2;
        background: @radial-gradient(circle, Theme.soft1.transparentize(1 - 0.7 * root.glow) 0%, Theme.c2.transparentize(1) 68%);
    }
    Icon {
        d: root.icon;
        width: root.size * (root.primary ? 0.44 : 0.5);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        fill: root.danger && ta.has-hover ? #ff5a6e : root.active ? Theme.soft2 : (root.primary || ta.has-hover) ? #ffffff : #bdb6d3;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Tip.text = "";
            root.clicked();
        }
        changed has-hover => {
            if self.has-hover && root.tip != "" {
                Tip.text = root.tip;
                Tip.x = root.absolute-position.x + root.width / 2;
                Tip.top = root.absolute-position.y;
                Tip.bottom = root.absolute-position.y + root.height;
            } else if !self.has-hover && Tip.text == root.tip {
                Tip.text = "";
            }
        }
    }
}

component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> danger;
    in property <bool> active;
    in property <bool> off;
    callback clicked();
    height: 38px;
    border-radius: 8px;
    background: ta.has-hover && !root.off ? #ffffff14 : #ffffff00;
    opacity: root.off ? 0.5 : 1;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                width: 16px;
                height: 16px;
                fill: root.danger ? #ff5a6e : root.active ? Theme.soft2 : Theme.text;
            }
        }

        Text {
            text: root.text;
            color: root.danger ? #ff5a6e : root.active ? Theme.soft2 : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: root.off ? default : pointer;
        clicked => {
            if !root.off {
                root.clicked();
            }
        }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> danger;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    callback clicked();
    height: 42px;
    horizontal-stretch: 0; // по ширине текста, лишнее место в ряду не забирает
    border-radius: 21px;
    background: root.danger ? (ta.has-hover ? #ff3b5c : #e5294a) : root.primary ? Theme.accent : (ta.has-hover ? #ffffff1a : #ffffff00);
    border-width: root.primary || root.danger ? 0px : 1px;
    border-color: ta.has-hover ? #ffffff3d : #ffffff26;
    animate background, border-color { duration: 160ms; }
    drop-shadow-blur: root.primary || root.danger ? (ta.has-hover ? 30px : 18px) : 0px;
    drop-shadow-color: root.danger ? #ff3b5c88 : Theme.c1.transparentize(0.4);
    opacity: root.enabled ? 1 : 0.5;
    animate drop-shadow-blur { duration: 180ms; }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 22px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                width: 16px;
                height: 16px;
                fill: white;
            }
        }
        Text {
            text: root.text;
            color: white;
            font-weight: 700;
            font-size: 14px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> password;
    callback accepted(string);
    forward-focus: inp; // focus() на поле — курсор в ввод (Ctrl+F)
    height: 48px;
    border-radius: 14px;
    background: #110e1c;
    border-width: 1px;
    border-color: inp.has-focus ? Theme.c1.transparentize(0.2) : (ta.has-hover ? #ffffff26 : #ffffff14);
    drop-shadow-blur: inp.has-focus ? 22px : 0px;
    drop-shadow-color: Theme.c1.transparentize(0.6);
    animate border-color, drop-shadow-blur { duration: 180ms; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            inp.focus();
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                fill: inp.has-focus ? Theme.soft1 : Theme.dim;
            }
        }
        // поле не растёт под текст: длинный ключ раздвигал окно настройки за край экрана
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            clip: true;
            Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.faint;
                visible: inp.text == "";
                vertical-alignment: center;
                overflow: elide;
            }

            inp := TextInput {
                // длинный текст едет за курсором, а не уходит за край поля, где его не видно
                property <length> shift;
                x: min(0px, max(parent.width - self.preferred-width - self.text-cursor-width, self.shift));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                cursor-position-changed(pos) => {
                    if pos.x + self.shift < 0px {
                        self.shift = -pos.x;
                    } else if pos.x + self.shift > parent.width - self.text-cursor-width {
                        self.shift = parent.width - pos.x - self.text-cursor-width;
                    }
                }
                text <=> root.text;
                color: Theme.text;
                font-size: 15px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.c1.transparentize(0.6);
                input-type: root.password ? InputType.password : InputType.text;
                accepted => {
                    root.accepted(self.text);
                }
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <color> accent: Theme.c1;
    callback clicked();
    height: 34px;
    horizontal-stretch: 0;
    border-radius: 17px;
    border-width: 1px;
    border-color: root.active ? root.accent : #ffffff14;
    background: root.active ? root.accent.transparentize(0.7) : (ta.has-hover ? #ffffff0d : #ffffff05);
    drop-shadow-blur: root.active ? 16px : 0px;
    drop-shadow-color: root.accent.transparentize(0.55);
    animate background, border-color, drop-shadow-blur { duration: 160ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.accent;
                drop-shadow-blur: 6px;
                drop-shadow-color: root.accent;
            }
        }

        Text {
            text: root.text;
            color: root.active ? white : Theme.dim;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Slider inherits Rectangle {
    in property <float> value;
    in property <length> thick: 4px;
    callback changed(float); // отпустили
    callback moving(float);  // тянут — для живого предпросмотра (громкость)
    property <float> dv;
    property <bool> drag: ta.pressed;
    // что показывать прямо сейчас, в том числе пока тянут — подписи берут значение отсюда
    out property <float> shown: max(0, min(1, root.drag ? root.dv : root.value));
    height: max(18px, root.thick * 3);
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: ta.has-hover || root.drag ? root.thick * 1.5 : root.thick;
        border-radius: self.height / 2;
        background: #ffffff1a;
        animate height { duration: 120ms; }
        Rectangle {
            x: 0px;
            width: parent.width * root.shown;
            border-radius: parent.border-radius;
            background: @linear-gradient(90deg, Theme.c1 0%, Theme.c2 100%);
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.c1.transparentize(0.33);
        }
    }

    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        x: parent.width * root.shown - 6px;
        y: (parent.height - 12px) / 2;
        background: white;
        opacity: ta.has-hover || root.drag ? 1 : 0;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.soft2;
        animate opacity { duration: 140ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.dv = max(0, min(1, self.mouse-x / self.width));
            } else if e.kind == PointerEventKind.up {
                root.changed(root.dv);
            }
        }
        moved => {
            root.dv = max(0, min(1, self.mouse-x / self.width));
            root.moving(root.dv);
        }
    }
}

// вертикальный ползунок для полос эквалайзера: 0 внизу, 1 вверху, середина — 0 дБ
component VSlider inherits Rectangle {
    in property <float> value;
    callback changed(float);
    property <float> dv;
    property <bool> drag: ta.pressed;
    out property <float> shown: max(0, min(1, root.drag ? root.dv : root.value));
    width: 26px;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: ta.has-hover || root.drag ? 6px : 4px;
        border-radius: self.width / 2;
        background: #ffffff1a;
        animate width { duration: 120ms; }
    }

    // заливка от середины (0 дБ) к текущему значению
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 4px;
        y: parent.height * (1 - max(root.shown, 0.5));
        height: parent.height * abs(root.shown - 0.5);
        border-radius: 2px;
        background: @linear-gradient(0deg, Theme.c1 0%, Theme.c2 100%);
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.c1.transparentize(0.33);
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.5 - 0.5px;
        width: 12px;
        height: 1px;
        background: #ffffff33;
    }

    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        x: (parent.width - self.width) / 2;
        y: parent.height * (1 - root.shown) - 7px;
        background: white;
        drop-shadow-blur: ta.has-hover || root.drag ? 12px : 6px;
        drop-shadow-color: Theme.soft2;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.dv = max(0, min(1, 1 - self.mouse-y / self.height));
            } else if e.kind == PointerEventKind.up {
                root.changed(root.dv);
            }
        }
        moved => {
            root.dv = max(0, min(1, 1 - self.mouse-y / self.height));
        }
    }
}

component Badge inherits Rectangle {
    in property <string> src;
    // в списках бейдж серый и не спорит с треками; цвет сервиса проявляется, когда строка под курсором
    in property <bool> lit: true;
    property <color> c: !root.lit ? #8e87a6 : root.src == "sp" ? #1ed760 : root.src == "yt" ? #ff3355 : root.src == "ya" ? #ffcc00 : #ff6a1a;
    animate c { duration: 160ms; }
    width: 30px;
    height: 18px;
    border-radius: 6px;
    background: root.c.transparentize(0.85);
    border-width: 1px;
    border-color: root.c.transparentize(0.6);
    Text {
        text: root.src == "sp" ? "SP" : root.src == "yt" ? "YT" : root.src == "ya" ? "YA" : "SC";
        color: root.c;
        font-size: 10px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Cover inherits Rectangle {
    in property <image> img;
    in property <bool> has;
    in property <string> src;
    border-radius: 8px;
    clip: true;
    background: root.src == "sp" ? @linear-gradient(135deg, #1ed76044 0%, #120d1d 100%) : root.src == "yt" ? @linear-gradient(135deg, #ff335544 0%, #120d1d 100%)
        : root.src == "ya" ? @linear-gradient(135deg, #ffcc0044 0%, #120d1d 100%) : @linear-gradient(135deg, #ff6a1a44 0%, #120d1d 100%);
    Icon {
        d: Icons.note;
        width: parent.width * 0.4;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        fill: #ffffff30;
        visible: !root.has;
    }

    Image {
        width: 100%;
        height: 100%;
        source: root.img;
        image-fit: cover;
        opacity: root.has ? 1 : 0;
        animate opacity { duration: 250ms; }
    }
}

component TrackRow inherits Rectangle {
    in property <TrackItem> item;
    callback play();
    callback add();
    callback like();
    callback artist();
    // ⋯: радио, ссылка, скачать, убрать — общее меню окна, встаёт у этой кнопки
    callback more(length, length);
    callback want-cover(string);
    // перетаскивание мышью: строка сообщает списку, где сейчас курсор, список рисует линию вставки
    in property <bool> can-drag;
    in property <bool> dragged;
    callback drag-at(length);
    callback drag-end();
    property <bool> drag-on;
    property <bool> drag-was;
    opacity: root.dragged ? 0.35 : 1;
    // номер в списке (плейлист, альбом); 0 — без номера (поиск, главная)
    in property <int> number;
    height: 58px;
    border-radius: 10px;
    background: root.item.playing ? Theme.c1.transparentize(0.88) : (ta.has-hover ? #ffffff14 : #ffffff00);
    animate background { duration: 180ms; }
    init => {
        if !root.item.has-cover && root.item.cover-url != "" {
            root.want-cover(root.item.cover-url);
        }
    }
    changed item => {
        if !root.item.has-cover && root.item.cover-url != "" {
            root.want-cover(root.item.cover-url);
        }
    }
    Rectangle {
        x: 0px;
        y: 14px;
        width: 3px;
        height: parent.height - 28px;
        border-radius: 2px;
        background: Theme.soft2;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.c2;
        visible: root.item.playing;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.drag-was = false;
            }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.drag-on {
                root.drag-on = false;
                root.drag-end();
            }
        }
        moved => {
            if root.can-drag && self.pressed && (root.drag-on || abs(self.mouse-y - self.pressed-y) > 8px) {
                root.drag-on = true;
                root.drag-was = true;
                root.drag-at(root.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if !root.drag-was {
                root.play();
            }
        }
    }

    HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 12px;
        // номер неяркий; под курсором вместо него — ▶: видно, что клик по строке включает трек
        if root.number > 0: Rectangle {
            width: 26px;
            Text {
                width: 100%;
                text: root.number;
                color: root.item.playing ? Theme.soft2 : Theme.text;
                opacity: ta.has-hover ? 0 : root.item.playing ? 1 : 0.4;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: right;
                vertical-alignment: center;
                animate opacity { duration: 120ms; }
            }

            Icon {
                d: Icons.play;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                fill: white;
                opacity: ta.has-hover ? 1 : 0;
                animate opacity { duration: 120ms; }
            }
        }

        Cover {
            width: 42px;
            img: root.item.cover;
            has: root.item.has-cover;
            src: root.item.source;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.title;
                color: root.item.playing ? Theme.soft2 : Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: start;
                // имя артиста — ссылка на его страницу
                artist-txt := Text {
                    text: root.item.snip ? @tr("{} · превью → YT", root.item.artist) : root.item.artist;
                    color: artist-ta.has-hover ? Theme.pale1 : Theme.dim;
                    font-size: 12px;
                    overflow: elide;
                    artist-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.artist();
                        }
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Badge {
                src: root.item.source;
                lit: ta.has-hover || root.item.playing;
            }
        }

        Text {
            width: 44px;
            text: root.item.duration;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        // ♥ — в любимые, не запуская трек
        VerticalLayout {
            alignment: center;
            IconBtn {
                size: 30px;
                icon: root.item.liked ? Icons.heart : Icons.heart-o;
                active: root.item.liked;
                tip: root.item.liked ? @tr("Убрать из любимых") : @tr("В любимые");
                clicked => {
                    root.like();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconBtn {
                size: 30px;
                icon: Icons.plus;
                tip: @tr("Добавить в плейлист");
                clicked => {
                    root.add();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconBtn {
                size: 30px;
                icon: Icons.more;
                tip: @tr("Ещё");
                clicked => {
                    root.more(self.absolute-position.x, self.absolute-position.y);
                }
            }
        }

    }
}

// строка в панели очереди: клик — включить; у "далее" ещё вверх/вниз/убрать
component QueueRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> editable;
    in property <bool> dim;
    callback play();
    callback move(int);
    callback remove();
    callback want-cover(string);
    // перетаскивание мышью: строка сообщает списку, где сейчас курсор, список рисует линию вставки
    in property <bool> can-drag;
    in property <bool> dragged;
    callback drag-at(length);
    callback drag-end();
    property <bool> drag-on;
    property <bool> drag-was;
    opacity: root.dragged ? 0.35 : 1;
    height: 52px;
    border-radius: 10px;
    background: ta.has-hover ? #ffffff0c : #ffffff00;
    init => {
        if !root.item.has-cover && root.item.cover-url != "" {
            root.want-cover(root.item.cover-url);
        }
    }
    changed item => {
        if !root.item.has-cover && root.item.cover-url != "" {
            root.want-cover(root.item.cover-url);
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.drag-was = false;
            }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.drag-on {
                root.drag-on = false;
                root.drag-end();
            }
        }
        moved => {
            if root.can-drag && self.pressed && (root.drag-on || abs(self.mouse-y - self.pressed-y) > 8px) {
                root.drag-on = true;
                root.drag-was = true;
                root.drag-at(root.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if !root.drag-was {
                root.play();
            }
        }
    }

    HorizontalLayout {
        padding: 6px;
        padding-left: 8px;
        spacing: 10px;
        Cover {
            width: 40px;
            img: root.item.cover;
            has: root.item.has-cover;
            src: root.item.source;
            opacity: root.dim ? 0.55 : 1;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            HorizontalLayout {
                spacing: 5px;
                if root.item.smart: VerticalLayout {
                    alignment: center;
                    Icon {
                        d: Icons.sparkle;
                        width: 15px;
                        height: 15px;
                        fill: Theme.c2;
                    }
                }

                Text {
                    text: root.item.title;
                    color: root.dim ? Theme.dim : Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            Text {
                text: root.item.artist;
                color: Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }

        if root.editable: HorizontalLayout {
            spacing: 2px;
            VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 26px;
                    icon: Icons.up;
                    tip: @tr("Выше в очереди");
                    clicked => {
                        root.move(-1);
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 26px;
                    icon: Icons.down;
                    tip: @tr("Ниже в очереди");
                    clicked => {
                        root.move(1);
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconBtn {
                    size: 26px;
                    icon: Icons.close;
                    tip: @tr("Убрать из очереди");
                    danger: true;
                    clicked => {
                        root.remove();
                    }
                }
            }
        }
    }
}

// карточка альбома/сингла/артиста в карусели
component CardItem inherits Rectangle {
    in property <Card> card;
    in property <bool> round;
    callback clicked();
    callback want-cover(string);
    width: 150px;
    height: 206px;
    init => {
        if !root.card.has-cover && root.card.cover-url != "" {
            root.want-cover(root.card.cover-url);
        }
    }
    changed card => {
        if !root.card.has-cover && root.card.cover-url != "" {
            root.want-cover(root.card.cover-url);
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        y: 0px;
        width: 150px;
        height: 150px;
        border-radius: root.round ? 75px : 12px;
        clip: true;
        background: @linear-gradient(135deg, Theme.deep1 0%, #120d1d 100%);
        drop-shadow-blur: ta.has-hover ? 22px : 0px;
        drop-shadow-color: Theme.c1.transparentize(0.6);
        Image {
            width: 100%;
            height: 100%;
            source: root.card.cover;
            image-fit: cover;
        }
    }

    Text {
        y: 158px;
        width: 150px;
        text: root.card.title;
        color: ta.has-hover ? #ffffff : Theme.text;
        font-size: 13px;
        font-weight: 700;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }

    Text {
        y: 178px;
        width: 150px;
        text: root.card.sub;
        color: Theme.faint;
        font-size: 11px;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }
}

// горизонтальная лента карточек
component Carousel inherits VerticalLayout {
    in property <string> title;
    in property <[Card]> cards;
    in property <bool> round;
    callback open(int);
    callback want-cover(string);
    spacing: 10px;
    visible: root.cards.length > 0;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 18px;
        font-weight: 800;
    }

    Flickable {
        height: 210px;
        content-width: row.preferred-width;
        row := HorizontalLayout {
            spacing: 16px;
            for c[i] in root.cards: CardItem {
                card: c;
                round: root.round;
                clicked => {
                    root.open(i);
                }
                want-cover(u) => {
                    root.want-cover(u);
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> trailing;
    in property <bool> active;
    callback clicked();
    height: 40px;
    border-radius: 11px;
    background: root.active ? @linear-gradient(90deg, Theme.c1.transparentize(0.82) 0%, Theme.c2.transparentize(0.96) 100%) : (ta.has-hover ? #ffffff0a : #ffffff00);
    Rectangle {
        x: 0px;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: Theme.soft1;
        opacity: root.active ? 1 : 0;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.soft1;
        animate opacity { duration: 200ms; }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                fill: root.active ? Theme.pale1 : Theme.dim;
            }
        }

        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.active ? Theme.text : #b5aecb;
            font-size: 14px;
            font-weight: root.active ? 700 : 500;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: root.trailing;
            vertical-alignment: center;
            color: Theme.faint;
            font-size: 12px;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Одна строка lyrics. d = индекс - текущая строка: <0 спета, 0 поётся, >0 впереди.
// style — как выглядят текущая и будущие: 0 плавно, 1 каскад, 2 фокус.
// exit — как уходят спетые: 0 тускнеют, 2 сдуваются, 3 улетают в дыру (логотип слева сверху),
//        4 буквы падают вниз и лежат, 5 испаряются вверх, 6 разлетаются взрывом,
//        7 строка рассыпается на буквы, и дыра засасывает каждую по отдельности.
component LyricLine inherits Rectangle {
    in property <LyrLine> line;
    in property <int> d;       // расстояние от строки, за которой держится прокрутка
    in property <float> p;     // заливка этой строки 0..1
    in property <float> glow: 1; // сила свечения поющегося слова, 0 — выкл (настройка)
    // растворение у краёв экрана текста (строки рисуются и за пределами своей колонки — до краёв экрана)
    in property <length> view-top; // где колонка внутри экрана текста
    in property <length> view-h;   // высота экрана текста
    in property <length> edge;     // строки у верха и низа экрана плавно растворяются на этом отрезке, 0 — выкл
    // прозрачность растворения в точке y экрана текста: 1 — дальше edge от краёв, 0 — на краю и за ним
    pure function edge-a(y: length) -> float {
        if (root.edge <= 0) {
            return 1;
        }
        return root.smooth(max(0, min(1, min(y / root.edge, (root.view-h - y) / root.edge))));
    }
    pure function smooth(v: float) -> float {
        return v * v * (3 - 2 * v);
    }
    // ореол как в Apple Music: полупрозрачные копии текста со сдвигом, три кольца — ближнее ярче
    property <[{ x: length, y: length, a: float }]> halo: [{ x: 1.5px, y: 0.0px, a: 0.100 }, { x: 0.8px, y: 1.0px, a: 0.100 }, { x: -0.7px, y: 1.0px, a: 0.100 }, { x: -1.5px, y: 0.0px, a: 0.100 },
                      { x: -0.8px, y: -1.0px, a: 0.100 }, { x: 0.8px, y: -1.0px, a: 0.100 }, { x: 3.3px, y: 0.8px, a: 0.065 }, { x: 1.6px, y: 2.5px, a: 0.065 },
                      { x: -1.0px, y: 2.7px, a: 0.065 }, { x: -3.1px, y: 1.3px, a: 0.065 }, { x: -3.3px, y: -0.8px, a: 0.065 }, { x: -1.6px, y: -2.5px, a: 0.065 },
                      { x: 1.0px, y: -2.7px, a: 0.065 }, { x: 3.1px, y: -1.3px, a: 0.065 }, { x: 5.7px, y: 1.4px, a: 0.040 }, { x: 3.6px, y: 3.8px, a: 0.040 },
                      { x: 0.1px, y: 4.8px, a: 0.040 }, { x: -3.5px, y: 3.9px, a: 0.040 }, { x: -5.7px, y: 1.5px, a: 0.040 }, { x: -5.7px, y: -1.4px, a: 0.040 },
                      { x: -3.6px, y: -3.8px, a: 0.040 }, { x: -0.1px, y: -4.8px, a: 0.040 }, { x: 3.5px, y: -3.9px, a: 0.040 }, { x: 5.7px, y: -1.5px, a: 0.040 }];
    // строка только что допета: пока волна оседает (rest, 350 мс), она ещё нарисована буквами.
    // Дольше не держим — две строки буквами со свечением разом стоят вдвое дороже
    property <float> live: root.active ? 1 : 0;
    animate live { duration: 450ms; }
    in property <duration> step: 66ms;
    // заливка встала (дошла до конца ряда, а строка ещё звучит, или пауза между словами):
    // через 0.35 с поднятые буквы за полсекунды опускаются, а не висят в воздухе
    in property <float> still;
    property <float> calm: max(0, min(1, (root.still - 0.2) / 0.3));
    animate calm { duration: root.step; easing: linear; }
    // сколько волны осталось: пока строка звучит — пока заливка не встала; кончилась — плавно гаснет
    // с той высоты, где была (раньше счётчик «стоит» сбрасывался, и осевшие буквы подпрыгивали снова)
    property <float> rest: root.active ? 1 - root.calm : 0;
    animate rest { duration: 350ms; easing: ease-out; }
    // заливка приходит уже посчитанной на этот кадр (см. lyr-pos в окне): анимации не нужно
    property <float> ps: root.p;
    in property <bool> active; // звучит сейчас (у Apple таких бывает несколько сразу)
    in property <bool> done;   // уже спета
    in property <bool> karaoke;
    in property <int> style;
    in property <int> exit;
    in property <length> anchor;
    in property <float> cur-top;
    in property <length> hole-x; // центр логотипа-дыры в координатах колонки
    in property <length> hole-y;
    in property <int> idx;
    in property <int> prep-idx: -1; // эту строку заранее держим буквами (невидимыми), см. lyr-prep
    in property <float> stay-ms;  // сколько упавшие буквы лежат внизу
    in property <length> floor-y; // "пол" — низ экрана, куда падают буквы
    in property <length> shift;   // сдвиг вниз, пока над строкой раскрыты точки проигрыша
    callback clicked();
    property <int> ad: abs(root.d);
    property <bool> gone: root.done;
    in property <bool> quiet; // перемотали через неё — уходит без эффекта (см. lyr-jump)
    // время (мс) с момента ухода строки: от него считаются все буквенные анимации —
    // у каждой буквы своя задержка и траектория
    property <float> exit-t: root.gone && !root.quiet ? 15000 : 0;
    // назад (перемотали назад, строка снова не спета) — сразу в 0, без анимации: иначе 15 с счётчик
    // ехал обратно, и когда строку пели заново, эффект уже не включался
    animate exit-t { duration: root.gone && !root.quiet ? 15000ms : 0ms; easing: linear; }
    property <float> exit-end: root.exit == 4 ? 2100 + root.stay-ms : 2200;
    // пока идёт эффект — строка нарисована отдельными буквами, потом снова целым текстом
    property <bool> letters: root.gone && !root.quiet && root.exit >= 4 && root.ad <= 8 && root.exit-t < root.exit-end;
    property <bool> sucked: root.gone && !root.quiet && root.exit == 3;
    // прозрачность неактивной строки
    property <float> alpha: root.active ? 1
        : root.line.dots ? 0 // точки проигрыша появляются, когда до них дошли, и гаснут с его концом
        : root.gone ? (root.exit == 0 ? max(0.12, 0.42 - 0.08 * root.ad) : 0)
        : root.style == 2 ? (root.d == 1 ? 0.3 : 0)
        : max(0.1, 0.5 - 0.09 * root.ad);
    // плавное затухание: анимируем число, а не цвет — цвет активной строки меняется каждый кадр (караоке)
    // бэк-вокал приглушён только после того, как спет: пока звучит, он ярко-белый, и затухание
    // должно стартовать с 1 — раньше оно начиналось с 0.75 и строка гасла скачком
    property <float> fade: root.alpha * (root.line.bg && !root.active ? 0.75 : 1);
    // точки проигрыша гаснут быстро: на их место тут же съезжает следующая строка, и за 700 мс
    // они успевали повисеть поверх неё
    animate fade { duration: root.line.dots ? 160ms : 700ms; easing: ease-out; }
    // "В дыру": одна сила затягивания 0..1 с разгоном, от неё считаются и путь, и размер, и прозрачность —
    // так движение цельное. Раньше x, y и шрифт анимировались каждый со своей кривой и дёргались.
    property <float> suck: root.sucked ? 1 : 0;
    animate suck { duration: root.sucked ? 1400ms : 0ms; easing: cubic-bezier(0.5, 0, 0.75, 0.25); }
    // Slint считает свойства лениво: fade/suck, которые никто не читает, при уходе прыгали бы сразу
    // в конечное значение. Фон всегда прозрачный, но держит их "живыми".
    background: root.fade + root.suck + root.exit-t + root.live + root.calm > 1000000000 ? #000 : #0000;
    // обычное положение строки: прокрутка списка + смещения стиля/сдува
    property <length> nx: root.gone && root.exit == 2 ? -260px : root.style == 1 && root.d > 0 && !root.active ? 34px * min(root.ad, 4) : 0px;
    property <length> ny: root.anchor + (root.line.top - root.cur-top) * 1px + root.shift
        + (root.gone && root.exit == 2 ? -24px : root.style == 2 && root.d > 1 && !root.active ? 60px : 0px);
    animate nx { duration: 800ms; easing: cubic-bezier(0.5, 0, 0.75, 0.2); }
    // мягкий разгон и торможение: с резким стартом прокрутка на 20 fps выглядела рывком
    animate ny { duration: 750ms; easing: cubic-bezier(0.35, 0, 0.15, 1); }
    // размер шрифта схлопывается к дыре; transform-scale на тексте не годится — ломает femtovg
    // сжимаем умеренно: на мелких размерах femtovg перерисовывает глифы ступеньками и кажется,
    // что шрифт резко меняется. Строка успевает растаять раньше, чем станет совсем мелкой
    property <length> fs: (root.line.bg ? 22px : 36px) * (1 - 0.55 * root.suck);
    // путь к дыре почти прямой, с лёгким изгибом; по дороге строка чуть поворачивается вокруг себя.
    // Направление и сила у каждой строки свои (псевдослучайно от номера), чтобы не летели одинаково
    property <float> rnd: Math.mod(root.idx * 7919 + 13, 101) / 101;
    property <float> dir: Math.mod(root.idx * 3 + 1, 2) == 0 ? 1 : -1;
    property <float> turns: (0.03 + 0.04 * root.rnd) * root.dir;
    property <angle> tilt: (6deg + 10deg * root.rnd) * root.dir * root.suck;
    property <float> vx: (root.nx - root.hole-x) / 1px;
    property <float> vy: (root.ny - root.hole-y) / 1px;
    property <float> r: Math.sqrt(root.vx * root.vx + root.vy * root.vy) * (1 - root.suck);
    property <angle> a: Math.atan2(root.vy, root.vx) + 360deg * root.turns * root.suck;
    // в обычном положении — целые пиксели: глифы femtovg всё равно встают на пиксель (атлас без сглаживания),
    // а с дробной позицией буквы поющейся строки при прокрутке прилипали к пикселям вразнобой и дрожали
    x: root.suck <= 0 ? Math.round(root.nx / 1px) * 1px : root.hole-x + root.r * Math.cos(root.a) * 1px;
    y: root.suck <= 0 ? Math.round(root.ny / 1px) * 1px : root.hole-y + root.r * Math.sin(root.a) * 1px - root.height / 2 * root.suck;
    height: root.line.rows.length * root.fs * 1.55 + root.line.tr.length * root.fs * 0.55 * 1.45;
    // строки далеко за краем экрана не рисуем вовсе: при прокрутке иначе каждый кадр двигались и
    // рисовались все строки песни (70+), хотя видно ~12 — секунда кадров по 60–120 мс на каждой смене строки
    visible: root.d >= -8 && root.d <= 12;

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    // проигрыш: три точки по очереди наполняются светом и чуть "дышат", как в Apple Music
    if root.line.dots: HorizontalLayout {
        x: 4px;
        y: (root.fs * 1.55 - 18px) / 2;
        spacing: 12px;
        for k in 3: Rectangle {
            property <float> b: root.active ? max(0, min(1, root.ps * 3 - k)) : root.gone ? 1 : 0;
            property <length> sz: 12px + 4px * self.b + (root.active ? 2px * Math.sin(root.ps * 2160deg) : 0px);
            width: 18px;
            height: 18px;
            Rectangle {
                width: parent.sz;
                height: parent.sz;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: #ffffff.transparentize(1 - (0.3 + 0.7 * parent.b) * root.fade);
            }
        }
    }

    for row[j] in root.line.rows: row-box := Rectangle {
        // заливка ряда: 0..1 по общей доле строки
        property <float> f: root.gone ? 1 : !root.active ? 0 : max(0, min(1, self.run));
        // то же без обрезки: когда поётся уже следующий ряд, волна этого убегает за его край со скоростью
        // пения, и последние буквы опускаются сразу, а не висят до конца всей строки
        property <float> run: (root.ps - row.a) / max(0.001, row.b - row.a);
        property <bool> filling: root.active && root.karaoke && !root.line.empty && self.f > 0 && self.f < 1;
        // мягкий край заливки шириной 12%; стопы градиента должны идти по возрастанию,
        // иначе на нулевой заливке в начале ряда вылезает белый кусок
        property <float> edge-a: max(0, self.f * 1.12 - 0.12);
        property <float> edge-b: max(self.edge-a + 0.001, self.f * 1.12);
        // строка второго исполнителя прижата вправо; при затягивании "в дыру" сдвиг уходит в ноль,
        // иначе к логотипу летел левый край строки, а сам текст оставался посреди экрана
        x: root.line.right ? (root.width - self.width) * (1 - root.suck) * (1 - root.suck) : 0px;
        y: j * root.fs * 1.55;
        width: txt.preferred-width;
        height: txt.preferred-height;

        // растворение у краёв колонки: ряд гаснет, подходя к верху или низу (как у Apple Music), а не обрезается
        // растворение у краёв экрана — внутри самого ряда: прозрачность в пяти точках по высоте, текст красится
        // вертикальным градиентом. Раньше коэффициент был один на весь ряд, и ряд, чуть задевший край, пропадал целиком
        property <length> ay: root.view-top + root.y + self.y;
        property <float> e0: root.edge-a(self.ay);
        property <float> e1: root.edge-a(self.ay + self.height * 0.25);
        property <float> e2: root.edge-a(self.ay + self.height * 0.5);
        property <float> e3: root.edge-a(self.ay + self.height * 0.75);
        property <float> e4: root.edge-a(self.ay + self.height);
        property <bool> edged: min(self.e0, self.e4) < 0.999;
        // свечение (ореол root.halo) ярче всего у края заливки (текущее слово), к началу строки гаснет
        property <float> g0: max(0, self.f - 0.16);
        property <float> g1: max(self.g0 + 0.001, self.f - 0.03);
        property <float> g2: self.g1 + 0.06;
        // свечение гаснет плавно, когда ряд/строка допеты
        property <float> glow-k: self.filling ? 1 : 0;
        // допетая строка гасит ореол быстрее: иначе 24 копии текста ехали вместе с прокруткой ещё 0.7 с
        animate glow-k { duration: root.active ? 700ms : 250ms; easing: ease-out; }
        // при резком уходе (буквами, в дыру, сдувом) ореол не досвечивает — оставался призрак целой строки
        if root.karaoke && root.glow > 0 && row-box.glow-k > 0.01 && !row-box.by-letters && !(root.gone && root.exit != 0): Rectangle {
            for o in root.halo: Text {
                x: o.x;
                y: o.y;
                text: row.text;
                font-size: root.fs;
                font-weight: 800;
                color: @linear-gradient(90deg, #ffffff00 0%, #ffffff00 row-box.g0, #ffffff.transparentize(1 - o.a * row-box.glow-k * root.glow) row-box.g1, #ffffff00 row-box.g2, #ffffff00 100%);
            }
        }

        if root.letters: Rectangle {
            for ch[k] in row.chars: Rectangle {
                // ячейка ровно на месте буквы в цельном тексте (тот же замер в 16 раз крупнее, что и у волны):
                // раньше буквы раскладывались подряд по округлённым ширинам, ошибка копилась, пробелы
                // схлопывались — и строка рассыпалась не со своих мест, а кашей
                x: (lu.preferred-width - lo.preferred-width) / 16;
                width: lo.preferred-width / 16;
                height: lt.preferred-height;
                lu := Text {
                    visible: false;
                    text: row.pre[k];
                    font-size: root.fs * 16;
                    font-weight: 800;
                }

                lo := Text {
                    visible: false;
                    text: ch;
                    font-size: root.fs * 16;
                    font-weight: 800;
                }

                property <float> r1: Math.mod(root.idx * 37 + j * 101 + k * 53, 97) / 97;
                property <float> r2: Math.mod(root.idx * 61 + j * 29 + k * 89, 89) / 89;
                property <float> rel: (k + 0.5) / max(1, row.chars.length) - 0.5;
                property <float> t: root.exit-t;
                // падение: свободное падение до низа экрана, по дороге разлетаются в стороны (дальше от
                // середины строки — дальше вбок), отскок, лежат stay-ms и тают
                property <float> f-delay: self.r1 * 380;
                property <float> f-dur: 850 + self.r2 * 350;
                property <float> fu: max(0, min(1, (self.t - self.f-delay) / self.f-dur));
                property <float> fb: max(0, min(1, (self.t - self.f-delay - self.f-dur) / 260));
                property <length> fall: root.floor-y - root.y - row-box.y - self.height - self.r1 * 14px;
                // разлёт вбок с мягким стартом: первые кадры буква ещё на своём месте — видно, откуда она ушла
                property <float> fs-out: (1 - (1 - self.fu) * (1 - self.fu)) * min(1, self.fu * 5);
                // в дыру буквами: строка рассыпается на месте, буквы чуть разлетаются и по одной, с
                // разной задержкой и своей дугой, затягиваются в логотип, крутясь и уменьшаясь
                property <float> h-delay: self.r1 * 420;
                property <float> hk: max(0, min(1, (self.t - self.h-delay) / (1150 + self.r2 * 350)));
                property <float> he: self.hk * self.hk;
                property <length> to-x: root.hole-x - root.x - row-box.x - self.x - self.width / 2;
                property <length> to-y: root.hole-y - root.y - row-box.y - self.y - self.height / 2;
                property <float> burst-t: min(1, max(0, (self.t - self.r1 * 120) / 420));
                property <float> burst: self.burst-t * self.burst-t * (3 - 2 * self.burst-t);
                // испарение: всплывают, покачиваясь
                property <float> ev: max(0, min(1, (self.t - self.r1 * 500) / 1700));
                property <float> ee: 1 - (1 - self.ev) * (1 - self.ev);
                // взрыв: разлёт от центра строки, потом их тянет вниз
                property <float> bv: max(0, min(1, (self.t - self.r1 * 80) / 900));
                property <float> be: (1 - (1 - self.bv) * (1 - self.bv) * (1 - self.bv)) * min(1, self.bv * 6);

                lt := Text {
                    text: ch;
                    font-size: root.fs;
                    font-weight: 800;
                    // уменьшение масштабом, а не размером шрифта: размер шрифта менял раскладку каждый кадр
                    transform-scale: root.exit == 7 ? 1 - 0.6 * parent.he : 1;
                    x: root.exit == 4 ? (parent.rel * 520px + (parent.r2 - 0.5) * 300px) * parent.fs-out
                        : root.exit == 7 ? (parent.r1 - 0.5) * 50px * parent.burst + parent.to-x * parent.he + Math.sin(parent.he * 180deg) * (parent.r1 - 0.5) * 220px
                        : root.exit == 5 ? (Math.sin((parent.ev * 2.2 + parent.r1 * 6.28) * 1rad) - Math.sin(parent.r1 * 6.28rad)) * 14px
                        : (parent.rel * 360px + (parent.r2 - 0.5) * 80px) * parent.be;
                    y: root.exit == 4 ? parent.fall * parent.fu * parent.fu - Math.sin(parent.fb * 180deg) * 18px * (1 - parent.r1 * 0.5)
                        : root.exit == 7 ? (parent.r2 - 0.5) * 36px * parent.burst + parent.to-y * parent.he + Math.sin(parent.he * 180deg) * (parent.r2 - 0.5) * 160px
                        : root.exit == 5 ? -(50px + parent.r2 * 90px) * parent.ee
                        : (parent.r1 - 0.6) * 220px * parent.be + 120px * parent.bv * parent.bv;
                    transform-rotation: root.exit == 4 ? (parent.r1 - 0.5) * 220deg * parent.fu
                        : root.exit == 7 ? (parent.r1 - 0.5) * 540deg * parent.he
                        : root.exit == 5 ? (parent.r2 - 0.5) * 40deg * parent.ee
                        : (parent.r1 - 0.5) * 400deg * parent.be;
                    // все начинают с той же яркости, что у только что спетой строки, и гаснут плавно —
                    // раньше в момент распада буквы скачком тускнели до половины
                    property <float> alpha: root.exit == 4 ? (1 - 0.2 * min(1, parent.fu * 3)) * (1 - max(0, min(1, (parent.t - parent.f-delay - parent.f-dur - root.stay-ms) / 700)))
                        : root.exit == 5 ? 1 - parent.ee
                        : root.exit == 7 ? 1 - max(0, (parent.he - 0.7) / 0.3)
                        : 1 - parent.bv * parent.bv;
                    color: #ffffff.transparentize(1 - self.alpha);
                }
            }
        }

        // поющаяся строка рисуется по буквам: у края заливки бежит волна — поющаяся буква и соседние чуть
        // приподнимаются, спетые опускаются следом. Только сдвиг: femtovg двигает текст на дробные пиксели
        // плавно, а смена размера шрифта перерастеризует глифы с округлением — буквы дрожат.
        // Каждая буква стоит ровно там же, где в цельном тексте (ширина ряда до неё минус она сама), поэтому
        // переключение между цельным текстом и буквами не видно. После конца строки волна гаснет за
        // секунду (live). В дыру строка тоже летит буквами — без наклона, зато буквы не падают рывком
        property <bool> by-letters: root.karaoke && !root.line.empty && !root.line.dots && !root.letters && (root.active || root.live > 0.01);
        // буквы следующей строки создаём и размечаем заранее, но не рисуем: раньше они создавались и
        // мерились в момент смены строки — кадр в 2–3 раза дороже ровно тогда, когда начинается прокрутка
        property <bool> prep: root.karaoke && !root.line.empty && !root.line.dots && !root.letters && root.idx == root.prep-idx;
        property <float> n: max(1, row.chars.length);
        // край волны в буквах: у звучащей строки может уйти за конец ряда, у спетой — весь ряд залит
        property <float> edge: (root.active ? max(row-box.f, row-box.run) : row-box.f) * self.n;
        if row-box.by-letters || row-box.prep: Rectangle {
            for ch[k] in row.chars: cb := Rectangle {
                // где буква стоит в цельном тексте (ширина ряда до неё минус она сама). femtovg рисует букву
                // на целом пикселе, а дробную часть позиции зашивает в картинку глифа. Отдельная буква с x = pen
                // рисовалась без этой дробной части и при возврате к цельному тексту сдвигалась на пиксель.
                // Поэтому: ячейка с целого пикселя, буква прижата вправо — её позиция внутри ячейки как раз
                // дробная часть, и глиф выходит пиксель в пиксель как в цельной строке
                // Slint округляет preferred-width вверх до пикселя — на одну букву это до пикселя ошибки, и при
                // переходе обратно на цельный текст строка прыгала. Меряем невидимый текст в 16 раз крупнее
                // (ширины глифов растут линейно) и делим: ошибка меньше 1/16 пикселя
                property <length> pen: (upto.preferred-width - one.preferred-width) / 16;
                property <length> adv: one.preferred-width / 16;
                property <length> pen-int: Math.floor(self.pen / 1px) * 1px;
                x: self.pen-int;
                // расстояние от края заливки в буквах: < 0 — уже спета
                property <float> dc: k + 0.5 - row-box.edge;
                property <float> bump: self.dc >= 0 ? max(0, 1 - self.dc / 1.7) : max(0, 1 + self.dc / 2.9);
                // волна как в Spicy Lyrics: буква у края заливки плавно раздувается (до +12%) и приподнимается,
                // спетые оседают следом. Skia рисует с дробными позициями и сглаживанием, поэтому без округлений
                property <float> swell: (1 - Math.cos(self.bump * 180deg)) / 2 * root.rest;
                property <length> lift: -3px * self.swell;
                property <float> grow: 1 + 0.12 * self.swell;
                // мягкий край заливки (полбуквы шириной) один на весь ряд и идёт через границы букв без остановок.
                // Раньше он жил внутри каждой буквы: пробегал её за 2/3 времени и треть стоял, пока не начнётся
                // следующая, — заливка пульсировала по буквам. fd — сколько букв от начала этой до переднего края;
                // b0 и b1 — яркость 0..1 на левом и правом краю буквы, ua и ub — где внутри неё белое и где край
                property <float> fd: row-box.edge * (row-box.n + 0.5) / row-box.n - k;
                property <float> b0: max(0, min(1, self.fd * 2));
                property <float> b1: max(0, min(1, (self.fd - 1) * 2));
                property <float> ua: max(0, min(1, self.fd - 0.5));
                property <float> ub: max(0, min(1, self.fd));
                property <float> p1: self.ua * 0.998 + 0.001;
                property <float> p2: max(self.p1 + 0.001, self.ub * 0.998 + 0.001);
                // яркость ореола в центре буквы: профиль g0 → g1 (пик) → g2 ряда
                property <float> c: (k + 0.5) / row-box.n;
                property <float> halo-a: self.c <= row-box.g0 || self.c >= row-box.g2 ? 0
                    : self.c < row-box.g1 ? (self.c - row-box.g0) / (row-box.g1 - row-box.g0)
                    : 1 - (self.c - row-box.g1) / (row-box.g2 - row-box.g1);
                width: self.adv + self.pen - self.pen-int;
                height: lc.preferred-height;
                upto := Text {
                    visible: false;
                    text: row.pre[k];
                    font-size: root.fs * 16;
                    font-weight: 800;
                }

                one := Text {
                    visible: false;
                    text: ch;
                    font-size: root.fs * 16;
                    font-weight: 800;
                }

                if root.karaoke && root.glow > 0 && row-box.glow-k > 0.01 && cb.halo-a > 0.01 && !(root.gone && root.exit != 0): Rectangle {
                    y: cb.lift;
                    width: cb.width;
                    height: cb.height;
                    transform-scale: cb.grow;
                    transform-origin: { x: self.width - cb.adv / 2, y: self.height * 0.78 };
                    for o in root.halo: Text {
                        x: o.x;
                        y: o.y;
                        width: cb.width;
                        horizontal-alignment: right;
                        text: ch;
                        font-size: root.fs;
                        font-weight: 800;
                        color: #ffffff.transparentize(1 - o.a * row-box.glow-k * root.glow * cb.halo-a);
                    }
                }

                // заготовка следующей строки: ячейки уже размечены (Slint считает размеры лениво — только
                // у того, что обходит при отрисовке), а сами буквы не рисуем
                lc := Text {
                    visible: row-box.by-letters;
                    width: cb.width;
                    horizontal-alignment: right;
                    text: ch;
                    font-size: root.fs;
                    font-weight: 800;
                    y: cb.lift;
                    // растёт от середины буквы на линии шрифта, а не от угла
                    transform-scale: cb.grow;
                    transform-origin: { x: self.width - cb.adv / 2, y: self.height * 0.78 };
                    color: root.sucked ? #ffffff.transparentize(root.suck * root.suck * root.suck)
                        : !root.active ? #ffffff.transparentize(1 - root.fade)
                        : cb.b0 <= 0 ? #ffffff8c
                        : cb.b1 >= 1 ? #ffffff
                        : @linear-gradient(90deg, #ffffff.transparentize((1 - cb.b0) * 0.45) 0%,
                            #ffffff.transparentize(cb.ua > 0 ? 0 : (1 - cb.b0) * 0.45) cb.p1,
                            #ffffff.transparentize(cb.ub < 1 ? 0.45 : (1 - cb.b1) * 0.45) cb.p2,
                            #ffffff.transparentize((1 - cb.b1) * 0.45) 100%);
                }
            }
        }

        txt := Text {
            visible: !root.letters && !row-box.by-letters;
            text: row.text;
            font-size: root.fs;
            font-weight: 800;
            transform-rotation: root.tilt;
            color: root.sucked ? (root.d < -2 ? #ffffff00 : #ffffff.transparentize(root.suck * root.suck * root.suck))
                : (!root.active || !root.karaoke || root.line.empty) && row-box.edged ? @linear-gradient(180deg,
                    #ffffff.transparentize(1 - root.fade * row-box.e0) 0%, #ffffff.transparentize(1 - root.fade * row-box.e1) 25%,
                    #ffffff.transparentize(1 - root.fade * row-box.e2) 50%, #ffffff.transparentize(1 - root.fade * row-box.e3) 75%,
                    #ffffff.transparentize(1 - root.fade * row-box.e4) 100%)
                : !root.active || !root.karaoke || root.line.empty ? #ffffff.transparentize(1 - root.fade)
                : row-box.f <= 0 ? #ffffff8c
                : row-box.f >= 1 ? #ffffff
                : @linear-gradient(90deg, #ffffff 0%, #ffffff row-box.edge-a, #ffffff8c row-box.edge-b, #ffffff8c 100%);
        }
    }

    // перевод: мелко под строкой, ряд за рядом. Без анимаций — только гаснет вместе со строкой; при уходе
    // с эффектом (буквы, дыра, сдув) просто исчезает
    for t[j] in root.line.tr: Text {
        property <length> tfs: root.fs * 0.55;
        x: root.line.right ? root.width - self.width : 0px;
        y: root.line.rows.length * root.fs * 1.55 + j * self.tfs * 1.45;
        width: self.preferred-width;
        text: t;
        font-size: self.tfs;
        font-weight: 600;
        property <length> ay: root.view-top + root.y + self.y;
        property <float> a: 0.6 * (root.gone && root.exit != 0 ? 0 : root.active ? 1 : root.fade);
        color: @linear-gradient(180deg, #ffffff.transparentize(1 - self.a * root.edge-a(self.ay)) 0%,
            #ffffff.transparentize(1 - self.a * root.edge-a(self.ay + self.height / 2)) 50%, #ffffff.transparentize(1 - self.a * root.edge-a(self.ay + self.height)) 100%);
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> desc;
    in property <bool> on;
    callback toggled();
    spacing: 14px;
    VerticalLayout {
        horizontal-stretch: 1;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
        }

        Text {
            text: root.desc;
            color: Theme.dim;
            font-size: 13px;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 48px;
            height: 28px;
            border-radius: 14px;
            // включено — сплошной акцент и белый бегунок справа; выключено — пустой контур и серый бегунок слева.
            // Раньше было градиентом к второму цвету: в «Моно» он почти белый, и белый бегунок на нём терялся
            background: root.on ? Theme.c1 : #ffffff0a;
            border-width: 1px;
            border-color: root.on ? Theme.c1 : #ffffff30;
            drop-shadow-blur: root.on ? 14px : 0px;
            drop-shadow-color: Theme.c1.transparentize(0.4);
            Rectangle {
                width: 22px;
                height: 22px;
                y: 2px;
                x: root.on ? 23px : 3px;
                border-radius: 11px;
                background: root.on ? white : #6f6888;
                drop-shadow-blur: root.on ? 4px : 0px;
                drop-shadow-color: #00000080;
                animate x { duration: 180ms; easing: ease-out; }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggled();
                }
            }
        }
    }
}

component Page inherits Rectangle {
    in property <bool> shown;
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: 220ms; easing: ease-out; }
}

export component AppWindow inherits Window {
    // в буфер обмена Slint пишет только из поля ввода: это поле никто не видит, через него копируем
    clip := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }
    // меню ⋯ одно на всё окно: что за трек и где кнопка. kind — как в track_at, 2 — панель плеера
    in-out property <bool> menu-open;
    property <int> menu-i;
    property <int> menu-kind;
    property <int> menu-dl;
    property <length> menu-ax;
    property <length> menu-ay;
    public function open-menu(i: int, kind: int, dl: int, x: length, y: length) {
        root.menu-i = i;
        root.menu-kind = kind;
        root.menu-dl = dl;
        root.menu-ax = x;
        root.menu-ay = y;
        root.menu-open = true;
    }
    public function copy-text(s: string) {
        clip.text = s;
        clip.select-all();
        clip.copy();
    }
    title: "Gargantua";
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 860px;
    min-height: 560px;
    background: #07060b;
    default-font-size: 14px;

    in-out property <string> page: "search";
    in property <[TrackItem]> results;
    in property <[TrackItem]> pl-tracks;
    in property <[PlItem]> playlists;
    in property <int> open-pl: -1;
    in property <string> pl-title;
    in property <string> pl-desc;
    in-out property <string> edit-name; // окно "Изменить плейлист"
    in-out property <string> edit-desc;
    callback edit-playlist();
    callback save-playlist(string, string);
    in property <image> pl-cover; // своя обложка плейлиста
    in property <bool> pl-has-cover;
    callback pick-pl-cover();
    // окно подтверждения (modal 5): скачать, убрать из плейлиста, радио
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-ok;
    in property <bool> confirm-danger;
    callback confirm-yes();
    // импорт: трек нашёлся на YT Music не наверняка (modal 6) — оставить или пропустить
    in property <string> ask-want;
    in property <string> ask-got;
    in property <int> ask-left;
    callback review(int); // 0 пропустить, 1 оставить, 2 оставить все, 3 пропустить все
    // первичная настройка и её сброс (временная кнопка в настройках)
    in-out property <bool> setup-open;
    callback setup-done();
    callback reset-settings();
    callback set-theme(int);
    callback preview-volume(float); // громкость, пока тянут ползунок
    in property <int> lyr-dots-open: -1; // какие точки проигрыша сейчас раскрыты (-1 никакие)
    in-out property <int> filter;
    in property <string> st-yt;
    in property <string> st-sc;
    in property <bool> searching;
    in-out property <string> query;

    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-source;
    in property <image> now-cover;
    in property <bool> now-has-cover;
    in property <bool> has-track;
    in property <bool> playing;
    in property <bool> loading;
    in property <float> position;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in-out property <float> volume: 0.7;
    in property <bool> shuffle;
    in property <int> repeat; // 0 — выкл, 1 — очередь, 2 — трек
    // свечение статичное: любая постоянная анимация = перерисовка всего окна каждый кадр
    property <float> pulse: 0.5;
    // радиус блюра теней не анимируем (сбивает кэш теней) — пульсируем только opacity

    in property <string> import-status;
    in property <bool> importing;
    in-out property <string> import-url;
    in property <bool> lite;
    in property <string> deps;
    in property <string> toast;
    in property <bool> toast-on;
    in-out property <int> modal; // 0 нет, 1 добавить в плейлист, 2 новый плейлист, 3 подтвердить удаление, 4 QR
    in-out property <string> new-name;
    // заставка непрозрачна целиком — плеер, текст и затемнение под ней не рисуем (аутро трейлера шло поверх живого текста)
    property <bool> covered: !root.intro-gone && intro-layer.opacity > 0.99;
    in property <float> intro-t; // мс с начала интро, тикает из Rust
    in-out property <bool> intro-gone; // нажали «Продолжить»
    in property <string> lang: "ru";
    in property <string> st-ya;
    // звук
    in-out property <bool> fx-open;
    // Connect: устройства аккаунта и где идёт звук
    in property <bool> conn-on;
    in property <[ConnDev]> conn-devs;
    in property <string> conn-remote; // звук на другом устройстве — его имя
    in-out property <bool> conn-open;
    callback conn-pick(string);
    in property <[float]> eq-gains;
    in property <[string]> eq-names;
    in property <[string]> eq-presets;
    in property <[string]> eq-presets2;
    in property <int> eq-preset;
    in property <float> speed: 1;
    in property <bool> keep-pitch: true;
    in property <bool> fx-default: true;
    callback set-eq-band(int, float);
    callback set-eq-preset(int);
    callback set-speed(float);
    callback set-keep-pitch(bool);
    callback fx-reset();
    // страница артиста
    in property <string> artist-name;
    in property <string> artist-stats;
    in property <string> artist-desc;
    in property <string> artist-error;
    in property <image> artist-photo;
    in property <image> artist-bg;
    in property <bool> has-artist-photo;
    in property <bool> artist-loading;
    in property <bool> has-all-songs;
    in property <[TrackItem]> art-top;
    in property <[Card]> art-albums;
    in property <[Card]> art-singles;
    in property <[Card]> art-similar;
    // альбом / все песни
    in property <string> coll-title;
    in property <string> coll-sub;
    in property <image> coll-cover;
    in property <bool> has-coll-cover;
    in property <bool> coll-loading;
    in property <[TrackItem]> coll-tracks;
    in property <bool> can-back;
    callback open-artist(int, int);
    callback nav-back();
    callback artist-play(bool);
    callback artist-radio();
    callback artist-all();
    callback open-card(int, int);
    in property <[Card]> s-artists;
    in property <[Card]> s-albums;
    callback search-typed(string);
    callback play-in(int, int);
    callback coll-play(bool);
    callback coll-save();
    in property <float> fall-stay: 3;
    in property <float> lyr-glow: 1;
    in property <bool> lyr-tr; // перевод текста включён
    in property <bool> cur-liked; // играющий трек в любимых
    callback toggle-like();
    in property <float> lyr-edge: 90; // растворение строк у краёв колонки, px; 0 — выкл
    callback set-lyr-edge(float);
    callback toggle-lyr-tr();
    in property <image> qr-img;
    in property <int> qr-part: 1;
    in property <int> qr-total: 1;
    callback set-fall-stay(float);
    callback set-lyr-glow(float);
    callback import-qr();
    callback share-playlist();
    callback qr-page(int);
    callback qr-save();
    callback radio(int, int);
    callback share(int, int);
    callback play-next(int, int); // трек из списка — первым в очередь
    in property <bool> hole-always: true;
    in property <string> version;
    callback set-lang(string);
    callback set-hole-always(bool);
    callback open-url(string);

    // lyrics
    in property <bool> lyrics-open;
    in property <bool> lyr-idle; // мышь не двигается — лишнее на экране текста спрятано
    in property <int> lyr-state; // 0 ищу, 1 синхронный, 2 простой текст, 3 нет текста
    in property <[LyrLine]> lyr-lines;
    in property <[string]> lyr-plain;
    in property <string> lyr-credit; // откуда текст — показываем всегда, пока виден текст
    in property <[Credit]> lyr-people;
    in property <string> spicy-key;
    in property <string> cookies;
    callback set-cookies(string);
    callback send-cookies();
    callback set-spicy-key(string);
    // аккаунт: 0 не вошёл, 1 ждём подтверждения почты, 2 вошёл
    in property <bool> acc-on; // Firebase задан при сборке — иначе аккаунтов нет совсем
    in property <int> acc-state;
    in property <string> acc-email;
    in property <string> acc-letter; // первая буква почты — на аватарке
    in-out property <string> acc-msg;
    in-out property <bool> acc-reg; // окно входа в режиме регистрации
    in-out property <string> acc-pw2; // повтор пароля при регистрации
    in property <bool> acc-busy;
    in property <bool> acc-syncing;
    callback acc-login(string, string);
    callback acc-register(string, string);
    callback acc-reset(string);
    callback acc-resend();
    callback acc-check();
    callback acc-logout();
    callback cloud-sync();
    in property <int> lyr-cur: -1;
    in property <float> lyr-cur-top;
    // до трёх одновременно звучащих строк: индекс и заливка
    in property <int> act0: -1;
    in property <int> act1: -1;
    in property <int> act2: -1;
    in property <float> p0;
    in property <float> p1;
    in property <float> p2;
    // часы караоке живут тут: позиция трека на каждом кадре = база + время кадров с момента t0. Rust только
    // поправляет базу, если часы разошлись с плеером, — от его таймера плавность не зависит. Раньше UI
    // анимацией доезжал до значений от таймера, и неровный таймер (на Linux дрожит сильнее) давал рывки
    in property <bool> lyr-clock; // выкл — заливка из p0..p2 (тесты)
    in property <float> lyr-base;
    in property <duration> lyr-t0;
    in property <float> lyr-rate; // скорость воспроизведения, 0 — стоит
    in property <LyrWin> w0;
    in property <LyrWin> w1;
    in property <LyrWin> w2;
    property <float> lyr-pos: root.lyr-rate > 0 ? root.lyr-base + (animation-tick() - root.lyr-t0) / 1s * root.lyr-rate : root.lyr-base;
    pure function seg(pos: float, s: float, e: float, a: float, b: float) -> float {
        a + (b - a) * max(0, min(1, (pos - s) / max(0.001, e - s)))
    }
    pure function wfill(pos: float, w: LyrWin) -> float {
        pos < w.s2 ? seg(pos, w.s1, w.e1, w.a1, w.b1) : pos < w.s3 ? seg(pos, w.s2, w.e2, w.a2, w.b2) : seg(pos, w.s3, w.e3, w.a3, w.b3)
    }
    public pure function frame-time() -> duration {
        animation-tick()
    }
    in property <[float]> still; // сек, сколько заливка каждой звучащей строки (act0..2) стоит на месте
    in property <int> act-max: -1;
    in property <int> lyr-prep: -1; // следующая строка, буквы которой заготовить заранее
    in property <int> lyr-jump: -1; // строки выше неё пропущены перемоткой — уходят без анимации
    in property <int> lyr-bg-done: -1; // бэк-вокал под звучащей строкой, который уже допет (последний такой)
    in property <bool> karaoke: true;
    in property <int> lyr-style;
    in property <int> lyr-exit;
    in property <image> big-cover;
    in property <bool> has-big;
    in property <image> bg-img;
    in property <image> blob-img;
    in property <float> bg-t; // сек, плавание фона
    in property <duration> lyr-step: 66ms; // шаг тика lyrics + запас: за него доезжают заливка и фон
    in property <[TrackItem]> q-hist;
    in property <[TrackItem]> q-next;
    // панель «Сейчас играет» справа: вкладки 0 текст, 1 очередь
    in-out property <bool> deck-open;
    in-out property <int> deck-tab;
    in property <[float]> viz; // столбики спектра 0..1
    property <bool> deck-push: root.width >= 1460px;
    callback deck-changed();
    changed deck-open => {
        root.deck-changed();
    }
    changed deck-tab => {
        root.deck-changed();
    }
    callback queue-jump(int);
    callback history-jump(int);
    callback queue-move(int, int);
    callback pl-move(int, int); // трек плейлиста перетащили: с какой строки на какую
    callback queue-remove(int);
    callback set-lyrics-open(bool);
    callback lyr-activity();
    callback set-karaoke(bool);
    callback set-lyr-style(int);
    callback set-lyr-exit(int);
    callback lyr-seek(int);
    callback lyr-width(float);
    callback toggle-fullscreen();

    callback search(string);
    callback set-filter(int);
    callback play-result(int);
    callback play-pl(int);
    callback ask-add(int, int);
    callback like-track(int, int); // ♥ у строки трека: номер в списке и какой это список (как у ask-add)
    callback like-all-pl();       // ♥ всем трекам открытого плейлиста
    callback download(int, int);
    callback download-all(int); // 1 открытый плейлист, 5 альбом
    callback pick-dl-dir();
    callback open-dl-dir();
    in property <string> dl-dir;
    in property <int> dl-count;
    callback add-to(int);
    callback create-playlist(string);
    callback open-playlist(int);
    callback delete-playlist();
    callback remove-track(int);
    callback play-all(bool);
    callback toggle-play();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    in property <bool> smart-shuffle; // перемешка с подмешиванием похожих треков
    callback toggle-repeat();
    callback do-import(string);
    callback set-lite(bool);
    callback want-cover(string);
    // звук и поведение
    in property <float> xfade; // сек, 0 — выкл
    in property <bool> autoplay: true;
    in property <bool> cover-theme;
    in property <bool> discord-on: true;
    in property <bool> discord-ready; // в сборке есть Application ID
    callback set-xfade(float);
    callback set-autoplay(bool);
    callback set-cover-theme(bool);
    callback set-discord(bool);
    // таймер сна: 0 выкл, 1–3 через 15/30/60 мин, 4 после этого трека; sleep-left — сколько минут осталось
    in property <int> sleep-mode;
    in property <string> sleep-left;
    callback set-sleep(int);
    // статистика
    in property <string> st-today;
    in property <string> st-week;
    in property <string> st-month;
    in property <string> st-total;
    in property <[HeatCell]> st-heat;
    in property <[MonthMark]> st-months;
    // итоги месяца и года: карточка поверх окна, её можно сохранить картинкой
    in-out property <bool> recap-open;
    in property <bool> recap-year;
    in property <string> recap-title;
    in property <string> recap-time;
    in property <string> recap-sub;
    in property <[RecapRow]> recap-tracks;
    in property <[RecapRow]> recap-artists;
    callback open-recap(bool);
    callback open-history();
    in property <string> st-lyr; // сколько треков нашлось по строчке из текста
    // заметки к моментам играющего трека
    in-out property <bool> notes-open;
    in property <[NoteItem]> notes;
    callback open-notes();
    callback note-add(string);
    callback note-remove(int);
    callback note-seek(int);
    callback save-recap(length, length, length, length);
    in property <[TrackItem]> st-tracks;
    in property <[StatArtist]> st-artists;
    // карточка любимого артиста: фото, фон и пятна из него (как в текстах), его самый частый трек
    in property <image> st-fav-photo;
    in property <image> st-fav-bg;
    in property <image> st-fav-blob;
    in property <bool> st-fav-has;
    in property <string> st-fav-track;
    in property <[StatArtist]> st-more; // со второго места
    callback open-stats();
    callback stat-artist(int);
    // главная: миксы, быстрый подбор, недавнее, плейлисты, похожие артисты
    in property <string> home-hello;
    in property <[Card]> home-mixes;
    in property <[TrackItem]> home-quick;
    in property <[Card]> home-recent;
    in property <[Card]> home-pls;
    in property <[Card]> home-similar;
    in property <string> home-similar-to;
    in property <bool> home-loading;
    in property <bool> home-empty: true;
    callback home-refresh();
    callback open-home();
    // поиск и сортировка внутри плейлиста
    in-out property <string> pl-query;
    in property <int> pl-sort;
    in property <int> pl-total;
    callback pl-filter(string, int);
    // офлайн-кэш
    in property <bool> offline: true;
    in property <float> cache-gb: 2;
    in property <string> cache-used;
    callback set-offline(bool);
    callback set-cache-gb(float);
    callback clear-cache();
    in property <string> app-version;
    in property <string> update-ver; // вышла версия новее — в настройках кнопка «Обновить»
    in property <bool> update-busy;
    callback do-update();
    callback copy-log();
    // локальная музыка
    in property <[TrackItem]> local-tracks;
    in property <[string]> music-dirs;
    in property <bool> local-scanning;
    callback add-music-dir();
    callback remove-music-dir(int);
    callback rescan-local();
    callback local-play(bool);

    // горячие клавиши: привязки в Rust (их меняют в настройках), здесь только Esc и то, что делает сам UI
    in property <[KeyBind]> key-binds;
    in property <int> rebinding: -1; // какое действие ждёт новую клавишу
    callback key-action(string, bool, bool, bool, bool) -> string;
    callback start-rebind(int);
    callback reset-keys();
    property <string> last-key;
    function on-key(e: KeyEvent) -> EventResult {
        if root.rebinding < 0 && e.text == Key.Escape {
            if root.menu-open { root.menu-open = false; return accept; }
            if root.lyrics-open { root.set-lyrics-open(false); keys.focus(); return accept; }
            if root.modal != 0 { root.modal = 0; return accept; }
            if root.recap-open { root.recap-open = false; return accept; }
            if root.notes-open { root.notes-open = false; return accept; }
            if root.fx-open || root.conn-open { root.fx-open = false; root.conn-open = false; return accept; }
            if root.deck-open { root.deck-open = false; return accept; }
            keys.focus(); // из поля ввода — обратно к горячим клавишам
            return accept;
        }
        root.last-key = root.key-action(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
        if root.last-key == "search" {
            if root.lyrics-open { root.set-lyrics-open(false); }
            root.page = "search";
            search-field.focus();
        }
        if root.last-key == "fullscreen" { root.toggle-fullscreen(); }
        // текст закрыли клавишей — фокус уходит со спрятанного экрана текста обратно
        if !root.lyrics-open && lyr-keys.has-focus { keys.focus(); }
        return root.last-key == "" ? reject : accept;
    }
    forward-focus: keys;

    // главный интерфейс: под полностью открытым экраном текста не рисуем — иначе он перерисовывается каждый кадр lyrics
    keys := FocusScope {
        key-pressed(e) => {
            return root.on-key(e);
        }
    main-ui := Rectangle {
        visible: (!root.lyrics-open || lyr-screen.y > 0px) && !root.covered;
        // фоновое свечение "аккреционного диска"
        Rectangle {
            x: -260px;
            y: -300px;
            width: 760px;
            height: 760px;
            background: @radial-gradient(circle, Theme.glow.transparentize(1 - 0.22 - 0.1 * root.pulse) 0%, Theme.glow.transparentize(1) 70%);
        }

        Rectangle {
            x: root.width - 480px;
            y: root.height - 560px;
            width: 760px;
            height: 760px;
            background: @radial-gradient(circle, Theme.c2.transparentize(0.82) 0%, Theme.c2.transparentize(1) 70%);
        }

        // размытая обложка играющего трека на весь фон, едва заметно: окно берёт цвет от музыки, а не стоит
        // одним тёмным пятном. Картинка уже размыта и крошечная (её же показывает экран текста) — тут только растяжение
        Image {
            width: 100%;
            height: 100%;
            source: root.bg-img;
            image-fit: fill;
            opacity: root.has-big ? 0.16 : 0;
            animate opacity { duration: 700ms; easing: ease-in-out; }
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                // ── сайдбар ──
                Rectangle {
                    cache-rendering-hint: true; // слой: пока внутри ничего не менялось, рисуется готовой картинкой (см. viz-box)
                    width: 240px;
                    background: #0b091359; // почти прозрачный: фон из обложки идёт под всем окном, чёрные боковины его рвали
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }

                    VerticalLayout {
                        padding: 16px;
                        padding-top: 20px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 12px;
                            padding-left: 4px;
                            padding-bottom: 18px;
                            Rectangle {
                                width: 46px;
                                height: 46px;
                                Rectangle {
                                    x: 12px;
                                    y: 12px;
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: #000;
                                    drop-shadow-blur: 18px;
                                    drop-shadow-color: Theme.soft1.transparentize(0.4);
                                }

                                // пульс — радиальный градиент, а не тень: тени с opacity дорогие
                                Rectangle {
                                    x: -17px;
                                    y: -17px;
                                    width: 80px;
                                    height: 80px;
                                    // без opacity и максимум 2 стопа: иначе femtovg каждый кадр рендерит слой/текстуру градиента
                                    background: @radial-gradient(circle, Theme.soft1.transparentize(1 - 0.6 * root.pulse) 0%, Theme.c1.transparentize(1) 70%);
                                }

                                Image {
                                    width: 46px;
                                    height: 46px;
                                    source: @image-url("../assets/logo-mark.svg");
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Gargantua";
                                    font-size: 21px;
                                    font-weight: 800;
                                    color: Theme.text;
                                }

                                Text {
                                    text: @tr("все сервисы · одна дыра");
                                    font-size: 11px;
                                    color: Theme.faint;
                                }
                            }
                        }

                        NavItem {
                            icon: Icons.home;
                            text: @tr("Главная");
                            active: root.page == "search";
                            clicked => {
                                root.open-home();
                            }
                        }

                        NavItem {
                            icon: Icons.import;
                            text: @tr("Импорт");
                            active: root.page == "import";
                            clicked => {
                                root.page = "import";
                            }
                        }

                        NavItem {
                            icon: Icons.library;
                            text: @tr("Моя музыка");
                            trailing: root.local-tracks.length > 0 ? "" + root.local-tracks.length : "";
                            active: root.page == "local";
                            clicked => {
                                root.page = "local";
                            }
                        }

                        NavItem {
                            icon: Icons.chart;
                            text: @tr("Статистика");
                            active: root.page == "stats";
                            clicked => {
                                root.open-stats();
                            }
                        }

                        NavItem {
                            icon: Icons.settings;
                            text: @tr("Настройки");
                            active: root.page == "settings";
                            clicked => {
                                root.page = "settings";
                            }
                        }

                        NavItem {
                            icon: Icons.info;
                            text: @tr("О программе");
                            active: root.page == "about";
                            clicked => {
                                root.page = "about";
                            }
                        }

                        HorizontalLayout {
                            padding-top: 18px;
                            padding-left: 14px;
                            padding-bottom: 4px;
                            Text {
                                text: @tr("ПЛЕЙЛИСТЫ");
                                color: Theme.faint;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1.5px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            IconBtn {
                                size: 28px;
                                icon: Icons.plus;
                                tip: @tr("Новый плейлист");
                                clicked => {
                                    root.new-name = "";
                                    root.modal = 2;
                                }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for p[i] in root.playlists: NavItem {
                                icon: p.liked ? Icons.heart : Icons.note;
                                text: p.name;
                                trailing: p.count;
                                active: root.page == "playlist" && root.open-pl == i;
                                clicked => {
                                    root.open-playlist(i);
                                }
                            }
                        }

                        // аккаунт — внизу панели, клик открывает его страницу
                        if root.acc-on && root.acc-state == 2: Rectangle {
                            height: 56px;
                            border-radius: 14px;
                            background: root.page == "account" ? Theme.c1.transparentize(0.82) : (acc-ta.has-hover ? #ffffff0d : #ffffff06);
                            border-width: 1px;
                            border-color: #ffffff12;
                            animate background { duration: 150ms; }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 17px;
                                        background: @linear-gradient(135deg, Theme.c1 0%, Theme.c2 100%);
                                        Text {
                                            text: root.acc-letter;
                                            color: white;
                                            font-size: 15px;
                                            font-weight: 800;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    Text {
                                        text: root.acc-email;
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.acc-syncing ? @tr("Синхронизирую…") : root.acc-msg != "" ? root.acc-msg : @tr("Аккаунт");
                                        color: Theme.faint;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }

                            acc-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.page = "account";
                                }
                            }
                        }
                    }
                }

                // ── контент ──
                Rectangle {
                    cache-rendering-hint: true; // слой: пока внутри ничего не менялось, рисуется готовой картинкой (см. viz-box)
                    horizontal-stretch: 1;

                    // поиск
                    Page {
                        shown: root.page == "search";
                        VerticalLayout {
                            padding: 26px;
                            padding-bottom: 8px;
                            spacing: 16px;
                            search-field := Field {
                                height: 52px;
                                icon: Icons.search;
                                placeholder: @tr("Трек, артист, что угодно — дыра всё засосёт");
                                text <=> root.query;
                                accepted(q) => {
                                    root.search(q);
                                }
                                changed text => {
                                    root.search-typed(self.text);
                                }
                            }

                            if root.query != "": HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Chip {
                                    text: @tr("Все");
                                    accent: Theme.soft1;
                                    active: root.filter == 0;
                                    clicked => {
                                        root.set-filter(0);
                                    }
                                }

                                Chip {
                                    text: root.st-yt == "" ? "YT Music" : "YT Music · " + root.st-yt;
                                    accent: #ff3355;
                                    active: root.filter == 1;
                                    clicked => {
                                        root.set-filter(1);
                                    }
                                }

                                Chip {
                                    text: root.st-sc == "" ? "SoundCloud" : "SoundCloud · " + root.st-sc;
                                    accent: #ff6a1a;
                                    active: root.filter == 2;
                                    clicked => {
                                        root.set-filter(2);
                                    }
                                }

                                Chip {
                                    text: root.st-ya == "" ? @tr("Яндекс") : @tr("Яндекс") + " · " + root.st-ya;
                                    accent: #ffcc00;
                                    active: root.filter == 3;
                                    clicked => {
                                        root.set-filter(3);
                                    }
                                }

                                // строчка из песни: ищется в текстах, которые уже открывались
                                Chip {
                                    text: root.st-lyr == "" ? @tr("В текстах") : @tr("В текстах") + " · " + root.st-lyr;
                                    accent: Theme.soft2;
                                    active: root.filter == 4;
                                    clicked => {
                                        root.set-filter(4);
                                    }
                                }
                            }

                            // строка поиска пустая — главная
                            if root.query == "": Rectangle {
                                vertical-stretch: 1;
                                home-fl := Flickable {
                                    width: parent.width;
                                    height: parent.height;
                                    content-width: self.width;
                                    content-height: home-lay.preferred-height;
                                    home-lay := VerticalLayout {
                                        width: home-fl.width;
                                        spacing: 26px;
                                        padding-bottom: 20px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.home-hello;
                                                color: Theme.text;
                                                font-size: 30px;
                                                font-weight: 800;
                                                vertical-alignment: center;
                                            }

                                            if !root.home-empty: VerticalLayout {
                                                alignment: center;
                                                IconBtn {
                                                    icon: Icons.refresh;
                                                    tip: root.home-loading ? @tr("Собираю миксы…") : @tr("Пересобрать миксы");
                                                    active: root.home-loading;
                                                    clicked => {
                                                        root.home-refresh();
                                                    }
                                                }
                                            }
                                        }

                                        if root.home-empty: Text {
                                            text: @tr("Послушай пару треков — и тут появятся миксы под тебя, недавнее и похожие артисты. А пока ищи что угодно сверху.");
                                            color: Theme.dim;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }

                                        if root.home-loading && root.home-mixes.length == 0: Text {
                                            text: @tr("Собираю миксы под тебя…");
                                            color: Theme.soft2;
                                            font-size: 14px;
                                        }

                                        Carousel {
                                            title: @tr("Твои миксы");
                                            cards: root.home-mixes;
                                            open(i) => {
                                                root.open-card(10, i);
                                            }
                                            want-cover(u) => {
                                                root.want-cover(u);
                                            }
                                        }

                                        if root.home-quick.length > 0: VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: @tr("Быстрый подбор");
                                                color: Theme.text;
                                                font-size: 18px;
                                                font-weight: 800;
                                            }

                                            for t[i] in root.home-quick: TrackRow {
                                                item: t;
                                                play => {
                                                    root.play-in(8, i);
                                                }
                                                add => {
                                                    root.ask-add(i, 8);
                                                }
                                                like => {
                                                    root.like-track(i, 8);
                                                }
                                                more(x, y) => {
                                                    root.open-menu(i, 8, self.item.dl, x, y);
                                                }
                                                artist => {
                                                    root.open-artist(i, 8);
                                                }
                                                want-cover(u) => {
                                                    root.want-cover(u);
                                                }
                                            }
                                        }

                                        Carousel {
                                            title: @tr("Недавно играло");
                                            cards: root.home-recent;
                                            open(i) => {
                                                root.open-card(11, i);
                                            }
                                            want-cover(u) => {
                                                root.want-cover(u);
                                            }
                                        }

                                        Carousel {
                                            title: @tr("Твои плейлисты");
                                            cards: root.home-pls;
                                            open(i) => {
                                                root.open-card(12, i);
                                            }
                                            want-cover(u) => {
                                                root.want-cover(u);
                                            }
                                        }

                                        Carousel {
                                            title: @tr("Похоже на {}", root.home-similar-to);
                                            cards: root.home-similar;
                                            round: true;
                                            open(i) => {
                                                root.open-card(13, i);
                                            }
                                            want-cover(u) => {
                                                root.want-cover(u);
                                            }
                                        }
                                    }
                                }
                            }

                            if root.query != "": Rectangle {
                                vertical-stretch: 1;
                                // артисты и альбомы (с YT Music) — сверху, треки под ними, всё скроллится вместе
                                s-fl := Flickable {
                                    width: parent.width;
                                    height: parent.height;
                                    content-width: self.width;
                                    content-height: s-lay.preferred-height;
                                    s-lay := VerticalLayout {
                                        width: s-fl.width;
                                        spacing: 4px;
                                        property <bool> cards: root.filter <= 1 && (root.s-artists.length > 0 || root.s-albums.length > 0);
                                        if self.cards: VerticalLayout {
                                            spacing: 18px;
                                            padding-bottom: 14px;
                                            Carousel {
                                                title: @tr("Артисты");
                                                cards: root.s-artists;
                                                round: true;
                                                open(i) => {
                                                    root.open-card(3, i);
                                                }
                                                want-cover(u) => {
                                                    root.want-cover(u);
                                                }
                                            }

                                            Carousel {
                                                title: @tr("Альбомы");
                                                cards: root.s-albums;
                                                open(i) => {
                                                    root.open-card(4, i);
                                                }
                                                want-cover(u) => {
                                                    root.want-cover(u);
                                                }
                                            }
                                        }

                                        if self.cards && root.results.length > 0: Text {
                                            text: @tr("Треки");
                                            color: Theme.text;
                                            font-size: 18px;
                                            font-weight: 800;
                                        }

                                        for t[i] in root.results: TrackRow {
                                            item: t;
                                            play => {
                                                root.play-result(i);
                                            }
                                            add => {
                                                root.ask-add(i, 0);
                                            }
                                            like => {
                                                root.like-track(i, 0);
                                            }
                                            more(x, y) => {
                                                root.open-menu(i, 0, self.item.dl, x, y);
                                            }
                                            artist => {
                                                root.open-artist(i, 0);
                                            }
                                            want-cover(u) => {
                                                root.want-cover(u);
                                            }
                                        }
                                    }
                                }

                                if root.results.length == 0 && root.s-artists.length == 0 && root.s-albums.length == 0: VerticalLayout {
                                    alignment: center;
                                    spacing: 14px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Image {
                                            width: 120px;
                                            height: 120px;
                                            source: @image-url("../assets/logo-mark.svg");
                                            opacity: root.searching ? 1 : 0.55;
                                        }
                                    }

                                    Text {
                                        text: root.searching ? @tr("Засасываю результаты…") : @tr("Чёрная дыра голодна. Вбей что-нибудь сверху.");
                                        color: Theme.dim;
                                        font-size: 15px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // плейлист
                    Page {
                        shown: root.page == "playlist";
                        VerticalLayout {
                            padding: 26px;
                            padding-bottom: 8px;
                            spacing: 18px;
                            HorizontalLayout {
                                spacing: 22px;
                                // обложка: своя или логотип; клик — выбрать картинку
                                Rectangle {
                                    width: 132px;
                                    height: 132px;
                                    border-radius: 22px;
                                    background: @linear-gradient(140deg, Theme.deep1 0%, #0c0914 60%, Theme.deep2 100%);
                                    border-width: 1px;
                                    border-color: pl-cover-ta.has-hover ? Theme.c1.transparentize(0.3) : #ffffff18;
                                    drop-shadow-blur: 30px;
                                    drop-shadow-color: Theme.c1.transparentize(0.6);
                                    clip: true;
                                    if !root.pl-has-cover: Image {
                                        width: 96px;
                                        height: 96px;
                                        x: 18px;
                                        y: 18px;
                                        source: @image-url("../assets/logo-mark.svg");
                                    }

                                    if root.pl-has-cover: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.pl-cover;
                                        image-fit: cover;
                                    }

                                    // при наведении — подсказка, что обложку можно сменить
                                    Rectangle {
                                        background: #00000088;
                                        visible: pl-cover-ta.has-hover;
                                        Text {
                                            text: @tr("Сменить обложку");
                                            color: white;
                                            font-size: 12px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    pl-cover-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.pick-pl-cover();
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: @tr("ПЛЕЙЛИСТ");
                                        color: Theme.faint;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 1.5px;
                                    }

                                    Text {
                                        text: root.pl-title;
                                        color: Theme.text;
                                        font-size: 32px;
                                        font-weight: 800;
                                        overflow: elide;
                                    }

                                    if root.pl-desc != "": Text {
                                        text: root.pl-desc;
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                        max-height: 3 * 13px * 1.4;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: @tr("{} треков", root.pl-total);
                                        color: Theme.dim;
                                        font-size: 13px;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        padding-top: 8px;
                                        Pill {
                                            text: @tr("Слушать");
                                            icon: Icons.play;
                                            enabled: root.pl-tracks.length > 0;
                                            clicked => {
                                                root.play-all(false);
                                            }
                                        }

                                        Pill {
                                            text: @tr("Вперемешку");
                                            icon: Icons.shuffle;
                                            primary: false;
                                            enabled: root.pl-tracks.length > 0;
                                            clicked => {
                                                root.play-all(true);
                                            }
                                        }

                                        Pill {
                                            text: root.dl-count > 0 ? @tr("Качаю… {}", root.dl-count) : @tr("Скачать всё");
                                            icon: Icons.download;
                                            primary: false;
                                            enabled: root.pl-tracks.length > 0;
                                            clicked => {
                                                root.download-all(1);
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            IconBtn {
                                                icon: Icons.edit;
                                                tip: @tr("Название и описание");
                                                clicked => {
                                                    root.edit-playlist();
                                                }
                                            }
                                        }

                                        if root.acc-state == 2: VerticalLayout {
                                            alignment: center;
                                            IconBtn {
                                                icon: Icons.refresh;
                                                tip: root.acc-syncing ? @tr("Синхронизирую…") : @tr("Синхронизировать плейлисты");
                                                clicked => {
                                                    root.cloud-sync();
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            IconBtn {
                                                icon: Icons.heart;
                                                tip: @tr("Лайкнуть все треки");
                                                clicked => {
                                                    root.like-all-pl();
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            IconBtn {
                                                icon: Icons.qrcode;
                                                tip: @tr("Поделиться QR-кодом");
                                                clicked => {
                                                    root.share-playlist();
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            IconBtn {
                                                icon: Icons.trash;
                                                tip: @tr("Удалить плейлист");
                                                danger: true;
                                                clicked => {
                                                    root.modal = 3; // сначала подтверждение
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // поиск по плейлисту и сортировка
                            if root.pl-total > 0: HorizontalLayout {
                                spacing: 8px;
                                Field {
                                    width: 260px;
                                    height: 38px;
                                    icon: Icons.search;
                                    placeholder: @tr("Найти в плейлисте");
                                    text <=> root.pl-query;
                                    changed text => {
                                        root.pl-filter(self.text, root.pl-sort);
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                for o[i] in [@tr("Как добавлены"), @tr("Сначала новые"), @tr("Название"), @tr("Артист"), @tr("Длительность")]: VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        text: o;
                                        accent: Theme.soft1;
                                        active: root.pl-sort == i;
                                        clicked => {
                                            root.pl-filter(root.pl-query, i);
                                        }
                                    }
                                }
                            }

                            // шапка колонок: неяркая строка над списком
                            if root.pl-tracks.length > 0: Rectangle {
                                height: 22px;
                                opacity: 0.5;
                                Text {
                                    x: 12px;
                                    width: 26px;
                                    text: "#";
                                    color: Theme.dim;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: right;
                                }

                                Text {
                                    // над названием трека: отступ строки 12 + номер 26 + обложка 42 и три промежутка по 12
                                    x: 104px;
                                    text: @tr("НАЗВАНИЕ");
                                    color: Theme.dim;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                }

                                Text {
                                    x: parent.width - 134px - 44px - 60px;
                                    width: 104px;
                                    text: @tr("ДЛИНА");
                                    color: Theme.dim;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                    horizontal-alignment: right;
                                }

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: #ffffff22;
                                }
                            }

                            pl-box := Rectangle {
                                vertical-stretch: 1;
                                // порядок треков меняется мышью — только в виде «как добавлены» и без поиска
                                property <int> drag-from: -1;
                                property <length> drag-y;
                                property <int> drag-to: max(0, min(root.pl-tracks.length, Math.round((self.drag-y - pl-list.viewport-y) / 58px)));
                                property <length> from-y: self.drag-from * 58px + pl-list.viewport-y;
                                pl-list := ListView {
                                    for t[i] in root.pl-tracks: TrackRow {
                                        number: i + 1;
                                        item: t;
                                        can-drag: root.pl-sort == 0 && root.pl-query == "";
                                        dragged: i == pl-box.drag-from;
                                        drag-at(y) => {
                                            pl-box.drag-from = i;
                                            pl-box.drag-y = y - pl-box.absolute-position.y;
                                        }
                                        drag-end => {
                                            if pl-box.drag-to != i && pl-box.drag-to != i + 1 {
                                                root.pl-move(i, pl-box.drag-to > i ? pl-box.drag-to - 1 : pl-box.drag-to);
                                            }
                                            pl-box.drag-from = -1;
                                        }
                                        play => {
                                            root.play-pl(i);
                                        }
                                        add => {
                                            root.ask-add(i, 1);
                                        }
                                        like => {
                                            root.like-track(i, 1);
                                        }
                                        more(x, y) => {
                                            root.open-menu(i, 1, self.item.dl, x, y);
                                        }
                                        artist => {
                                            root.open-artist(i, 1);
                                        }
                                        want-cover(u) => {
                                            root.want-cover(u);
                                        }
                                    }
                                }

                                Rectangle {
                                    x: 6px;
                                    y: pl-box.drag-to * 58px + pl-list.viewport-y - 1px;
                                    width: parent.width - 12px;
                                    height: 2px;
                                    border-radius: 1px;
                                    background: Theme.soft2;
                                    visible: pl-box.drag-from >= 0 && pl-box.from-y > -58px && pl-box.from-y < pl-box.height;
                                }

                                // курсор у края списка — список сам подъезжает, пока перетаскиваемая строка ещё на экране
                                Timer {
                                    interval: 30ms;
                                    running: pl-box.drag-from >= 0;
                                    triggered => {
                                        if pl-box.drag-y < 40px && pl-box.from-y < pl-box.height - 70px {
                                            pl-list.viewport-y = min(0px, pl-list.viewport-y + 14px);
                                        } else if pl-box.drag-y > pl-box.height - 40px && pl-box.from-y > 12px {
                                            pl-list.viewport-y = max(min(0px, pl-box.height - pl-list.viewport-height), pl-list.viewport-y - 14px);
                                        }
                                    }
                                }

                                if root.pl-tracks.length == 0: Text {
                                    text: root.pl-total > 0 ? @tr("Ничего не нашлось") : @tr("Пусто. Найди треки в поиске и жми «+».");
                                    color: Theme.dim;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // импорт
                    Page {
                        shown: root.page == "import";
                        VerticalLayout {
                            padding: 26px;
                            spacing: 14px;
                            alignment: start;
                            Text {
                                text: @tr("Импорт плейлиста");
                                color: Theme.text;
                                font-size: 28px;
                                font-weight: 800;
                            }

                            Text {
                                text: @tr("Кидай ссылку на плейлист или альбом из Spotify, Apple Music, YouTube Music или SoundCloud — дыра его засосёт целиком. Треки из Spotify и Apple Music сразу ищутся на YT Music, сомнительные совпадения спрошу. Ключи не нужны.");
                                color: Theme.dim;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Field {
                                    horizontal-stretch: 1;
                                    icon: Icons.import;
                                    placeholder: "https://open.spotify.com/playlist/…";
                                    text <=> root.import-url;
                                    accepted(u) => {
                                        root.do-import(u);
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: root.importing ? @tr("Засасываю…") : @tr("Засосать");
                                        enabled: !root.importing;
                                        clicked => {
                                            root.do-import(root.import-url);
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                Pill {
                                    text: @tr("Добавить по QR-коду");
                                    icon: Icons.qrcode;
                                    primary: false;
                                    enabled: !root.importing;
                                    clicked => {
                                        root.import-qr();
                                    }
                                }
                            }

                            Text {
                                text: root.import-status;
                                color: Theme.soft2;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            Text {
                                text: @tr("• Spotify: open.spotify.com/playlist/… или /album/…\n• Apple Music: music.apple.com/…/playlist/… или /album/…\n• YouTube Music: music.youtube.com/playlist?list=…\n• SoundCloud: soundcloud.com/юзер/sets/…\n• Яндекс Музыка: music.yandex.ru/users/…/playlists/… или /album/…\n• QR-код: картинка или фото QR, которым поделились из Gargantua (можно выбрать сразу все части)");
                                color: Theme.faint;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // моя музыка: файлы с диска
                    Page {
                        shown: root.page == "local";
                        VerticalLayout {
                            padding: 26px;
                            padding-bottom: 8px;
                            spacing: 14px;
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: @tr("Моя музыка");
                                        color: Theme.text;
                                        font-size: 28px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: root.local-scanning ? @tr("Ищу музыку в папках…") : @tr("{} треков с диска · папка загрузок подхватывается сама", root.local-tracks.length);
                                        color: Theme.dim;
                                        font-size: 13px;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        icon: Icons.refresh;
                                        tip: @tr("Пересканировать папки");
                                        clicked => {
                                            root.rescan-local();
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill {
                                    text: @tr("Слушать");
                                    icon: Icons.play;
                                    enabled: root.local-tracks.length > 0;
                                    clicked => {
                                        root.local-play(false);
                                    }
                                }

                                Pill {
                                    text: @tr("Вперемешку");
                                    icon: Icons.shuffle;
                                    primary: false;
                                    enabled: root.local-tracks.length > 0;
                                    clicked => {
                                        root.local-play(true);
                                    }
                                }

                                Pill {
                                    text: @tr("Добавить папку");
                                    icon: Icons.folder;
                                    primary: false;
                                    clicked => {
                                        root.add-music-dir();
                                    }
                                }
                            }

                            // свои папки — убираются крестиком; папка загрузок не показана, она всегда в деле
                            if root.music-dirs.length > 0: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for d[i] in root.music-dirs: Rectangle {
                                    height: 30px;
                                    border-radius: 15px;
                                    background: #ffffff0a;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        Text {
                                            text: d;
                                            color: Theme.dim;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            max-width: 260px;
                                            overflow: elide;
                                        }

                                        IconBtn {
                                            size: 24px;
                                            icon: Icons.close;
                                            danger: true;
                                            tip: @tr("Убрать папку");
                                            clicked => {
                                                root.remove-music-dir(i);
                                            }
                                        }
                                    }
                                }
                            }

                            if root.local-tracks.length == 0 && !root.local-scanning: Text {
                                text: @tr("Пока пусто. Добавь папку с mp3, flac, ogg или m4a — треки появятся здесь, их можно класть в плейлисты наравне со стримингом.");
                                color: Theme.faint;
                                font-size: 14px;
                                wrap: word-wrap;
                            }

                            ListView {
                                vertical-stretch: 1;
                                for t[i] in root.local-tracks: TrackRow {
                                    item: t;
                                    play => {
                                        root.play-in(6, i);
                                    }
                                    add => {
                                        root.ask-add(i, 6);
                                    }
                                    like => {
                                        root.like-track(i, 6);
                                    }
                                    more(x, y) => {
                                        root.open-menu(i, 6, self.item.dl, x, y);
                                    }
                                    artist => {
                                        root.open-artist(i, 6);
                                    }
                                    want-cover(u) => {
                                        root.want-cover(u);
                                    }
                                }
                            }
                        }
                    }

                    // статистика
                    Page {
                        shown: root.page == "stats";
                        st-fl := Flickable {
                        content-height: st-lay.preferred-height;
                        st-lay := VerticalLayout {
                            width: st-fl.width;
                            padding: 26px;
                            spacing: 16px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: @tr("Статистика");
                                    color: Theme.text;
                                    font-size: 28px;
                                    font-weight: 800;
                                    horizontal-stretch: 1;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: @tr("История");
                                        primary: false;
                                        clicked => {
                                            root.open-history();
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: @tr("Итоги месяца");
                                        primary: false;
                                        clicked => {
                                            root.open-recap(false);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: @tr("Итоги года");
                                        primary: false;
                                        clicked => {
                                            root.open-recap(true);
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                for c in [
                                    { k: @tr("Сегодня"), v: root.st-today },
                                    { k: @tr("За неделю"), v: root.st-week },
                                    { k: @tr("За месяц"), v: root.st-month },
                                    { k: @tr("За всё время"), v: root.st-total },
                                ]: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 86px;
                                    border-radius: 16px;
                                    background: #ffffff07;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: c.k;
                                            color: Theme.dim;
                                            font-size: 12px;
                                        }

                                        Text {
                                            text: c.v;
                                            color: Theme.text;
                                            font-size: 22px;
                                            font-weight: 800;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: @tr("Год музыки");
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            // год клетками: колонка — неделя (пн сверху), чем больше слушал в день — тем ярче клетка
                            heat := Rectangle {
                                property <length> left: 26px;
                                property <length> top: 18px;
                                property <length> step: max(6px, min(17px, (self.width - self.left) / 53));
                                property <length> cell: self.step - 3px;
                                // какая клетка под мышью — присваиваем из TouchArea, а не биндингом: подпись под сеткой
                                // зависела бы от ширины сетки, а та от подписи (петля в раскладке)
                                property <int> hi: -1;
                                height: self.top + 7 * self.step;
                                for m in root.st-months: Text {
                                    x: heat.left + m.col * heat.step;
                                    y: 0px;
                                    text: m.text;
                                    color: Theme.faint;
                                    font-size: 11px;
                                }
                                for w[k] in [@tr("пн"), @tr("ср"), @tr("пт")]: Text {
                                    x: 0px;
                                    y: heat.top + k * 2 * heat.step;
                                    height: heat.cell;
                                    text: w;
                                    color: Theme.faint;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                for c[i] in root.st-heat: Rectangle {
                                    x: heat.left + Math.floor(i / 7) * heat.step;
                                    y: heat.top + Math.mod(i, 7) * heat.step;
                                    width: heat.cell;
                                    height: heat.cell;
                                    border-radius: 3px;
                                    background: c.level <= 0 ? #ffffff0d : Theme.c1.transparentize(1 - (0.1 + 0.225 * c.level));
                                    border-width: heat-ta.has-hover && heat.hi == i ? 1px : 0px;
                                    border-color: Theme.pale1;
                                }
                                heat-ta := TouchArea {
                                    x: heat.left;
                                    y: heat.top;
                                    width: 53 * heat.step;
                                    height: 7 * heat.step;
                                    changed mouse-x => {
                                        self.pick();
                                    }
                                    changed mouse-y => {
                                        self.pick();
                                    }
                                    function pick() {
                                        heat.hi = Math.floor(self.mouse-x / heat.step) * 7 + Math.min(6, Math.floor(self.mouse-y / heat.step));
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: heat-ta.has-hover && heat.hi >= 0 && heat.hi < root.st-heat.length ? root.st-heat[heat.hi].tip : @tr("Наведи на клетку — покажу, сколько слушал в тот день");
                                    color: Theme.dim;
                                    font-size: 12px;
                                    overflow: elide;
                                }

                                Text {
                                    text: @tr("меньше");
                                    color: Theme.faint;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                for l in [0, 1, 2, 3, 4]: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 11px;
                                        height: 11px;
                                        border-radius: 3px;
                                        background: l == 0 ? #ffffff0d : Theme.c1.transparentize(1 - (0.1 + 0.225 * l));
                                    }
                                }

                                Text {
                                    text: @tr("больше");
                                    color: Theme.faint;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            if root.st-artists.length == 0: Text {
                                text: @tr("Пока пусто — включи что-нибудь, и тут появятся любимые исполнители и треки.");
                                color: Theme.faint;
                                font-size: 14px;
                                wrap: word-wrap;
                            }

                            if root.st-artists.length > 0: fav := Rectangle {
                                property <length> big: max(self.width, self.height);
                                // фон плывёт, только пока карточку видно
                                property <float> ft: root.page == "stats" && root.st-fav-has && !root.lyrics-open ? animation-tick() / 1s * 1.2 : 0;
                                height: 240px;
                                border-radius: 24px;
                                clip: true;
                                background: @linear-gradient(120deg, Theme.deep1 0%, #0c0914 60%, Theme.deep2 100%);
                                Image {
                                    width: fav.big * 1.7;
                                    height: self.width;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: root.st-fav-bg;
                                    image-fit: fill;
                                    visible: root.st-fav-has;
                                    transform-rotation: fav.ft * 3deg;
                                }

                                Image {
                                    width: fav.big * 0.7;
                                    height: self.width;
                                    x: parent.width * 0.3 - self.width / 2 + fav.big * 0.08 * Math.cos(fav.ft * 0.13 * 1rad);
                                    y: parent.height * 0.4 - self.height / 2 + fav.big * 0.06 * Math.sin(fav.ft * 0.17 * 1rad);
                                    source: root.st-fav-blob;
                                    image-fit: fill;
                                    visible: root.st-fav-has;
                                    transform-rotation: -fav.ft * 7deg;
                                }

                                Image {
                                    width: fav.big * 0.6;
                                    height: self.width;
                                    x: parent.width * 0.8 - self.width / 2 + fav.big * 0.07 * Math.sin(fav.ft * 0.11 * 1rad);
                                    y: parent.height * 0.6 - self.height / 2 + fav.big * 0.07 * Math.cos(fav.ft * 0.09 * 1rad);
                                    source: root.st-fav-blob;
                                    image-fit: fill;
                                    visible: root.st-fav-has;
                                    transform-rotation: fav.ft * 5deg + 140deg;
                                }

                                // слева темнее — под белый текст
                                Rectangle {
                                    background: @linear-gradient(90deg, #00000099 0%, #00000055 55%, #00000022 100%);
                                }

                                Rectangle {
                                    border-radius: 24px;
                                    border-width: 1px;
                                    border-color: fav-ta.has-hover ? #ffffff40 : #ffffff1a;
                                }

                                fav-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.stat-artist(0);
                                    }
                                }

                                HorizontalLayout {
                                    padding: 28px;
                                    spacing: 28px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 164px;
                                            height: 164px;
                                            border-radius: 82px;
                                            background: Theme.accent;
                                            drop-shadow-blur: 30px;
                                            drop-shadow-color: #00000080;
                                            Text {
                                                text: "#1";
                                                color: white;
                                                font-size: 36px;
                                                font-weight: 800;
                                                visible: !root.st-fav-has;
                                            }

                                            Rectangle {
                                                border-radius: 82px;
                                                clip: true;
                                                visible: root.st-fav-has;
                                                Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    source: root.st-fav-photo;
                                                    image-fit: cover;
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text {
                                            text: @tr("ЛЮБИМЫЙ ИСПОЛНИТЕЛЬ");
                                            color: #ffffffb0;
                                            font-size: 11px;
                                            font-weight: 800;
                                            letter-spacing: 2px;
                                        }

                                        Text {
                                            text: root.st-artists[0].name;
                                            color: white;
                                            font-size: 44px;
                                            font-weight: 900;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: @tr("{} вместе", root.st-artists[0].time);
                                            color: #ffffffe0;
                                            font-size: 16px;
                                            font-weight: 600;
                                        }

                                        if root.st-fav-track != "": Text {
                                            text: root.st-fav-track;
                                            color: #ffffffb0;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            if root.st-more.length > 0: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for a[i] in root.st-more: Rectangle {
                                    height: 32px;
                                    border-radius: 16px;
                                    background: art-chip-ta.has-hover ? #ffffff14 : #ffffff08;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    art-chip-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stat-artist(i + 1);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 6px;
                                        Text {
                                            text: (i + 2) + ". " + a.name;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: a.time;
                                            color: Theme.faint;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            if root.st-tracks.length > 0: Text {
                                text: @tr("Топ-5 треков");
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            for t[i] in root.st-tracks: TrackRow {
                                item: t;
                                play => {
                                    root.play-in(7, i);
                                }
                                add => {
                                    root.ask-add(i, 7);
                                }
                                like => {
                                    root.like-track(i, 7);
                                }
                                more(x, y) => {
                                    root.open-menu(i, 7, self.item.dl, x, y);
                                }
                                artist => {
                                    root.open-artist(i, 7);
                                }
                                want-cover(u) => {
                                    root.want-cover(u);
                                }
                            }
                        }
                        }
                    }

                    // о программе
                    Page {
                        shown: root.page == "about";
                        // плюсов много — страница прокручивается
                        about-fl := Flickable {
                        content-height: about-lay.preferred-height;
                        about-lay := VerticalLayout {
                            width: about-fl.width; // иначе длинные описания не переносятся, а уезжают вбок
                            padding: 26px;
                            spacing: 16px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 20px;
                                alignment: start;
                                Image {
                                    width: 96px;
                                    height: 96px;
                                    source: @image-url("../assets/logo-mark.svg");
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: "Gargantua";
                                        color: Theme.text;
                                        font-size: 32px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: @tr("версия {}", root.version);
                                        color: Theme.faint;
                                        font-size: 13px;
                                    }
                                }
                            }

                            Text {
                                text: @tr("Полностью бесплатный музыкальный плеер с открытым кодом и поддержкой нескольких стриминговых сервисов.\nРазработчик — qweowix");
                                color: Theme.dim;
                                font-size: 14px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: @tr("ГЛАВНЫЕ ПЛЮСЫ");
                                color: Theme.faint;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1.5px;
                            }

                            for f in [
                                { t: @tr("Без слежки"), d: @tr("История и настройки хранятся у тебя. Плейлисты и статистика — в твоём аккаунте, одинаковые на компьютере и телефоне. Никаких подписок, рекламы и телеметрии.") },
                                { t: @tr("Компьютер и телефон заодно"), d: @tr("Есть приложение для Android с теми же плейлистами и статистикой. Connect: звук играет на одном устройстве, управлять можно с любого, а сессия перекидывается одним нажатием.") },
                                { t: @tr("Все сервисы в одном месте"), d: @tr("Поиск сразу по YouTube Music, SoundCloud и Яндекс Музыке. Импорт плейлистов и альбомов из Spotify, Apple Music, YouTube Music, SoundCloud и Яндекса — одной ссылкой или QR-кодом.") },
                                { t: @tr("Твои файлы рядом со стримингом"), d: @tr("mp3, flac, ogg и m4a из твоих папок играют наравне со стримингом и живут в тех же плейлистах.") },
                                { t: @tr("Главная под тебя"), d: @tr("Каждый день свежие миксы по тому, что ты слушаешь: твой микс, миксы по любимым артистам и открытия — то, чего ты ещё не слышал.") },
                                { t: @tr("Тексты как в Apple Music"), d: @tr("Караоке по словам, свечение, волна по буквам и семь анимаций ухода строк. Тексты собираются из нескольких источников и подгоняются под твой трек.") },
                                { t: @tr("Панель «Сейчас играет»"), d: @tr("Справа от списка — обложка, спектр и текст или очередь. Заметки к моментам трека и поиск песни по строчке из неё.") },
                                { t: @tr("Быстрый и офлайн"), d: @tr("Следующие треки подгружаются заранее, а прослушанные сохраняются на диск — повторно играют мгновенно и без интернета.") },
                                { t: @tr("Всё, что нужно плееру"), d: @tr("Кроссфейд, эквалайзер, скорость и slowed, таймер сна, горячие клавиши, очередь мышью, перемешка и повтор. Умное перемешивание подмешивает похожее раз в 2–3 трека, «дальше похожее» продолжает, когда плейлист кончился.") },
                                { t: @tr("Статистика"), d: @tr("Сколько слушал за день, неделю и месяц, год клеточками, любимый исполнитель и топ треков. История прослушиваний, итоги месяца и года карточкой и умные подборки на главной.") },
                                { t: @tr("Дружит с системой"), d: @tr("Виден в панели и медиа-клавишах (MPRIS), показывает, что играет, в статусе Discord. Новые версии находит и ставит сам.") },
                                { t: @tr("Пятнадцать тем"), d: @tr("Или цвета прямо из обложки играющего трека.") },
                                { t: @tr("Лёгкий"), d: @tr("Нативное приложение без браузерного движка: в простое почти не нагружает процессор, а для слабых машин есть лайт-режим.") },
                            ]: HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: start;
                                    padding-top: 3px;
                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: Theme.accent;
                                        drop-shadow-blur: 8px;
                                        drop-shadow-color: Theme.c1.transparentize(0.33);
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: f.t;
                                        color: Theme.text;
                                        font-size: 14px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: f.d;
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            for row in [
                                { k: @tr("Разработчик"), v: "qweowix", url: "" },
                                { k: @tr("При поддержке"), v: "Claude Code", url: "" },
                                { k: @tr("Телеграм-канал"), v: "https://t.me/qweowixsrealm", url: "https://t.me/qweowixsrealm" },
                                { k: "GitHub", v: "https://www.github.com/qweowix/Gargantua", url: "https://www.github.com/qweowix/Gargantua" },
                                { k: @tr("Лицензия"), v: "MIT", url: "" },
                                { k: @tr("Интерфейс"), v: "Made with Slint · slint.dev", url: "https://slint.dev" },
                            ]: HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 170px;
                                    text: row.k;
                                    color: Theme.faint;
                                    font-size: 14px;
                                }

                                Text {
                                    text: row.v;
                                    color: row.url != "" ? (link-ta.has-hover ? Theme.soft2 : Theme.soft2) : Theme.text;
                                    font-size: 14px;
                                    font-weight: 700;
                                    link-ta := TouchArea {
                                        enabled: row.url != "";
                                        mouse-cursor: row.url != "" ? MouseCursor.pointer : MouseCursor.default;
                                        clicked => {
                                            root.open-url(row.url);
                                        }
                                    }
                                }
                            }
                        }
                        }
                    }

                    // артист
                    Page {
                        shown: root.page == "artist";
                        art-fl := Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-width: self.width;
                            content-height: art-lay.preferred-height;
                            art-lay := VerticalLayout {
                                width: art-fl.width;
                                spacing: 22px;
                                padding-bottom: 30px;
                                // шапка: размытое фото на фоне, круглое фото, имя, кнопки
                                Rectangle {
                                    height: 320px;
                                    clip: true;
                                    Image {
                                        width: parent.width;
                                        height: parent.width;
                                        y: (parent.height - self.height) / 2;
                                        source: root.artist-bg;
                                        image-fit: fill;
                                        visible: root.has-artist-photo;
                                    }

                                    Rectangle {
                                        background: @linear-gradient(180deg, #07060b55 0%, #07060bee 100%);
                                    }

                                    HorizontalLayout {
                                        padding: 28px;
                                        padding-top: 60px;
                                        spacing: 28px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 200px;
                                                height: 200px;
                                                border-radius: 100px;
                                                clip: true;
                                                background: @linear-gradient(135deg, Theme.deep1 0%, #120d1d 100%);
                                                drop-shadow-blur: 40px;
                                                drop-shadow-color: #00000099;
                                                Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    source: root.artist-photo;
                                                    image-fit: cover;
                                                    visible: root.has-artist-photo;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Text {
                                                text: @tr("АРТИСТ");
                                                color: #ffffffaa;
                                                font-size: 11px;
                                                font-weight: 700;
                                                letter-spacing: 1.5px;
                                            }

                                            Text {
                                                text: root.artist-loading ? @tr("Загружаю…") : root.artist-name;
                                                color: white;
                                                font-size: 46px;
                                                font-weight: 800;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: root.artist-error != "" ? root.artist-error : root.artist-stats;
                                                color: root.artist-error != "" ? #ff8a9a : #ffffffbb;
                                                font-size: 14px;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                alignment: start;
                                                spacing: 10px;
                                                padding-top: 6px;
                                                visible: !root.artist-loading && root.artist-error == "";
                                                Pill {
                                                    text: @tr("Слушать");
                                                    icon: Icons.play;
                                                    clicked => {
                                                        root.artist-play(false);
                                                    }
                                                }

                                                Pill {
                                                    text: @tr("Вперемешку");
                                                    icon: Icons.shuffle;
                                                    primary: false;
                                                    clicked => {
                                                        root.artist-play(true);
                                                    }
                                                }

                                                Pill {
                                                    text: @tr("Радио");
                                                    icon: Icons.radio;
                                                    primary: false;
                                                    clicked => {
                                                        root.artist-radio();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // описание: свёрнуто до 4 строк, по клику разворачивается
                                Rectangle {
                                    property <bool> open;
                                    property <length> shown: self.open ? desc.preferred-height : min(desc.preferred-height, 76px);
                                    visible: root.artist-desc != "" && !root.artist-loading;
                                    height: self.shown + 26px;
                                    animate height { duration: 250ms; easing: ease-out; }
                                    // сам текст обрезается своим окном, а кнопка стоит под ним, не поверх
                                    Rectangle {
                                        x: 28px;
                                        y: 0px;
                                        width: parent.width - 56px;
                                        height: parent.shown;
                                        clip: true;
                                        animate height { duration: 250ms; easing: ease-out; }
                                        desc := Text {
                                            y: 0px;
                                            width: parent.width;
                                            height: self.preferred-height; // иначе Text центрируется в окне и видна середина
                                            vertical-alignment: top;
                                            text: root.artist-desc;
                                            color: Theme.dim;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Text {
                                        x: 28px;
                                        y: parent.shown + 6px;
                                        text: parent.open ? @tr("Свернуть") : @tr("Читать полностью");
                                        color: Theme.pale1;
                                        font-size: 12px;
                                        font-weight: 700;
                                        visible: desc.preferred-height > 76px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            parent.open = !parent.open;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    padding-left: 22px;
                                    padding-right: 22px;
                                    spacing: 4px;
                                    visible: root.art-top.length > 0;
                                    Text {
                                        text: @tr("Популярное");
                                        color: Theme.text;
                                        font-size: 18px;
                                        font-weight: 800;
                                    }

                                    for t[i] in root.art-top: TrackRow {
                                        number: i + 1;
                                        item: t;
                                        play => {
                                            root.play-in(4, i);
                                        }
                                        add => {
                                            root.ask-add(i, 4);
                                        }
                                        like => {
                                            root.like-track(i, 4);
                                        }
                                        more(x, y) => {
                                            root.open-menu(i, 4, self.item.dl, x, y);
                                        }
                                        artist => {
                                            root.open-artist(i, 4);
                                        }
                                        want-cover(u) => {
                                            root.want-cover(u);
                                        }
                                    }

                                    if root.has-all-songs: HorizontalLayout {
                                        alignment: start;
                                        padding-top: 6px;
                                        Pill {
                                            text: @tr("Все песни");
                                            primary: false;
                                            clicked => {
                                                root.artist-all();
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    padding-left: 28px;
                                    spacing: 22px;
                                    Carousel {
                                        title: @tr("Альбомы");
                                        cards: root.art-albums;
                                        open(i) => {
                                            root.open-card(0, i);
                                        }
                                        want-cover(u) => {
                                            root.want-cover(u);
                                        }
                                    }

                                    Carousel {
                                        title: @tr("Синглы и EP");
                                        cards: root.art-singles;
                                        open(i) => {
                                            root.open-card(1, i);
                                        }
                                        want-cover(u) => {
                                            root.want-cover(u);
                                        }
                                    }

                                    Carousel {
                                        title: @tr("Похожие артисты");
                                        cards: root.art-similar;
                                        round: true;
                                        open(i) => {
                                            root.open-card(2, i);
                                        }
                                        want-cover(u) => {
                                            root.want-cover(u);
                                        }
                                    }
                                }
                            }
                        }

                        if root.can-back: IconBtn {
                            x: 16px;
                            y: 14px;
                            icon: Icons.prev;
                            tip: @tr("Назад");
                            clicked => {
                                root.nav-back();
                            }
                        }
                    }

                    // альбом / все песни артиста
                    Page {
                        shown: root.page == "collection";
                        VerticalLayout {
                            padding: 26px;
                            padding-top: 56px;
                            padding-bottom: 8px;
                            spacing: 18px;
                            HorizontalLayout {
                                spacing: 22px;
                                Rectangle {
                                    width: 132px;
                                    height: 132px;
                                    border-radius: 16px;
                                    clip: true;
                                    background: @linear-gradient(140deg, Theme.deep1 0%, #0c0914 60%, Theme.deep2 100%);
                                    drop-shadow-blur: 30px;
                                    drop-shadow-color: Theme.c1.transparentize(0.6);
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.coll-cover;
                                        image-fit: cover;
                                        visible: root.has-coll-cover;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: root.coll-loading ? @tr("Загружаю…") : root.coll-title;
                                        color: Theme.text;
                                        font-size: 30px;
                                        font-weight: 800;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.coll-sub;
                                        color: Theme.dim;
                                        font-size: 13px;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        padding-top: 8px;
                                        visible: !root.coll-loading;
                                        Pill {
                                            text: @tr("Слушать");
                                            icon: Icons.play;
                                            enabled: root.coll-tracks.length > 0;
                                            clicked => {
                                                root.coll-play(false);
                                            }
                                        }

                                        Pill {
                                            text: @tr("Вперемешку");
                                            icon: Icons.shuffle;
                                            primary: false;
                                            enabled: root.coll-tracks.length > 0;
                                            clicked => {
                                                root.coll-play(true);
                                            }
                                        }

                                        Pill {
                                            text: root.dl-count > 0 ? @tr("Качаю… {}", root.dl-count) : @tr("Скачать всё");
                                            icon: Icons.download;
                                            primary: false;
                                            enabled: root.coll-tracks.length > 0;
                                            clicked => {
                                                root.download-all(5);
                                            }
                                        }

                                        Pill {
                                            text: @tr("В плейлисты");
                                            icon: Icons.plus;
                                            primary: false;
                                            enabled: root.coll-tracks.length > 0;
                                            clicked => {
                                                root.coll-save();
                                            }
                                        }
                                    }
                                }
                            }

                            ListView {
                                vertical-stretch: 1;
                                for t[i] in root.coll-tracks: TrackRow {
                                    number: i + 1;
                                    item: t;
                                    play => {
                                        root.play-in(5, i);
                                    }
                                    add => {
                                        root.ask-add(i, 5);
                                    }
                                    like => {
                                        root.like-track(i, 5);
                                    }
                                    more(x, y) => {
                                        root.open-menu(i, 5, self.item.dl, x, y);
                                    }
                                    artist => {
                                        root.open-artist(i, 5);
                                    }
                                    want-cover(u) => {
                                        root.want-cover(u);
                                    }
                                }
                            }
                        }

                        if root.can-back: IconBtn {
                            x: 16px;
                            y: 14px;
                            icon: Icons.prev;
                            tip: @tr("Назад");
                            clicked => {
                                root.nav-back();
                            }
                        }
                    }

                    // аккаунт
                    Page {
                        shown: root.page == "account";
                        VerticalLayout {
                            padding: 26px;
                            spacing: 14px;
                            alignment: start;
                            Text {
                                text: @tr("Аккаунт");
                                color: Theme.text;
                                font-size: 28px;
                                font-weight: 800;
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    border-radius: 32px;
                                    background: @linear-gradient(135deg, Theme.c1 0%, Theme.c2 100%);
                                    drop-shadow-blur: 24px;
                                    drop-shadow-color: Theme.c1.transparentize(0.5);
                                    Text {
                                        text: root.acc-letter;
                                        color: white;
                                        font-size: 28px;
                                        font-weight: 800;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: root.acc-email;
                                        color: Theme.text;
                                        font-size: 18px;
                                        font-weight: 700;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.acc-syncing ? @tr("Синхронизирую…") : root.acc-msg;
                                        color: Theme.dim;
                                        font-size: 13px;
                                    }
                                }
                            }

                            Text {
                                text: @tr("Плейлисты хранятся в аккаунте и одинаковые на всех твоих компьютерах. Правки уходят на сервер сразу, свежие подтягиваются раз в минуту. История, статистика и настройки остаются на этом компьютере.");
                                color: Theme.dim;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Pill {
                                    text: root.acc-syncing ? @tr("Синхронизирую…") : @tr("Синхронизировать");
                                    icon: Icons.refresh;
                                    enabled: !root.acc-syncing;
                                    clicked => {
                                        root.cloud-sync();
                                    }
                                }

                                Pill {
                                    text: @tr("Сменить пароль");
                                    primary: false;
                                    clicked => {
                                        root.acc-reset(root.acc-email);
                                    }
                                }

                                Pill {
                                    text: @tr("Выйти");
                                    danger: true;
                                    clicked => {
                                        root.acc-logout();
                                    }
                                }
                            }
                        }
                    }

                    // настройки
                    Page {
                        shown: root.page == "settings";
                        // настроек много — страница прокручивается
                        set-fl := Flickable {
                        content-height: set-lay.preferred-height;
                        set-lay := VerticalLayout {
                            width: set-fl.width;
                            padding: 26px;
                            spacing: 14px;
                            alignment: start;
                            Text {
                                text: @tr("Настройки");
                                color: Theme.text;
                                font-size: 28px;
                                font-weight: 800;
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: @tr("Язык");
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }
                                }

                                Chip {
                                    text: "Русский";
                                    accent: Theme.soft1;
                                    active: root.lang == "ru";
                                    clicked => {
                                        root.set-lang("ru");
                                    }
                                }

                                Chip {
                                    text: "English";
                                    accent: Theme.soft1;
                                    active: root.lang == "en";
                                    clicked => {
                                        root.set-lang("en");
                                    }
                                }

                                Chip {
                                    text: "Українська";
                                    accent: Theme.soft1;
                                    active: root.lang == "uk";
                                    clicked => {
                                        root.set-lang("uk");
                                    }
                                }
                                Chip {
                                    text: "Slovenčina";
                                    accent: Theme.soft1;
                                    active: root.lang == "sk";
                                    clicked => {
                                        root.set-lang("sk");
                                    }
                                }
                            }

                            Text {
                                text: @tr("Тема");
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for t[i] in [
                                    { name: @tr("Горизонт"), c: #a855f7 },
                                    { name: @tr("Океан"), c: #3b82f6 },
                                    { name: @tr("Токсик"), c: #22c55e },
                                    { name: @tr("Сакура"), c: #ec4899 },
                                    { name: @tr("Закат"), c: #f59e0b },
                                    { name: @tr("Моно"), c: #a1a1aa },
                                    { name: @tr("Неон"), c: #57ddf7 },
                                    { name: @tr("Лава"), c: #f76c57 },
                                ]: Chip {
                                    text: t.name;
                                    accent: t.c;
                                    active: Theme.id == i + 0;
                                    clicked => {
                                        root.set-theme(i + 0);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for t[i] in [
                                    { name: @tr("Лаванда"), c: #7f57f7 },
                                    { name: @tr("Аврора"), c: #57f7a7 },
                                    { name: @tr("Полночь"), c: #5771f7 },
                                    { name: @tr("Золото"), c: #f7cf57 },
                                    { name: @tr("Мята"), c: #57f7cf },
                                    { name: @tr("Кровь"), c: #f75771 },
                                    { name: @tr("Персик"), c: #f78c57 },
                                ]: Chip {
                                    text: t.name;
                                    accent: t.c;
                                    active: Theme.id == i + 8;
                                    clicked => {
                                        root.set-theme(i + 8);
                                    }
                                }
                            }

                            SettingRow {
                                title: @tr("Цвета из обложки");
                                desc: @tr("Акцентные цвета интерфейса подстраиваются под обложку играющего трека. Выбор темы выше выключает это.");
                                on: root.cover-theme;
                                toggled => {
                                    root.set-cover-theme(!root.cover-theme);
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            Text {
                                text: @tr("Звук");
                                color: Theme.faint;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1.5px;
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text {
                                        property <int> v: Math.round(xf-sl.shown * 12);
                                        text: self.v == 0 ? @tr("Кроссфейд: выкл") : @tr("Кроссфейд: {} с", self.v);
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: @tr("Конец трека плавно перетекает в начало следующего. Если следующий ещё не подгружен — обычный переход.");
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    xf-sl := Slider {
                                        width: 200px;
                                        value: root.xfade / 12;
                                        changed(v) => {
                                            root.set-xfade(Math.round(v * 12));
                                        }
                                    }
                                }
                            }

                            SettingRow {
                                title: @tr("Дальше похожее");
                                desc: @tr("Когда плейлист или очередь заканчиваются, музыка не замолкает — включаются похожие треки.");
                                on: root.autoplay;
                                toggled => {
                                    root.set-autoplay(!root.autoplay);
                                }
                            }

                            SettingRow {
                                title: @tr("Офлайн-кэш");
                                desc: @tr("Прослушанные треки тихо сохраняются на диск: повторно играют мгновенно и без интернета. Старые вытесняются, когда кэш упрётся в предел.");
                                on: root.offline;
                                toggled => {
                                    root.set-offline(!root.offline);
                                }
                            }

                            if root.offline: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: @tr("Предел:");
                                    color: Theme.dim;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }

                                for g in [1, 2, 5, 10]: VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        text: @tr("{} ГБ", g);
                                        accent: Theme.soft1;
                                        active: Math.abs(root.cache-gb - g) < 0.01;
                                        clicked => {
                                            root.set-cache-gb(g);
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 8px;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: @tr("Очистить · {}", root.cache-used);
                                        primary: false;
                                        clicked => {
                                            root.clear-cache();
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: @tr("Таймер сна");
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: @tr("Музыка плавно затихнет и встанет на паузу. Тот же таймер — на луне в плеере.");
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }

                                for m[i] in [@tr("Выкл"), @tr("15 мин"), @tr("30 мин"), @tr("1 час"), @tr("После трека")]: VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        text: m;
                                        accent: Theme.soft1;
                                        active: root.sleep-mode == i;
                                        clicked => {
                                            root.set-sleep(i);
                                        }
                                    }
                                }
                            }

                            SettingRow {
                                title: @tr("Статус в Discord");
                                desc: root.discord-ready
                                    ? @tr("Друзья видят, что ты слушаешь: трек, исполнитель, обложка и сколько осталось. На паузе статус пропадает.")
                                    : @tr("В этой сборке нет Application ID для Discord — статус пока не работает.");
                                on: root.discord-on && root.discord-ready;
                                toggled => {
                                    root.set-discord(!root.discord-on);
                                }
                            }

                            if root.update-ver != "": HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: @tr("Вышла версия {}", root.update-ver);
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: @tr("Плеер скачает её, заменит себя и перезапустится. Музыка на минуту прервётся.");
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: root.update-busy ? @tr("Качаю…") : @tr("Обновить");
                                        clicked => {
                                            root.do-update();
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: @tr("Журнал ошибок");
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: @tr("Если трек не грузится или что-то сломалось — скопируй журнал и пришли его.");
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: @tr("Скопировать");
                                        primary: false;
                                        clicked => {
                                            root.copy-log();
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: @tr("Горячие клавиши");
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: @tr("Нажми на клавишу справа и потом новое сочетание. Занятая клавиша поменяется местами. Esc всегда закрывает окна и выходит из поля ввода.");
                                    color: Theme.dim;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                for k[i] in root.key-binds: HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: k.name;
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        property <bool> wait: root.rebinding == i;
                                        width: max(64px, kb-txt.preferred-width + 20px);
                                        height: 28px;
                                        border-radius: 7px;
                                        background: self.wait ? Theme.c1.transparentize(0.75) : kb-ta.has-hover ? #ffffff1a : #ffffff0f;
                                        border-width: 1px;
                                        border-color: self.wait ? Theme.c1 : #ffffff1c;
                                        kb-txt := Text {
                                            text: parent.wait ? @tr("жми клавишу… (Esc — отмена)") : k.key;
                                            color: parent.wait ? Theme.pale1 : Theme.text;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }

                                        kb-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.start-rebind(i);
                                                keys.focus(); // из поля ввода нажатие бы не дошло
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    padding-top: 4px;
                                    Pill {
                                        text: @tr("Вернуть клавиши по умолчанию");
                                        primary: false;
                                        clicked => {
                                            root.reset-keys();
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            SettingRow {
                                title: @tr("Лайт-режим");
                                desc: @tr("Вырубает постоянные анимации (вращение, пульсацию). Ноль лишней нагрузки.");
                                on: root.lite;
                                toggled => {
                                    root.set-lite(!root.lite);
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Упавшие буквы лежат: {} с", 1 + Math.round(stay-sl.shown * 9));
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: @tr("Для ухода строк «падение»: сколько буквы лежат внизу экрана, прежде чем растаять.");
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    stay-sl := Slider {
                                        width: 200px;
                                        value: (root.fall-stay - 1) / 9;
                                        changed(v) => {
                                            root.set-fall-stay(1 + Math.round(v * 9));
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text {
                                        property <float> v: Math.round(glow-sl.shown * 20) / 10;
                                        text: self.v <= 0 ? @tr("Свечение текста: выкл") : @tr("Свечение текста: {}%", Math.round(self.v * 100));
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: @tr("Ореол вокруг слова, которое сейчас поётся. Ползунок до упора влево — выключить.");
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    glow-sl := Slider {
                                        width: 200px;
                                        value: root.lyr-glow / 2;
                                        changed(v) => {
                                            root.set-lyr-glow(Math.round(v * 20) / 10);
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text {
                                        property <int> v: Math.round(edge-sl.shown * 16) * 10;
                                        text: self.v <= 0 ? @tr("Растворение у краёв: выкл") : @tr("Растворение у краёв: {} px", self.v);
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: @tr("Строки текста плавно гаснут у верха и низа, а не обрезаются. Ползунок до упора влево — выключить.");
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    edge-sl := Slider {
                                        width: 200px;
                                        value: root.lyr-edge / 160;
                                        changed(v) => {
                                            root.set-lyr-edge(Math.round(v * 16) * 10);
                                        }
                                    }
                                }
                            }

                            SettingRow {
                                title: @tr("Дыра в lyrics всегда");
                                desc: @tr("Логотип-дыра в углу экрана lyrics виден всегда. Если выключить — появляется только с уходом строк «в дыру».");
                                on: root.hole-always;
                                toggled => {
                                    root.set-hole-always(!root.hole-always);
                                }
                            }

                            ck := HorizontalLayout {
                                spacing: 14px;
                                property <[string]> browsers: ["", "firefox", "chrome", "chromium", "brave", "edge", "opera", "vivaldi", "safari"];
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Куки YouTube");
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: @tr("Если YouTube просит доказать, что ты не бот, и треки не играют — выбери браузер, где ты залогинен в YouTube. yt-dlp возьмёт оттуда куки; они никуда, кроме YouTube, не уходят.");
                                        color: Theme.dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        text: root.cookies == "" ? @tr("Выкл") : root.cookies;
                                        accent: #ff3355;
                                        active: root.cookies != "";
                                        clicked => {
                                            // по кругу: выкл → firefox → chrome → … → safari → выкл
                                            root.set-cookies(ck.next-browser());
                                        }
                                    }
                                }

                                // вход YouTube на телефон через аккаунт
                                if root.cookies != "": VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: @tr("На телефон");
                                        primary: false;
                                        clicked => {
                                            root.send-cookies();
                                        }
                                    }
                                }

                                function next-browser() -> string {
                                    if self.browsers[0] == root.cookies { return self.browsers[1]; }
                                    if self.browsers[1] == root.cookies { return self.browsers[2]; }
                                    if self.browsers[2] == root.cookies { return self.browsers[3]; }
                                    if self.browsers[3] == root.cookies { return self.browsers[4]; }
                                    if self.browsers[4] == root.cookies { return self.browsers[5]; }
                                    if self.browsers[5] == root.cookies { return self.browsers[6]; }
                                    if self.browsers[6] == root.cookies { return self.browsers[7]; }
                                    if self.browsers[7] == root.cookies { return self.browsers[8]; }
                                    return "";
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text {
                                        text: @tr("Папка загрузок");
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: root.dl-dir;
                                        color: Theme.dim;
                                        font-size: 13px;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: @tr("Открыть");
                                        icon: Icons.folder;
                                        primary: false;
                                        clicked => {
                                            root.open-dl-dir();
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: @tr("Сменить");
                                        clicked => {
                                            root.pick-dl-dir();
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 14px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        Text {
                                            text: @tr("Ключ Spicy Lyrics");
                                            color: Theme.text;
                                            font-size: 15px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: @tr("Ещё один источник текстов: синки по слогам от сообщества и Apple Music. Нужен свой бесплатный ключ (secret key, sl_sk_…) — хранится только у тебя на компьютере. Пусто — источник выключен.");
                                            color: Theme.dim;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Pill {
                                            text: @tr("Получить ключ");
                                            clicked => {
                                                root.open-url("https://developers.spicylyrics.org/dashboard/applications");
                                            }
                                        }
                                    }
                                }

                                Field {
                                    text: root.spicy-key;
                                    placeholder: "sl_sk_…";
                                    password: true;
                                    changed text => {
                                        root.set-spicy-key(self.text);
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            Text {
                                text: root.deps;
                                color: Theme.faint;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            // временно: для проверки первичной настройки
                            HorizontalLayout {
                                alignment: start;
                                Pill {
                                    text: @tr("Стереть настройки");
                                    danger: true;
                                    clicked => {
                                        root.reset-settings();
                                    }
                                }
                            }
                        }
                        }
                    }
                }

                // место под панель «Сейчас играет»: в широком окне она раздвигает контент, в узком — лежит поверх
                Rectangle {
                    width: root.deck-open && root.deck-push ? 340px : 0px;
                    animate width { duration: 280ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
                }
            }

            // ── плеер ──
            Rectangle {
                cache-rendering-hint: true; // слой: пока внутри ничего не менялось, рисуется готовой картинкой (см. viz-box)
                height: 96px;
                // полупрозрачная: сквозь неё видно цвет фона из обложки (размытия позади в Slint нет)
                background: #12101cc4;
                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: #ffffff1a;
                }

                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: @linear-gradient(90deg, Theme.c1.transparentize(1) 0%, Theme.c1.transparentize(0.33) 30%, Theme.c2.transparentize(0.33) 70%, Theme.c2.transparentize(1) 100%);
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Theme.c1;
                    opacity: root.playing ? 0.9 : 0.35;
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 20px;

                    // что играет
                    HorizontalLayout {
                        width: 300px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 60px;
                                height: 60px;
                                Rectangle {
                                    x: -30px;
                                    y: -30px;
                                    width: 120px;
                                    height: 120px;
                                    property <float> k: root.playing ? 0.3 + 0.7 * root.pulse : 0;
                                    background: @radial-gradient(circle, Theme.soft1.transparentize(1 - 0.6 * self.k) 0%, Theme.c1.transparentize(1) 70%);
                                }

                                Cover {
                                    border-radius: 12px;
                                    img: root.now-cover;
                                    has: root.now-has-cover;
                                    src: root.now-source;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.has-track ? root.now-title : @tr("Тишина");
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            Text {
                                text: root.loading ? @tr("засасываю поток…") : root.has-track ? (root.conn-remote != "" ? @tr("{} · играет на «{}»", root.now-artist, root.conn-remote) : root.now-artist) : @tr("включи что-нибудь");
                                color: root.loading ? Theme.soft2 : now-artist-ta.has-hover && root.has-track ? Theme.pale1 : root.conn-remote != "" ? Theme.soft2 : Theme.dim;
                                font-size: 12px;
                                overflow: elide;
                                now-artist-ta := TouchArea {
                                    enabled: root.has-track;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.open-artist(0, 2);
                                    }
                                }
                            }
                        }

                        if root.has-track: VerticalLayout {
                            alignment: center;
                            IconBtn {
                                size: 30px;
                                icon: root.cur-liked ? Icons.heart : Icons.heart-o;
                                active: root.cur-liked;
                                tip: root.cur-liked ? @tr("Убрать из любимых") : @tr("В любимые");
                                clicked => {
                                    root.toggle-like();
                                }
                            }
                        }

                        if root.has-track: VerticalLayout {
                            alignment: center;
                            IconBtn {
                                size: 30px;
                                icon: Icons.plus;
                                tip: @tr("Добавить в плейлист");
                                clicked => {
                                    root.ask-add(0, 2);
                                }
                            }
                        }

                    }

                    // управление
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 14px;
                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 32px;
                                    icon: root.smart-shuffle ? Icons.shuffle-smart : Icons.shuffle;
                                    tip: root.smart-shuffle ? @tr("Умное перемешивание: раз в 2–3 трека — похожий") : root.shuffle ? @tr("Перемешано. Ещё раз — умное перемешивание") : @tr("Перемешать");
                                    active: root.shuffle;
                                    glow: root.smart-shuffle ? 1 : 0;
                                    clicked => {
                                        root.toggle-shuffle();
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    icon: Icons.prev;
                                    tip: @tr("Предыдущий трек");
                                    clicked => {
                                        root.prev();
                                    }
                                }
                            }

                            IconBtn {
                                size: 46px;
                                primary: true;
                                glow: root.playing ? root.pulse : 0;
                                icon: root.playing ? Icons.pause : Icons.play;
                                tip: root.playing ? @tr("Пауза") : @tr("Играть");
                                clicked => {
                                    root.toggle-play();
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    icon: Icons.next;
                                    tip: @tr("Следующий трек");
                                    clicked => {
                                        root.next();
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 32px;
                                    icon: root.repeat == 2 ? Icons.repeat-one : Icons.repeat;
                                    tip: root.repeat == 2 ? @tr("Повтор трека") : @tr("Повтор");
                                    active: root.repeat > 0;
                                    clicked => {
                                        root.toggle-repeat();
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                width: 44px;
                                text: root.pos-text;
                                color: Theme.dim;
                                font-size: 11px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                Slider {
                                    value: root.position;
                                    changed(v) => {
                                        root.seek(v);
                                    }
                                }

                                // заметки к моментам — точками над полосой. Навёл — подсказка со временем и текстом,
                                // клик — перемотка ровно на заметку
                                for n[i] in root.notes: Rectangle {
                                    x: n.frac * parent.width - 7px;
                                    y: parent.height / 2 - 16px;
                                    width: 14px;
                                    height: 14px;
                                    Rectangle {
                                        property <length> d: note-dot.has-hover ? 8px : 4px;
                                        x: (parent.width - self.d) / 2;
                                        y: parent.height - self.d - 3px;
                                        width: self.d;
                                        height: self.d;
                                        border-radius: self.d / 2;
                                        background: note-dot.has-hover ? white : Theme.soft2;
                                        animate d { duration: 120ms; }
                                    }

                                    note-dot := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            Tip.text = "";
                                            root.note-seek(i);
                                        }
                                        changed has-hover => {
                                            if self.has-hover {
                                                Tip.text = n.tip;
                                                Tip.x = parent.absolute-position.x + parent.width / 2;
                                                Tip.top = parent.absolute-position.y;
                                                Tip.bottom = parent.absolute-position.y + parent.height;
                                            } else if Tip.text == n.tip {
                                                Tip.text = "";
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                width: 44px;
                                text: root.dur-text;
                                color: Theme.dim;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // меню ⋯ (таймер сна, эквалайзер…) + устройства + очередь + текст + громкость
                    HorizontalLayout {
                        width: root.conn-on ? 350px : 310px;
                        spacing: 8px;
                        if root.has-track: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                IconBtn {
                                    size: 30px;
                                    icon: Icons.more;
                                    tip: @tr("Ещё");
                                    active: root.sleep-mode != 0 || !root.fx-default;
                                    clicked => {
                                        root.open-menu(0, 2, 0, self.absolute-position.x, self.absolute-position.y);
                                    }
                                }

                                if root.sleep-mode != 0: Rectangle {
                                    x: parent.width - 14px;
                                    y: -2px;
                                    width: max(16px, sleep-badge.preferred-width + 8px);
                                    height: 16px;
                                    border-radius: 8px;
                                    background: Theme.c1;
                                    sleep-badge := Text {
                                        text: root.sleep-mode == 4 ? "♪" : root.sleep-left;
                                        color: white;
                                        font-size: 9px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // устройства Connect: куда идёт звук
                        if root.conn-on: VerticalLayout {
                            alignment: center;
                            IconBtn {
                                size: 32px;
                                icon: Icons.devices;
                                active: root.conn-open || root.conn-remote != "";
                                tip: root.conn-remote != "" ? @tr("Играет на «{}»", root.conn-remote) : @tr("Устройства");
                                clicked => {
                                    root.conn-open = !root.conn-open;
                                    root.fx-open = false;
                                }
                            }
                        }

                        // луна: по кругу выкл → 15 → 30 → 60 мин → после трека; цифра — сколько минут осталось
                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                size: 32px;
                                icon: Icons.queue;
                                tip: @tr("Очередь");
                                active: root.deck-open && root.deck-tab == 1;
                                clicked => {
                                    if root.deck-open && root.deck-tab == 1 {
                                        root.deck-open = false;
                                    } else {
                                        root.deck-tab = 1;
                                        root.deck-open = true;
                                    }
                                    root.conn-open = false;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            IconBtn {
                                size: 32px;
                                icon: Icons.mic;
                                tip: @tr("Текст песни");
                                active: root.deck-open && root.deck-tab == 0;
                                clicked => {
                                    if root.deck-open && root.deck-tab == 0 {
                                        root.deck-open = false;
                                    } else {
                                        root.deck-tab = 0;
                                        root.deck-open = true;
                                    }
                                    root.conn-open = false;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                d: Icons.volume;
                                fill: Theme.dim;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            vol := Slider {
                                value: root.volume;
                                moving(v) => {
                                    root.preview-volume(v);
                                }
                                changed(v) => {
                                    root.volume = v;
                                    root.set-volume(v);
                                }
                            }
                        }

                        Text {
                            width: 36px;
                            text: Math.round(vol.shown * 100) + "%";
                            color: Theme.dim;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                }
            }
        }
    }
    }

    // ── заметки к моментам трека: список и поле «добавить на текущей секунде» ──
    if root.notes-open: Rectangle {
        background: #000000a0;
        TouchArea {
            clicked => {
                root.notes-open = false;
            }
        }

        Rectangle {
            width: 440px;
            height: min(root.height - 160px, 150px + root.notes.length * 44px);
            border-radius: 22px;
            background: #14101f;
            border-width: 1px;
            border-color: #ffffff1c;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: @tr("Заметки · {}", root.now-title);
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 800;
                    overflow: elide;
                }

                if root.notes.length > 0: ListView {
                    vertical-stretch: 1;
                    for n[i] in root.notes: Rectangle {
                        height: 44px;
                        border-radius: 10px;
                        background: note-ta.has-hover ? #ffffff0c : #ffffff00;
                        note-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.note-seek(i);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 10px;
                            Text {
                                text: n.time;
                                color: Theme.soft2;
                                font-size: 13px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            Text {
                                text: n.text;
                                color: Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    size: 28px;
                                    icon: Icons.trash;
                                    tip: @tr("Удалить заметку");
                                    clicked => {
                                        root.note-remove(i);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.notes.length == 0: Text {
                    vertical-stretch: 1;
                    text: @tr("Напиши пару слов и нажми Enter — заметка встанет на текущую секунду трека.");
                    color: Theme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                note-field := Field {
                    placeholder: @tr("Заметка на {}", root.pos-text);
                    icon: Icons.edit;
                    accepted(t) => {
                        root.note-add(t);
                        self.text = "";
                    }
                }
            }
        }
    }

    // ── итоги месяца и года: карточка, которую можно сохранить картинкой ──
    if root.recap-open: Rectangle {
        background: #000000c8;
        TouchArea {
            clicked => {
                root.recap-open = false;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                recap-card := Rectangle {
                    width: 400px;
                    height: min(600px, root.height - 120px);
                    border-radius: 26px;
                    clip: true;
                    background: @linear-gradient(160deg, Theme.deep1 0%, #0a0812 55%, Theme.deep2 100%);
                    TouchArea { }
                    Rectangle {
                        x: -80px;
                        y: -90px;
                        width: 300px;
                        height: 300px;
                        border-radius: 150px;
                        background: @radial-gradient(circle, Theme.c1.transparentize(0.45) 0%, Theme.c1.transparentize(1) 100%);
                    }

                    Rectangle {
                        x: parent.width - 200px;
                        y: parent.height - 190px;
                        width: 300px;
                        height: 300px;
                        border-radius: 150px;
                        background: @radial-gradient(circle, Theme.c2.transparentize(0.6) 0%, Theme.c2.transparentize(1) 100%);
                    }

                    VerticalLayout {
                        padding: 26px;
                        spacing: 6px;
                        Text {
                            text: "GARGANTUA · " + (root.recap-year ? @tr("ИТОГИ ГОДА") : @tr("ИТОГИ МЕСЯЦА"));
                            color: #ffffffa0;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 2px;
                        }

                        Text {
                            text: root.recap-title;
                            color: white;
                            font-size: 30px;
                            font-weight: 900;
                        }

                        Rectangle {
                            height: 8px;
                        }

                        Text {
                            text: root.recap-time;
                            color: Theme.soft2;
                            font-size: 40px;
                            font-weight: 900;
                        }

                        Text {
                            text: root.recap-sub;
                            color: #ffffffb8;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 10px;
                        }

                        if root.recap-tracks.length > 0: Text {
                            text: @tr("ТРЕКИ");
                            color: #ffffff80;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 1.5px;
                        }

                        for r[i] in root.recap-tracks: HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: i + 1;
                                width: 14px;
                                color: Theme.soft1;
                                font-size: 14px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: r.a;
                                    color: white;
                                    font-size: 14px;
                                    font-weight: 700;
                                    overflow: elide;
                                }

                                Text {
                                    text: r.b;
                                    color: #ffffff90;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: r.n;
                                color: #ffffffb8;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 8px;
                        }

                        if root.recap-artists.length > 0: Text {
                            text: @tr("АРТИСТЫ");
                            color: #ffffff80;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 1.5px;
                        }

                        for r[i] in root.recap-artists: HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: i + 1;
                                width: 14px;
                                color: Theme.soft2;
                                font-size: 14px;
                                font-weight: 800;
                            }

                            Text {
                                text: r.a;
                                color: white;
                                font-size: 14px;
                                font-weight: 700;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: r.n;
                                color: #ffffffb8;
                                font-size: 12px;
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Chip {
                    text: @tr("Месяц");
                    accent: Theme.soft1;
                    active: !root.recap-year;
                    clicked => {
                        root.open-recap(false);
                    }
                }

                Chip {
                    text: @tr("Год");
                    accent: Theme.soft1;
                    active: root.recap-year;
                    clicked => {
                        root.open-recap(true);
                    }
                }

                Pill {
                    text: @tr("Сохранить картинкой");
                    clicked => {
                        root.save-recap(recap-card.absolute-position.x, recap-card.absolute-position.y, recap-card.width, recap-card.height);
                    }
                }
            }
        }
    }

    // ── панель «Сейчас играет»: обложка, спектр и текст или очередь. Раздвигает контент, а не лежит поверх ──
    deck := Rectangle {
        property <length> w: 340px;
        x: root.deck-open ? root.width - self.w : root.width + 40px;
        y: 0px;
        width: self.w;
        height: root.height - 96px;
        visible: (root.deck-open || self.x < root.width) && !root.lyrics-open;
        // рядом с контентом панель прозрачная, как сайдбар; поверх контента (узкое окно) — плотная, иначе текст нечитаем
        background: root.deck-push ? #0b091359 : #0c0a16f5;
        drop-shadow-blur: root.deck-push ? 0px : 40px;
        drop-shadow-color: #00000099;
        animate x { duration: 280ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
        TouchArea { }
        Rectangle {
            x: 0px;
            width: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            x: 0px;
            width: deck.w;
            padding: 16px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("СЕЙЧАС ИГРАЕТ");
                    color: Theme.faint;
                    font-size: 11px;
                    font-weight: 800;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if root.deck-tab == 0: VerticalLayout {
                    alignment: center;
                    IconBtn {
                        size: 28px;
                        icon: Icons.fullscreen;
                        tip: @tr("Текст на весь экран");
                        clicked => {
                            root.set-lyrics-open(true);
                            lyr-keys.focus();
                        }
                    }
                }

                // переключатель вкладок с бегунком
                Rectangle {
                    width: 156px;
                    height: 30px;
                    border-radius: 15px;
                    background: #ffffff0a;
                    border-width: 1px;
                    border-color: Theme.line;
                    Rectangle {
                        x: root.deck-tab == 0 ? 2px : parent.width / 2;
                        y: 2px;
                        width: parent.width / 2 - 2px;
                        height: 26px;
                        border-radius: 13px;
                        background: Theme.c1.transparentize(0.62);
                        animate x { duration: 220ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
                    }

                    for t[i] in [@tr("Текст"), @tr("Очередь")]: Rectangle {
                        x: i * parent.width / 2;
                        width: parent.width / 2;
                        Text {
                            text: t;
                            color: root.deck-tab == i ? Theme.text : Theme.dim;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.deck-tab = i;
                            }
                        }
                    }
                }
            }

            // обложка; название и артист — поверх, на затемнении снизу
            Rectangle {
                cache-rendering-hint: true; // слой: пока внутри ничего не менялось, рисуется готовой картинкой (см. viz-box)
                height: self.width;
                border-radius: 20px;
                clip: true;
                background: @linear-gradient(135deg, Theme.deep1 0%, #120d1d 100%);
                Icon {
                    d: Icons.note;
                    width: 88px;
                    height: 88px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    fill: #ffffff26;
                    visible: !root.now-has-cover;
                }

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.now-cover;
                    image-fit: cover;
                    opacity: root.now-has-cover ? 1 : 0;
                    animate opacity { duration: 300ms; }
                }

                Rectangle {
                    y: parent.height - self.height;
                    height: 110px;
                    background: @linear-gradient(180deg, #00000000 0%, #000000d0 100%);
                }

                VerticalLayout {
                    alignment: end;
                    padding: 16px;
                    spacing: 2px;
                    Text {
                        text: root.has-track ? root.now-title : @tr("Тишина");
                        color: white;
                        font-size: 17px;
                        font-weight: 800;
                        overflow: elide;
                    }

                    Text {
                        text: root.now-artist;
                        color: #ffffffb8;
                        font-size: 12px;
                        overflow: elide;
                    }
                }

                Rectangle {
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: #ffffff1c;
                }
            }

            // спектр: столбики растут от низа, высоты приходят из Rust уже сглаженными. Он меняется 30 раз в секунду,
            // и раньше каждый его кадр перерисовывал всё окно — со всем текстом страницы (20%+ ядра). Теперь большие
            // куски окна — слои (cache-rendering-hint): за кадр спектра заново рисуются только столбики
            viz-box := Rectangle {
                height: 54px;
                for v[i] in root.viz: Rectangle {
                    property <length> step: viz-box.width / max(1, root.viz.length);
                    x: i * self.step + 1.5px;
                    width: self.step - 3px;
                    height: max(3px, v * viz-box.height);
                    y: viz-box.height - self.height;
                    border-radius: 2px;
                    background: @linear-gradient(180deg, Theme.c2 0%, Theme.c1 100%);
                }
            }

            if root.deck-tab == 0: Rectangle {
                cache-rendering-hint: true; // слой: пока внутри ничего не менялось, рисуется готовой картинкой (см. viz-box)
                vertical-stretch: 1;
                clip: true;
                if root.lyr-state == 0 || root.lyr-state == 3: Text {
                    text: root.lyr-state == 0 ? @tr("Ищу текст…") : @tr("Текста нет");
                    color: Theme.faint;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if root.lyr-state == 2: Flickable {
                    content-height: deck-plain.preferred-height;
                    deck-plain := VerticalLayout {
                        spacing: 8px;
                        for l in root.lyr-plain: Text {
                            text: l;
                            color: Theme.dim;
                            font-size: 14px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }
                }

                // строки с таймингами: поющаяся — в рамке и на трети высоты, список сам к ней подъезжает
                if root.lyr-state == 1: deck-lyr := Rectangle {
                    property <length> cur-y;
                    property <length> cur-h;
                    VerticalLayout {
                        y: min(0px, deck-lyr.height * 0.36 - deck-lyr.cur-y - deck-lyr.cur-h / 2);
                        height: self.preferred-height;
                        alignment: start;
                        spacing: 4px;
                        animate y { duration: 520ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
                        for line[i] in root.lyr-lines: Rectangle {
                            // где поющаяся строка — узнаём от неё самой: высоты строк разные (перенос слов)
                            property <bool> me: i == max(0, root.lyr-cur);
                            property <bool> lit: i == root.act0 || i == root.act1 || i == root.act2 || i == root.lyr-cur;
                            height: deck-line.preferred-height + 16px;
                            border-radius: 12px;
                            background: self.lit ? Theme.c1.transparentize(0.86) : deck-line-ta.has-hover ? #ffffff0a : #ffffff00;
                            border-width: 1px;
                            border-color: self.lit ? Theme.c1.transparentize(0.5) : #ffffff00;
                            animate background, border-color { duration: 260ms; }
                            init => {
                                if self.me {
                                    deck-lyr.cur-y = self.y;
                                    deck-lyr.cur-h = self.height;
                                }
                            }
                            changed me => {
                                if self.me {
                                    deck-lyr.cur-y = self.y;
                                    deck-lyr.cur-h = self.height;
                                }
                            }
                            changed y => {
                                if self.me {
                                    deck-lyr.cur-y = self.y;
                                    deck-lyr.cur-h = self.height;
                                }
                            }
                            deck-line := Text {
                                x: 12px;
                                y: 8px;
                                width: parent.width - 24px;
                                text: line.dots ? "•  •  •" : line.text;
                                // поющаяся строка — чисто белая и жирнее, остальные приглушены: глаз сразу находит, где сейчас
                                color: parent.lit ? #ffffff : i < root.lyr-cur ? #ffffff4d : #ffffff66;
                                font-size: line.bg ? 12px : 14px;
                                // жирность у всех одна: с разной ширина слов менялась, и перенос у поющейся строки прыгал
                                font-weight: 700;
                                wrap: word-wrap;
                                horizontal-alignment: line.right ? right : left;
                                animate color { duration: 260ms; }
                            }

                            deck-line-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.lyr-seek(i);
                                }
                            }
                        }
                    }
                }
            }

            if root.deck-tab == 1: Rectangle {
                cache-rendering-hint: true; // слой, как у вкладки текста
                vertical-stretch: 1;
                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    Text {
                        text: @tr("ИСТОРИЯ");
                        color: Theme.faint;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1.5px;
                        visible: root.q-hist.length > 0;
                    }

                    if root.q-hist.length > 0: ListView {
                        height: min(108px, root.q-hist.length * 52px);
                        for t[i] in root.q-hist: QueueRow {
                            item: t;
                            dim: true;
                            play => {
                                root.history-jump(i);
                            }
                            want-cover(u) => {
                                root.want-cover(u);
                            }
                        }
                    }

                    Text {
                        text: root.shuffle ? @tr("ДАЛЕЕ · ВПЕРЕМЕШКУ") : @tr("ДАЛЕЕ");
                        color: Theme.faint;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1.5px;
                    }

                    q-box := Rectangle {
                        vertical-stretch: 1;
                        property <int> drag-from: -1;
                        property <length> drag-y;
                        property <int> drag-to: max(0, min(root.q-next.length, Math.round((self.drag-y - q-list.viewport-y) / 52px)));
                        Rectangle {
                            x: 4px;
                            y: q-box.drag-to * 52px + q-list.viewport-y - 1px;
                            width: parent.width - 8px;
                            height: 2px;
                            border-radius: 1px;
                            background: Theme.soft2;
                            visible: q-box.drag-from >= 0;
                        }

                        q-list := ListView {
                        for t[i] in root.q-next: QueueRow {
                            item: t;
                            editable: true;
                            can-drag: true;
                            dragged: i == q-box.drag-from;
                            drag-at(y) => {
                                q-box.drag-from = i;
                                q-box.drag-y = y - q-box.absolute-position.y;
                            }
                            drag-end => {
                                if q-box.drag-to != i && q-box.drag-to != i + 1 {
                                    root.queue-move(i, (q-box.drag-to > i ? q-box.drag-to - 1 : q-box.drag-to) - i);
                                }
                                q-box.drag-from = -1;
                            }
                            play => {
                                root.queue-jump(i);
                            }
                            move(d) => {
                                root.queue-move(i, d);
                            }
                            remove => {
                                root.queue-remove(i);
                            }
                            want-cover(u) => {
                                root.want-cover(u);
                            }
                        }
                    }
                    }

                    if root.q-next.length == 0: Text {
                        text: @tr("Дальше пусто");
                        color: Theme.faint;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // ── устройства Connect: всплывают над плеером, клик — звук переезжает туда ──
    Rectangle {
        width: 100%;
        height: root.height - 96px;
        visible: root.conn-open;
        TouchArea {
            clicked => {
                root.conn-open = false;
            }
        }
    }

    Rectangle {
        x: root.width - self.width - 20px;
        y: root.conn-open ? root.height - 96px - self.height - 12px : root.height + 20px;
        width: 320px;
        height: conn-lay.preferred-height;
        visible: root.conn-open || self.y < root.height;
        background: #110d1cf7;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.c1.transparentize(0.73);
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000aa;
        animate y { duration: 280ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
        TouchArea { }

        conn-lay := VerticalLayout {
            padding: 14px;
            spacing: 4px;
            Text {
                text: @tr("Где играть");
                color: Theme.text;
                font-size: 17px;
                font-weight: 800;
            }

            Text {
                text: @tr("Все устройства твоего аккаунта, где открыт Gargantua");
                color: Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }

            Rectangle { height: 6px; }

            for d in root.conn-devs: Rectangle {
                height: 52px;
                border-radius: 12px;
                background: d.active ? Theme.c1.transparentize(0.8) : dev-ta.has-hover ? #ffffff10 : #ffffff00;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    alignment: start;
                    Icon {
                        d: d.phone ? Icons.phone : Icons.pc;
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        fill: d.active ? Theme.soft2 : #bdb6d3;
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: d.name;
                            color: d.active ? Theme.soft2 : Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            text: d.active ? @tr("звук тут") : d.me ? @tr("это устройство") : "";
                            visible: self.text != "";
                            color: Theme.dim;
                            font-size: 11px;
                        }
                    }
                }

                dev-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.conn-pick(d.id);
                        root.conn-open = false;
                    }
                }
            }
        }
    }

    // ── панель звука: эквалайзер и скорость, всплывает над плеером ──
    Rectangle {
        width: 100%;
        height: root.height - 96px;
        visible: root.fx-open;
        TouchArea {
            clicked => {
                root.fx-open = false;
            }
        }
    }

    Rectangle {
        property <length> w: min(700px, root.width - 40px);
        x: root.width - self.w - 20px;
        y: root.fx-open ? root.height - 96px - self.height - 12px : root.height + 20px;
        width: self.w;
        height: fx-lay.preferred-height;
        visible: root.fx-open || self.y < root.height;
        background: #110d1cf7;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.c1.transparentize(0.73);
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000aa;
        animate y { duration: 280ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
        TouchArea { }

        fx-lay := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: @tr("Звук");
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 800;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Pill {
                    height: 34px;
                    text: @tr("Сбросить всё");
                    primary: false;
                    enabled: !root.fx-default;
                    clicked => {
                        root.fx-reset();
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        size: 32px;
                        icon: Icons.close;
                        tip: @tr("Закрыть");
                        clicked => {
                            root.fx-open = false;
                        }
                    }
                }
            }

            // пресеты (два ряда)
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for name[i] in root.eq-presets: Chip {
                    text: name;
                    accent: Theme.soft1;
                    active: root.eq-preset == i;
                    clicked => {
                        root.set-eq-preset(i);
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for name[i] in root.eq-presets2: Chip {
                    text: name;
                    accent: Theme.soft1;
                    active: root.eq-preset == i + root.eq-presets.length;
                    clicked => {
                        root.set-eq-preset(i + root.eq-presets.length);
                    }
                }
            }

            // полосы
            HorizontalLayout {
                spacing: 0px;
                alignment: space-between;
                for g[i] in root.eq-gains: VerticalLayout {
                    spacing: 6px;
                    width: 52px;
                    // значение видно и пока тянут, а не только после отпускания
                    property <float> db: Math.round((band.shown * 24 - 12) * 2) / 2;
                    Text {
                        text: (parent.db > 0 ? "+" : "") + parent.db;
                        color: parent.db == 0 ? Theme.faint : Theme.soft2;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        band := VSlider {
                            height: 150px;
                            value: (g + 12) / 24;
                            changed(v) => {
                                root.set-eq-band(i, v);
                            }
                        }
                    }

                    Text {
                        text: root.eq-names[i] + @tr(" Гц");
                        color: Theme.dim;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            // скорость
            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: @tr("Скорость");
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    speed-sl := Slider {
                        // 0.5×…2× → 0…1
                        value: (root.speed - 0.5) / 1.5;
                        changed(v) => {
                            root.set-speed(0.5 + v * 1.5);
                        }
                    }
                }

                Text {
                    width: 52px;
                    property <float> v: Math.round((0.5 + speed-sl.shown * 1.5) * 20) / 20;
                    text: self.v + "×";
                    color: self.v == 1 ? Theme.dim : Theme.soft2;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for v in [0.75, 0.85, 1, 1.15, 1.25, 1.5]: Chip {
                    text: v + "×";
                    accent: Theme.c2;
                    active: Math.abs(root.speed - v) < 0.001;
                    clicked => {
                        root.set-speed(v);
                    }
                }
            }

            SettingRow {
                title: @tr("Сохранять тональность");
                desc: @tr("Выключи — и при замедлении голос станет ниже, при ускорении выше: тот самый slowed / sped up.");
                on: root.keep-pitch;
                toggled => {
                    root.set-keep-pitch(!root.keep-pitch);
                }
            }
        }
    }

    // ── экран lyrics: выезжает снизу, фон — размытая обложка, как в Apple Music ──
    lyr-screen := Rectangle {
        property <length> big: max(self.width, self.height);
        // фон плывёт плавно между тиками, как и заливка
        property <float> bt: root.bg-t;
        animate bt { duration: root.lyr-step; easing: linear; }
        property <float> ui: root.lyr-idle ? 0 : 1;
        animate ui { duration: 900ms; easing: ease-in-out; }
        width: 100%;
        height: 100%;
        y: root.lyrics-open ? 0px : root.height;
        visible: (root.lyrics-open || self.y < root.height - 1px) && !root.covered;
        clip: true;
        background: @linear-gradient(160deg, Theme.deep1 0%, #07060b 100%);
        // пока выезжает, под ним рисуется и весь главный экран — два экрана на кадр. В трейлере без выезда
        animate y { duration: 420ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1); }
        // огромные вращающиеся слои фона (в 1.7 экрана) — самое дорогое на кадре. Пока экран едет,
        // под ним рисуется ещё и главный экран, поэтому фон проявляется, только когда экран доехал
        property <float> bg-on: self.y < 1px ? 1 : 0;
        animate bg-on { duration: self.y < 1px ? 450ms : 0ms; easing: ease-out; }

        // крошечная размытая обложка, растянутая на весь экран — мягкие пятна цвета; медленно вращается
        Image {
            width: lyr-screen.big * 1.7;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.bg-img;
            image-fit: fill;
            visible: root.has-big && lyr-screen.bg-on > 0.01;
            transform-rotation: lyr-screen.bt * 3deg;
        }

        // два пятна с мягкими краями плавают по кругу поверх
        Image {
            width: lyr-screen.big * 0.95;
            height: self.width;
            x: parent.width * 0.25 - self.width / 2 + lyr-screen.big * 0.12 * Math.cos(lyr-screen.bt * 0.13 * 1rad);
            y: parent.height * 0.3 - self.height / 2 + lyr-screen.big * 0.1 * Math.sin(lyr-screen.bt * 0.17 * 1rad);
            source: root.blob-img;
            image-fit: fill;
            visible: root.has-big && lyr-screen.bg-on > 0.01;
            transform-rotation: -lyr-screen.bt * 7deg;
        }

        Image {
            width: lyr-screen.big * 0.8;
            height: self.width;
            x: parent.width * 0.78 - self.width / 2 + lyr-screen.big * 0.1 * Math.sin(lyr-screen.bt * 0.11 * 1rad);
            y: parent.height * 0.72 - self.height / 2 + lyr-screen.big * 0.12 * Math.cos(lyr-screen.bt * 0.09 * 1rad);
            source: root.blob-img;
            image-fit: fill;
            visible: root.has-big && lyr-screen.bg-on > 0.01;
            transform-rotation: lyr-screen.bt * 5deg + 140deg;
        }

        // затемнение, чтобы белый текст читался на любой обложке
        Rectangle {
            background: #00000070;
        }

        // фон проявляется из-под шторки цвета экрана: прозрачность самих огромных слоёв — отдельный
        // проход отрисовки на каждый, это дорого
        Rectangle {
            visible: root.has-big && lyr-screen.bg-on < 0.99;
            background: @linear-gradient(160deg, Theme.deep1.transparentize(lyr-screen.bg-on) 0%, #07060b.transparentize(lyr-screen.bg-on) 100%);
        }

        // логотип-дыра: всегда тут, в режиме "в дыру" спетые строки улетают в него
        hole := Rectangle {
            z: 10; // поверх всего — строки исчезают прямо в логотипе
            // всегда — или только когда строки уходят "в дыру" (настройка)
            opacity: root.hole-always || root.lyr-exit == 3 || root.lyr-exit == 7 ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 300ms; }
            x: 22px;
            y: 18px;
            width: 64px;
            height: 64px;
            Rectangle {
                x: -38px;
                y: -38px;
                width: 140px;
                height: 140px;
                background: @radial-gradient(circle, Theme.soft1.transparentize(0.67) 0%, Theme.soft1.transparentize(1) 70%);
            }

            Image {
                width: 100%;
                height: 100%;
                source: @image-url("../assets/logo-mark.svg");
                transform-rotation: lyr-screen.bt * 20deg;
            }
        }

        // мышь 2 с не двигается — прячем всё лишнее и сам курсор. Родительский TouchArea видит
        // движение и над кнопками внутри (фильтр до детей), поэтому весь экран лежит внутри него
        idle-ta := TouchArea {
            mouse-cursor: root.lyr-idle ? MouseCursor.none : MouseCursor.default;
            changed mouse-x => {
                root.lyr-activity();
            }
            changed mouse-y => {
                root.lyr-activity();
            }

            lyr-keys := FocusScope {
                key-pressed(e) => {
                    return root.on-key(e);
                }
            }

            HorizontalLayout {
                padding: 56px;
                padding-top: 40px;
                spacing: 64px;

                // ── слева: обложка, название, управление ──
                left-col := VerticalLayout {
                    property <length> cover-size: min(380px, root.width * 0.3, root.height * 0.42);
                    width: min(400px, root.width * 0.34);
                    alignment: start;
                    // вся колонка по центру; когда управление спрятано — оставшееся (обложка, название,
                    // прогресс) плавно опускается в центр: сдвиг на половину спрятанного, вместе с его затуханием
                    padding-top: max(0px, (lyr-screen.height - 96px - left-stack.preferred-height) / 2 + (extras.preferred-height + 12px) / 2 * (1 - lyr-screen.ui));
                    left-stack := VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            padding-bottom: 14px;
                            Rectangle {
                                // на паузе обложка чуть сжимается, как в Apple Music
                                property <length> full: left-col.cover-size;
                                width: self.full;
                                height: self.full;
                                Rectangle {
                                    property <float> k: root.playing ? 1 : 0.84;
                                    width: parent.width * self.k;
                                    height: self.width;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 18px;
                                    background: #120d1d;
                                    drop-shadow-blur: 40px;
                                    drop-shadow-offset-y: 14px;
                                    drop-shadow-color: #00000090;
                                    animate k { duration: 450ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
                                    Rectangle {
                                        border-radius: 18px;
                                        clip: true;
                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: root.has-big ? root.big-cover : root.now-cover;
                                            image-fit: cover;
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.has-track ? root.now-title : @tr("Тишина");
                            color: white;
                            font-size: 24px;
                            font-weight: 800;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.loading ? @tr("засасываю поток…") : root.now-artist;
                            color: lyr-artist-ta.has-hover ? #ffffff : #ffffffa6;
                            font-size: 16px;
                            horizontal-alignment: center;
                            overflow: elide;
                            lyr-artist-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-artist(0, 2);
                                }
                            }
                        }

                        VerticalLayout {
                            padding-top: 10px;
                            spacing: 4px;
                            Slider {
                                thick: 6px; // на большом экране — пожирнее
                                value: root.position;
                                changed(v) => {
                                    root.seek(v);
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: root.pos-text;
                                    color: #ffffff99;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.dur-text;
                                    color: #ffffff99;
                                    font-size: 12px;
                                }
                            }
                        }

                        // управление, громкость, настройки и подпись: гаснут, когда мышь 2 с не двигается.
                        // visible=false место в раскладке не освобождает — сдвиг к центру считаем сами (padding-top выше)
                        extras := Rectangle {
                            opacity: lyr-screen.ui;
                            visible: self.opacity > 0.01;
                            VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 18px;
                                    VerticalLayout {
                                        alignment: center;
                                        IconBtn {
                                            size: 34px;
                                            icon: root.smart-shuffle ? Icons.shuffle-smart : Icons.shuffle;
                                            tip: root.smart-shuffle ? @tr("Умное перемешивание: раз в 2–3 трека — похожий") : root.shuffle ? @tr("Перемешано. Ещё раз — умное перемешивание") : @tr("Перемешать");
                                            active: root.shuffle;
                                            glow: root.smart-shuffle ? 1 : 0;
                                            clicked => {
                                                root.toggle-shuffle();
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        IconBtn {
                                            size: 44px;
                                            icon: Icons.prev;
                                            tip: @tr("Предыдущий трек");
                                            clicked => {
                                                root.prev();
                                            }
                                        }
                                    }

                                    IconBtn {
                                        size: 64px;
                                        primary: true;
                                        glow: root.playing ? root.pulse : 0;
                                        icon: root.playing ? Icons.pause : Icons.play;
                                        tip: root.playing ? @tr("Пауза") : @tr("Играть");
                                        clicked => {
                                            root.toggle-play();
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        IconBtn {
                                            size: 44px;
                                            icon: Icons.next;
                                            tip: @tr("Следующий трек");
                                            clicked => {
                                                root.next();
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        IconBtn {
                                            size: 34px;
                                            icon: root.repeat == 2 ? Icons.repeat-one : Icons.repeat;
                                            tip: root.repeat == 2 ? @tr("Повтор трека") : @tr("Повтор");
                                            active: root.repeat > 0;
                                            clicked => {
                                                root.toggle-repeat();
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding-top: 10px;
                                    Chip {
                                        text: root.karaoke ? @tr("Караоке: вкл") : @tr("Караоке: выкл");
                                        accent: Theme.soft2;
                                        active: root.karaoke;
                                        clicked => {
                                            root.set-karaoke(!root.karaoke);
                                        }
                                    }

                                    Chip {
                                        text: @tr("Стиль: {}", root.lyr-style == 0 ? @tr("плавно") : root.lyr-style == 1 ? @tr("каскад") : @tr("фокус"));
                                        accent: Theme.soft1;
                                        active: true;
                                        clicked => {
                                            root.set-lyr-style(Math.mod(root.lyr-style + 1, 3));
                                        }
                                    }

                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Chip {
                                        text: @tr("Уход: {}", root.lyr-exit == 0 ? @tr("тускнеют") : root.lyr-exit == 2 ? @tr("сдув") : root.lyr-exit == 3 ? @tr("в дыру")
                                            : root.lyr-exit == 7 ? @tr("в дыру буквами") : root.lyr-exit == 4 ? @tr("падение") : root.lyr-exit == 5 ? @tr("испарение") : @tr("взрыв"));
                                        accent: Theme.c2;
                                        active: true;
                                        clicked => {
                                            // по кругу: тускнеют → сдув → в дыру → в дыру буквами → падение → испарение → взрыв
                                            root.set-lyr-exit(root.lyr-exit == 0 ? 2 : root.lyr-exit == 3 ? 7 : root.lyr-exit == 7 ? 4 : root.lyr-exit == 6 ? 0 : root.lyr-exit + 1);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    padding-top: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            d: Icons.volume;
                                            fill: #ffffff99;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 200px;
                                        lyr-vol := Slider {
                                            value: root.volume;
                                            moving(v) => {
                                                root.preview-volume(v);
                                            }
                                            changed(v) => {
                                                root.volume = v;
                                                root.set-volume(v);
                                            }
                                        }
                                    }

                                    Text {
                                        width: 40px;
                                        text: Math.round(lyr-vol.shown * 100) + "%";
                                        color: #ffffff99;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.lyr-credit != "": VerticalLayout {
                                    padding-top: 12px;
                                    spacing: 2px;
                                    Text {
                                        text: root.lyr-credit;
                                        color: #ffffff66;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 10px;
                                        for c in root.lyr-people: Text {
                                            text: c.label;
                                            color: credit-ta.has-hover ? #ffffffcc : #ffffff80;
                                            font-size: 12px;
                                            credit-ta := TouchArea {
                                                mouse-cursor: c.url != "" ? MouseCursor.pointer : MouseCursor.default;
                                                clicked => {
                                                    if c.url != "" {
                                                        root.open-url(c.url);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── справа: текст ──
                lyr-col := Rectangle {
                    horizontal-stretch: 1;
                    z: -1; // под левой панелью: улетающие в дыру строки проходят под обложкой
                    // без clip: строки должны долетать до логотипа за пределами колонки (обрезает весь экран)
                    // где колонка внутри экрана текста. Запоминаем при раскладке, а не берём absolute-position
                    // в биндингах строк: пока экран выезжает, absolute-position меняется каждый кадр, и все
                    // строки с буквами пересчитывались на каждом кадре выезда
                    property <length> off-x;
                    property <length> off-y;
                    function sync() {
                        self.off-x = self.absolute-position.x - lyr-screen.absolute-position.x;
                        self.off-y = self.absolute-position.y - lyr-screen.absolute-position.y;
                    }
                    init => {
                        root.lyr-width(self.width / 1px);
                        self.sync();
                    }
                    changed width => {
                        root.lyr-width(self.width / 1px);
                        self.sync();
                    }
                    changed height => {
                        self.sync();
                    }
                    changed x => {
                        self.sync();
                    }
                    changed y => {
                        self.sync();
                    }

                    if root.lyr-state == 1: Rectangle {
                        for line[i] in root.lyr-lines: LyricLine {
                            width: lyr-col.width;
                            idx: i;
                            prep-idx: root.lyr-prep;
                            line: line;
                            hole-x: hole.x + hole.width / 2 - lyr-col.off-x;
                            hole-y: hole.y + hole.height / 2 - lyr-col.off-y;
                            d: i - root.lyr-cur;
                            active: i == root.act0 || i == root.act1 || i == root.act2;
                            p: !root.lyr-clock ? (i == root.act0 ? root.p0 : i == root.act1 ? root.p1 : i == root.act2 ? root.p2 : 0)
                                : i == root.act0 ? root.wfill(root.lyr-pos, root.w0) : i == root.act1 ? root.wfill(root.lyr-pos, root.w1) : i == root.act2 ? root.wfill(root.lyr-pos, root.w2) : 0;
                            still: i == root.act0 ? root.still[0] : i == root.act1 ? root.still[1] : i == root.act2 ? root.still[2] : 0;
                            // бэк-вокал, допетый раньше своей основной строки, — тоже спет, а не "следующая строка"
                            done: !(i == root.act0 || i == root.act1 || i == root.act2) && (i < root.lyr-cur || i < root.act-max || (line.bg && i <= root.lyr-bg-done));
                            karaoke: root.karaoke;
                            style: root.lyr-style;
                            exit: root.lyr-exit;
                            quiet: i < root.lyr-jump;
                            stay-ms: root.fall-stay * 1000;
                            glow: root.lyr-glow;
                            view-top: lyr-col.off-y;
                            view-h: lyr-screen.height;
                            edge: root.lyr-edge * 1px;
                            step: root.lyr-step;
                            // пол — низ экрана, а не колонки текста
                            floor-y: lyr-screen.height - lyr-col.off-y - 26px;
                            shift: root.lyr-dots-open >= 0 && i > root.lyr-dots-open ? 84px : 0px;
                            anchor: lyr-col.height * 0.34;
                            cur-top: root.lyr-cur-top;
                            clicked => {
                                root.lyr-seek(i);
                            }
                        }
                    }

                    if root.lyr-state == 2: Flickable {
                        content-height: plain.preferred-height;
                        plain := VerticalLayout {
                            padding-top: 40px;
                            padding-bottom: 80px;
                            spacing: 10px;
                            for l in root.lyr-plain: Text {
                                text: l;
                                color: #ffffffd0;
                                font-size: 26px;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if root.lyr-state == 0 || root.lyr-state == 3: VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        Text {
                            text: root.lyr-state == 0 ? @tr("Ищу текст…") : @tr("Текста нет");
                            color: white;
                            font-size: 34px;
                            font-weight: 800;
                        }

                        Text {
                            text: root.lyr-state == 0 ? "lrclib.net" : @tr("Инструментал, или lrclib про этот трек не знает");
                            color: #ffffff80;
                            font-size: 15px;
                        }
                    }
                }
            }

            // ── справа сверху: фуллскрин и закрыть ──
            Rectangle {
                opacity: lyr-screen.ui;
                visible: self.opacity > 0.01;
                HorizontalLayout {
                    x: parent.width - self.width - 20px;
                    y: 18px;
                    width: self.preferred-width;
                    height: 40px;
                    spacing: 6px;
                    IconBtn {
                        size: 40px;
                        icon: Icons.translate;
                        active: root.lyr-tr;
                        tip: @tr("Перевод текста");
                        clicked => {
                            root.toggle-lyr-tr();
                        }
                    }

                    IconBtn {
                        size: 40px;
                        icon: Icons.fullscreen;
                        tip: @tr("Во весь экран");
                        clicked => {
                            root.toggle-fullscreen();
                        }
                    }

                    IconBtn {
                        size: 40px;
                        icon: Icons.down;
                        tip: @tr("Свернуть текст");
                        clicked => {
                            root.set-lyrics-open(false);
                        }
                    }
                }
            }
            }
    }

    // ── тост ──
    Rectangle {
        width: tl.preferred-width;
        height: 40px;
        x: (root.width - self.width) / 2;
        y: root.height - 96px - 56px + (root.toast-on ? 0px : 12px);
        border-radius: 20px;
        background: #1a1428f0;
        border-width: 1px;
        border-color: Theme.c1.transparentize(0.6);
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.c1.transparentize(0.6);
        opacity: root.toast-on ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity, y { duration: 220ms; easing: ease-out; }
        tl := HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            Text {
                text: root.toast;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }

    // ── подсказка кнопки: с задержкой, как обычные подсказки; у низа окна — над кнопкой ──
    // ── меню ⋯ ──
    if root.menu-open: Rectangle {
        TouchArea {
            clicked => {
                root.menu-open = false;
            }
            scroll-event(e) => {
                root.menu-open = false;
                reject
            }
        }

        Rectangle {
            width: 240px;
            height: menu-col.preferred-height;
            x: min(max(8px, root.menu-ax + 30px - self.width), root.width - self.width - 8px);
            // не влезает вниз — раскрываем вверх
            y: root.menu-ay + 34px + self.height + 8px < root.height ? root.menu-ay + 34px : max(8px, root.menu-ay - self.height - 4px);
            border-radius: 12px;
            background: #16141f;
            border-width: 1px;
            border-color: #ffffff1a;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000099;
            // клики мимо пунктов не закрывают меню
            TouchArea { }

            menu-col := VerticalLayout {
                padding: 6px;
                MenuItem {
                    icon: Icons.radio;
                    text: @tr("Радио по этому треку");
                    clicked => {
                        root.menu-open = false;
                        root.radio(root.menu-i, root.menu-kind);
                    }
                }

                if root.menu-kind != 2: MenuItem {
                    icon: Icons.queue;
                    text: @tr("Включить следующим");
                    clicked => {
                        root.menu-open = false;
                        root.play-next(root.menu-i, root.menu-kind);
                    }
                }

                MenuItem {
                    icon: Icons.link;
                    text: @tr("Поделиться ссылкой");
                    clicked => {
                        root.menu-open = false;
                        root.share(root.menu-i, root.menu-kind);
                    }
                }

                if root.menu-kind != 2: MenuItem {
                    icon: root.menu-dl == 2 ? Icons.check : Icons.download;
                    text: root.menu-dl == 2 ? @tr("Уже скачано") : root.menu-dl == 1 ? @tr("Качается…") : @tr("Скачать в mp3");
                    off: root.menu-dl != 0;
                    clicked => {
                        root.menu-open = false;
                        root.download(root.menu-i, root.menu-kind);
                    }
                }

                if root.menu-kind == 1: MenuItem {
                    icon: Icons.trash;
                    text: @tr("Убрать из плейлиста");
                    danger: true;
                    clicked => {
                        root.menu-open = false;
                        root.remove-track(root.menu-i);
                    }
                }

                // таймер перебирается кликами — меню не закрываем, видно, что выбралось
                if root.menu-kind == 2: MenuItem {
                    icon: Icons.edit;
                    text: root.notes.length > 0 ? @tr("Заметки к треку · {}", root.notes.length) : @tr("Заметка к моменту");
                    clicked => {
                        root.menu-open = false;
                        root.open-notes();
                    }
                }

                if root.menu-kind == 2: MenuItem {
                    icon: Icons.moon;
                    text: root.sleep-mode == 0 ? @tr("Таймер сна") : root.sleep-mode == 4 ? @tr("Усну после этого трека") : @tr("Усну через {} мин", root.sleep-left);
                    active: root.sleep-mode != 0;
                    clicked => {
                        root.set-sleep(Math.mod(root.sleep-mode + 1, 5));
                    }
                }

                if root.menu-kind == 2: MenuItem {
                    icon: Icons.eq;
                    text: @tr("Эквалайзер и скорость");
                    active: !root.fx-default;
                    clicked => {
                        root.menu-open = false;
                        root.fx-open = true;
                        root.conn-open = false;
                    }
                }
            }
        }
    }

    tip-box := Rectangle {
        property <bool> want: Tip.text != "";
        property <bool> on;
        property <bool> below: Tip.bottom + 44px < root.height;
        changed want => {
            if !self.want {
                self.on = false;
            }
        }
        Timer {
            interval: 450ms;
            running: tip-box.want && !tip-box.on;
            triggered => {
                tip-box.on = true;
            }
        }
        visible: self.on && self.want;
        width: tip-text.preferred-width + 22px;
        height: 30px;
        x: max(6px, min(root.width - self.width - 6px, Tip.x - self.width / 2));
        y: self.below ? Tip.bottom + 8px : Tip.top - self.height - 8px;
        border-radius: 9px;
        background: #1a1428f4;
        border-width: 1px;
        border-color: Theme.c1.transparentize(0.65);
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000088;
        tip-text := Text {
            text: Tip.text;
            color: Theme.text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ── модалка ──
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a8;
        opacity: root.modal > 0 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 180ms; }
        TouchArea {
            clicked => {
                // вопрос по импорту мимо не закрывается: без ответа плейлист не соберётся
                if root.modal != 6 {
                    root.modal = 0;
                }
            }
        }

        Rectangle {
            width: root.modal == 6 ? 480px : 380px;
            height: ml.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (root.modal > 0 ? 0px : 18px);
            animate y { duration: 220ms; easing: ease-out; }
            background: #120f1e;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.c1.transparentize(0.73);
            drop-shadow-blur: 40px;
            drop-shadow-color: Theme.c1.transparentize(0.67);
            TouchArea { }

            ml := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: root.modal == 1 ? @tr("Добавить в плейлист") : root.modal == 3 ? @tr("Удалить плейлист?") : root.modal == 4 ? @tr("Поделиться плейлистом")
                        : root.modal == 5 ? root.confirm-title : root.modal == 6 ? @tr("Точно эта песня?") : root.modal == 7 ? @tr("Изменить плейлист") : @tr("Новый плейлист");
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 800;
                }

                if root.modal == 1 && root.playlists.length > 0: ListView {
                    height: min(240px, root.playlists.length * 44px);
                    // в любимые — только сердечком, тут их нет
                    for p[i] in root.playlists: NavItem {
                        visible: !p.liked;
                        height: p.liked ? 0px : 40px;
                        icon: Icons.note;
                        text: p.name;
                        trailing: p.count;
                        clicked => {
                            root.add-to(i);
                        }
                    }
                }

                if root.modal == 1: Text {
                    text: @tr("или в новый:");
                    color: Theme.faint;
                    font-size: 12px;
                }

                if root.modal == 4: VerticalLayout {
                    spacing: 10px;
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            width: 300px;
                            height: 300px;
                            source: root.qr-img;
                            image-rendering: pixelated;
                        }
                    }

                    Text {
                        text: root.qr-total > 1
                            ? @tr("Плейлист большой — это часть {0} из {1}. При импорте выбери все части сразу.", root.qr-part, root.qr-total)
                            : @tr("Отсканируй или сохрани картинку и добавь её через «Импорт → Добавить по QR-коду».");
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    if root.qr-total > 1: HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        IconBtn {
                            icon: Icons.prev;
                            tip: @tr("Предыдущая часть");
                            clicked => {
                                root.qr-page(-1);
                            }
                        }

                        Text {
                            text: root.qr-part + " / " + root.qr-total;
                            color: Theme.text;
                            vertical-alignment: center;
                        }

                        IconBtn {
                            icon: Icons.next;
                            tip: @tr("Следующая часть");
                            clicked => {
                                root.qr-page(1);
                            }
                        }
                    }
                }

                if root.modal == 3: Text {
                    text: @tr("«{0}» ({1} треков) улетит за горизонт событий. Вернуть не получится.", root.pl-title, root.pl-tracks.length);
                    color: Theme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                if root.modal == 5: Text {
                    text: root.confirm-text;
                    color: Theme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                if root.modal == 6: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Искал");
                        color: Theme.faint;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.ask-want;
                        color: Theme.text;
                        font-size: 14px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: @tr("Нашлось на YT Music");
                        color: Theme.faint;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.ask-got;
                        color: Theme.soft2;
                        font-size: 14px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: @tr("Название, артист или длительность не сходятся — возможно, это другая песня или другая версия. Осталось проверить: {}", root.ask-left);
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    if root.ask-left > 1: HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Pill {
                            height: 34px;
                            text: @tr("Оставить все");
                            primary: false;
                            clicked => {
                                root.review(2);
                            }
                        }

                        Pill {
                            height: 34px;
                            text: @tr("Пропустить все");
                            primary: false;
                            clicked => {
                                root.review(3);
                            }
                        }
                    }
                }

                if root.modal == 7: Field {
                    placeholder: @tr("Название плейлиста");
                    text <=> root.edit-name;
                }

                // описание: несколько строк, Enter — перенос
                if root.modal == 7: Rectangle {
                    height: 110px;
                    border-radius: 14px;
                    background: #110e1c;
                    border-width: 1px;
                    border-color: desc-in.has-focus ? Theme.c1.transparentize(0.2) : #ffffff14;
                    TouchArea {
                        mouse-cursor: MouseCursor.text;
                        clicked => {
                            desc-in.focus();
                        }
                    }

                    if root.edit-desc == "": Text {
                        x: 16px;
                        y: 13px;
                        text: @tr("Описание (необязательно)");
                        color: Theme.faint;
                        font-size: 14px;
                    }

                    desc-in := TextInput {
                        x: 16px;
                        y: 13px;
                        width: parent.width - 32px;
                        height: parent.height - 26px;
                        text <=> root.edit-desc;
                        single-line: false;
                        wrap: word-wrap;
                        color: Theme.text;
                        font-size: 14px;
                        selection-background-color: Theme.c1.transparentize(0.5);
                    }
                }

                if root.modal == 1 || root.modal == 2: Field {
                    placeholder: @tr("Название плейлиста");
                    text <=> root.new-name;
                    accepted(n) => {
                        root.create-playlist(n);
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    if root.modal != 6: Pill {
                        text: @tr("Отмена");
                        primary: false;
                        clicked => {
                            root.modal = 0;
                        }
                    }

                    if root.modal == 5: Pill {
                        text: root.confirm-ok;
                        danger: root.confirm-danger;
                        clicked => {
                            root.confirm-yes();
                        }
                    }

                    if root.modal == 6: Pill {
                        text: @tr("Пропустить");
                        primary: false;
                        clicked => {
                            root.review(0);
                        }
                    }

                    if root.modal == 6: Pill {
                        text: @tr("Оставить");
                        clicked => {
                            root.review(1);
                        }
                    }

                    if root.modal == 4: Pill {
                        text: root.qr-total > 1 ? @tr("Сохранить все PNG") : @tr("Сохранить PNG");
                        clicked => {
                            root.qr-save();
                        }
                    }

                    if root.modal == 1 || root.modal == 2: Pill {
                        text: @tr("Создать");
                        clicked => {
                            root.create-playlist(root.new-name);
                        }
                    }

                    if root.modal == 7: Pill {
                        text: @tr("Сохранить");
                        clicked => {
                            root.save-playlist(root.edit-name, root.edit-desc);
                        }
                    }

                    if root.modal == 3: Pill {
                        text: @tr("Удалить");
                        danger: true;
                        clicked => {
                            root.modal = 0;
                            root.delete-playlist();
                        }
                    }
                }
            }
        }
    }

    // ── интро: кольца схлопываются в дыру, из неё раскручивается лого, ударная волна, потом название ──
    // время intro-t гонит Rust, кривые считаем тут: animate с delay до первого кадра окна Slint проглатывает
    pure function ip(start: float, dur: float) -> float {
        return max(0, min(1, (root.intro-t - start) / dur));
    }
    pure function out-expo(x: float) -> float {
        return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x);
    }
    pure function out-cubic(x: float) -> float {
        return 1 - (1 - x) * (1 - x) * (1 - x);
    }
    pure function smooth(x: float) -> float {
        return x * x * (3 - 2 * x);
    }

    // ── быстрая настройка при первом запуске: стоит под интро и открывается, когда оно уходит ──
    if root.setup-open: Rectangle {
        background: #07060bf0;
        TouchArea { }

        Rectangle {
            width: min(580px, root.width - 40px);
            height: min(setup-lay.preferred-height, root.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #120f1e;
            border-radius: 20px;
            border-width: 1px;
            border-color: Theme.c1.transparentize(0.7);
            drop-shadow-blur: 40px;
            drop-shadow-color: Theme.c1.transparentize(0.7);
            setup-lay := VerticalLayout {
                padding: 28px;
                spacing: 12px;
                Text {
                    text: @tr("Быстрая настройка");
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 800;
                }

                Text {
                    text: @tr("Пара вещей, чтобы всё сразу работало. Потом всё меняется в настройках.");
                    color: Theme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for l in [{ code: "ru", name: "Русский" }, { code: "en", name: "English" }, { code: "uk", name: "Українська" }, { code: "sk", name: "Slovenčina" }]: Chip {
                        text: l.name;
                        accent: Theme.soft1;
                        active: root.lang == l.code;
                        clicked => {
                            root.set-lang(l.code);
                        }
                    }
                }

                Text {
                    text: @tr("Браузер, где ты залогинен в YouTube");
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: @tr("Если YouTube начнёт просить доказать, что ты не бот, плеер возьмёт куки из этого браузера. Они никуда, кроме YouTube, не уходят.");
                    color: Theme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                for row in [["", "firefox", "chrome", "chromium", "brave"], ["edge", "opera", "vivaldi", "safari"]]: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for b in row: Chip {
                        text: b == "" ? @tr("Без кук") : b;
                        accent: #ff3355;
                        active: root.cookies == b;
                        clicked => {
                            root.set-cookies(b);
                        }
                    }
                }

                Text {
                    text: @tr("Ключ Spicy Lyrics — необязательно, но желательно");
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: @tr("Ещё один источник текстов: синки по слогам и бэк-вокал. Ключ бесплатный и хранится только у тебя.");
                    color: Theme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Field {
                        horizontal-stretch: 1;
                        text: root.spicy-key;
                        placeholder: "sl_sk_…";
                        password: true;
                        changed text => {
                            root.set-spicy-key(self.text);
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Pill {
                            text: @tr("Получить ключ");
                            primary: false;
                            clicked => {
                                root.open-url("https://developers.spicylyrics.org/dashboard/applications");
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    padding-top: 6px;
                    Pill {
                        text: @tr("Готово");
                        clicked => {
                            root.setup-done();
                        }
                    }
                }
            }
        }
    }

    // вход обязателен: без аккаунта плеер дальше не пускает, плейлисты живут на сервере
    if root.acc-on && root.acc-state != 2: Rectangle {
        background: #07060bf7;
        TouchArea { }

        Rectangle {
            width: min(520px, root.width - 40px);
            height: min(gate-lay.preferred-height, root.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #120f1e;
            border-radius: 20px;
            border-width: 1px;
            border-color: Theme.c1.transparentize(0.7);
            drop-shadow-blur: 40px;
            drop-shadow-color: Theme.c1.transparentize(0.7);
            gate-lay := VerticalLayout {
                padding: 28px;
                spacing: 12px;
                Text {
                    text: root.acc-state == 1 ? @tr("Подтверди почту") : root.acc-reg ? @tr("Регистрация") : @tr("Вход в Gargantua");
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 800;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for l in [{ code: "ru", name: "Русский" }, { code: "en", name: "English" }, { code: "uk", name: "Українська" }, { code: "sk", name: "Slovenčina" }]: Chip {
                        text: l.name;
                        accent: Theme.soft1;
                        active: root.lang == l.code;
                        clicked => {
                            root.set-lang(l.code);
                        }
                    }
                }

                if root.acc-state == 0: VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: root.acc-reg ? @tr("Почта и пароль от 6 символов. На почту придёт письмо со ссылкой для подтверждения.") : @tr("Плейлисты хранятся в аккаунте и одинаковые на всех твоих компьютерах.");
                        color: Theme.dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    acc-mail := Field {
                        placeholder: @tr("Почта");
                    }

                    acc-pw := Field {
                        placeholder: @tr("Пароль");
                        password: true;
                        accepted(_) => {
                            if !root.acc-reg {
                                root.acc-login(acc-mail.text, acc-pw.text);
                            }
                        }
                    }

                    if root.acc-reg: Field {
                        placeholder: @tr("Пароль ещё раз");
                        password: true;
                        changed text => {
                            root.acc-pw2 = self.text;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if !root.acc-reg: Pill {
                            text: @tr("Войти");
                            enabled: !root.acc-busy;
                            clicked => {
                                root.acc-login(acc-mail.text, acc-pw.text);
                            }
                        }

                        if !root.acc-reg: Pill {
                            text: @tr("Забыл пароль");
                            primary: false;
                            enabled: !root.acc-busy;
                            clicked => {
                                root.acc-reset(acc-mail.text);
                            }
                        }

                        if root.acc-reg: Pill {
                            text: @tr("Создать аккаунт");
                            enabled: !root.acc-busy;
                            clicked => {
                                if acc-pw.text != root.acc-pw2 {
                                    root.acc-msg = @tr("Пароли не совпадают");
                                } else {
                                    root.acc-register(acc-mail.text, acc-pw.text);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        Text {
                            text: root.acc-reg ? @tr("Уже есть аккаунт?") : @tr("Нет аккаунта?");
                            color: Theme.dim;
                            font-size: 13px;
                        }

                        Text {
                            text: root.acc-reg ? @tr("Войти") : @tr("Зарегистрироваться");
                            color: reg-ta.has-hover ? Theme.pale1 : Theme.soft1;
                            font-size: 13px;
                            font-weight: 700;
                            reg-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.acc-reg = !root.acc-reg;
                                    root.acc-pw2 = "";
                                    root.acc-msg = "";
                                }
                            }
                        }
                    }
                }

                if root.acc-state == 1: VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: @tr("Подтверди почту {}: открой ссылку из письма. Плейлисты начнут синхронизироваться сразу после этого.", root.acc-email);
                        color: Theme.dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Pill {
                            text: @tr("Я подтвердил");
                            enabled: !root.acc-busy;
                            clicked => {
                                root.acc-check();
                            }
                        }

                        Pill {
                            text: @tr("Отправить ещё раз");
                            primary: false;
                            enabled: !root.acc-busy;
                            clicked => {
                                root.acc-resend();
                            }
                        }

                        Pill {
                            text: @tr("Выйти");
                            primary: false;
                            clicked => {
                                root.acc-logout();
                            }
                        }
                    }
                }

                if root.acc-busy || root.acc-msg != "": Text {
                    text: root.acc-busy ? @tr("Секунду…") : root.acc-msg;
                    color: Theme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }

    intro-layer := Rectangle {
        // интро не закрывается само — ждёт кнопку "Продолжить", потом плавно гаснет
        property <bool> leaving: root.intro-gone;
        property <length> cx: self.width / 2;
        property <length> cy: self.height / 2 - 40px;
        width: 100%;
        height: 100%;
        background: #07060b;
        opacity: self.leaving ? 0 : 1;
        visible: self.opacity > 0.01;
        animate opacity { duration: 500ms; easing: ease-in-out; }

        TouchArea {} // клики не проваливаются в плеер под интро

        Rectangle {

            // свечение диска
            Rectangle {
                width: 60px + 500px * root.out-expo(root.ip(300, 1400));
                height: self.width;
                x: intro-layer.cx - self.width / 2;
                y: intro-layer.cy - self.height / 2;
                background: @radial-gradient(circle, Theme.soft1.transparentize(0.67) 0%, Theme.soft1.transparentize(1) 70%);
            }

            // засасывание: кольца стягиваются в центр и гаснут
            for r in [1400, 1050, 760]: Rectangle {
                property <float> k: root.ip(0, 1000) * root.ip(0, 1000) * root.ip(0, 1000);
                width: (r + (150 - r) * self.k) * 1px;
                height: self.width;
                x: intro-layer.cx - self.width / 2;
                y: intro-layer.cy - self.height / 2;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: Theme.soft1.transparentize(1 - 0.5 * (1 - self.k));
            }

            // ударная волна, когда лого "родилось"
            Rectangle {
                property <float> k: root.ip(1050, 1100);
                width: 150px + 1350px * root.out-expo(self.k);
                height: self.width;
                x: intro-layer.cx - self.width / 2;
                y: intro-layer.cy - self.height / 2;
                border-radius: self.width / 2;
                border-width: 3px;
                border-color: Theme.soft2.transparentize(self.k);
                visible: self.k > 0 && self.k < 1;
            }

            Image {
                property <float> k: root.out-expo(root.ip(250, 1500));
                width: 170px;
                height: 170px;
                x: intro-layer.cx - self.width / 2;
                y: intro-layer.cy - self.height / 2 - 90px * root.smooth(root.ip(1450, 650));
                source: @image-url("../assets/logo-mark.svg");
                opacity: root.ip(250, 500);
                transform-scale: 0.05 + 0.95 * self.k;
                transform-rotation: -1080deg * (1 - self.k);
            }

            title := Text {
                text: "Gargantua";
                font-size: 46px;
                font-weight: 800;
                color: Theme.text;
                letter-spacing: 30px - 29px * root.out-expo(root.ip(1650, 1000));
                x: intro-layer.cx - self.width / 2;
                y: intro-layer.cy + 10px;
                opacity: root.ip(1650, 600);
            }

            // светящаяся черта под названием разъезжается от центра
            Rectangle {
                width: 220px * root.out-cubic(root.ip(1900, 700));
                height: 2px;
                x: intro-layer.cx - self.width / 2;
                y: title.y + title.height + 8px;
                background: @linear-gradient(90deg, Theme.c1.transparentize(1) 0%, Theme.soft2 50%, Theme.c1.transparentize(1) 100%);
            }

            Text {
                text: @tr("все сервисы · одна дыра");
                font-size: 15px;
                color: Theme.dim;
                x: intro-layer.cx - self.width / 2;
                y: title.y + title.height + 22px;
                opacity: root.ip(2050, 500);
            }

            tagline := Text {
                text: @tr("Полностью бесплатный музыкальный плеер с открытым кодом и поддержкой нескольких стриминговых сервисов.\nРазработчик — qweowix");
                width: min(620px, intro-layer.width - 64px);
                x: intro-layer.cx - self.width / 2;
                y: title.y + title.height + 64px;
                font-size: 14px;
                color: #b9b1cf;
                wrap: word-wrap;
                horizontal-alignment: center;
                opacity: root.ip(2350, 700);
            }

            Pill {
                text: @tr("Продолжить");
                width: 220px;
                x: intro-layer.cx - self.width / 2;
                y: tagline.y + tagline.height + 30px;
                opacity: root.ip(2800, 500);
                enabled: root.intro-t > 2900;
                clicked => {
                    root.intro-gone = true;
                }
            }
        }
    }
}
