import { ListView } from "std-widgets.slint";

export struct TrackItem {
    title: string,
    artist: string,
    source: string,
    duration: string,
    cover: image,
    cover-url: string,
    has-cover: bool,
    playing: bool,
    snip: bool,
    dl: int, // 0 не скачан, 1 качается, 2 скачан
    liked: bool, // в «Любимых треках»
    smart: bool, // подмешан умным перемешиванием — в очереди со звёздочкой
}

export struct Credit {
    label: string,
    url: string,
}

export struct LyrRow {
    text: string,
    chars: [string], // буквы по отдельности — для анимаций рассыпания/сборки
    pre: [string],   // ряд до k-й буквы включительно — точные позиции букв с кернингом
    a: float, // с какой доли строки начинается ряд (для караоке-заливки)
    b: float,
}

export struct LyrLine {
    text: string, // строка целиком — для панели «Сейчас играет», там она переносится по своей ширине
    rows: [LyrRow],
    top: float, // смещение строки в px от начала текста
    empty: bool,
    right: bool, // второй исполнитель (дуэт/бэк-вокал у Apple) — по правому краю
    dots: bool,  // проигрыш: "•••"
    bg: bool,    // бэк-вокал: мелко под основной строкой
    tr: [string], // перевод строки рядами — мелко под ней, без анимаций
}

export struct Card {
    title: string,
    sub: string,
    cover: image,
    cover-url: string,
    has-cover: bool,
}

// устройство аккаунта в Connect
export struct ConnDev {
    id: string,
    name: string,
    phone: bool,
    active: bool, // звук сейчас тут
    me: bool,
}

export struct PlItem {
    name: string,
    count: int,
    liked: bool, // «Любимые треки»: всегда первые, ♥ вместо ноты, в них — только сердечком
}

// статистика: день в клетках «как на GitHub» (level -1 — день ещё не наступил)
export struct HeatCell {
    level: int,
    tip: string,
}

// заметка к моменту трека: время текстом, сама заметка и место на полосе прогресса (0..1)
export struct NoteItem {
    time: string,
    text: string,
    frac: float,
    tip: string, // подсказка у точки на полосе: время и начало текста
}

// строка итогов: название, подпись (артист или время), число справа
export struct RecapRow {
    a: string,
    b: string,
    n: string,
}

export struct MonthMark {
    col: int,
    text: string,
}

export struct KeyBind {
    name: string,
    key: string,
}

// Заливка звучащей строки как ломаная по времени: текущее слово и два следующих (с — секунды трека,
// a→b — доля строки). Rust обновляет окно 20 раз в секунду, а считается заливка каждый кадр
export struct LyrWin {
    s1: float, e1: float, a1: float, b1: float,
    s2: float, e2: float, a2: float, b2: float,
    s3: float, e3: float, a3: float, b3: float,
}

export struct StatArtist {
    name: string,
    time: string,
}

// цвета темы: Rust выставляет id из настроек. Тёмные фоны общие, меняются акценты и подсветка
export global Theme {
    in-out property <int> id: 0;
    out property <color> text: #f3eefc;
    out property <color> dim: #8e87a6;
    out property <color> faint: #6f6888;
    out property <color> line: #ffffff12;
    // 0 горизонт событий, 1 океан, 2 токсик, 3 сакура, 4 закат, 5 моно, 6–14 ещё девять, последний — из обложки (цвета ставит Rust)
    in-out property <color> cov-c1: #a855f7;
    in-out property <color> cov-c2: #ff7a3d;
    in-out property <color> cov-soft1: #b46cff;
    in-out property <color> cov-pale1: #d6b4ff;
    in-out property <color> cov-soft2: #ffa36b;
    in-out property <color> cov-deep1: #2a1748;
    in-out property <color> cov-deep2: #3a1608;
    in-out property <color> cov-glow: #6d28d9;
    property <[color]> c1s: [#a855f7, #3b82f6, #22c55e, #ec4899, #f59e0b, #a1a1aa, #57ddf7, #f76c57, #7f57f7, #57f7a7, #5771f7, #f7cf57, #57f7cf, #f75771, #f78c57, self.cov-c1];
    property <[color]> c2s: [#ff7a3d, #22d3ee, #a3e635, #fb7185, #ef4444, #e4e4e7, #ff40ff, #ffaf40, #ff40bf, #9f40ff, #40cfff, #ff7940, #9fff40, #ff7040, #ff4080, self.cov-c2];
    property <[color]> soft1s: [#b46cff, #60a5fa, #4ade80, #f472b6, #fbbf24, #d4d4d8, #6be6ff, #ff7f6b, #906bff, #6bffb5, #6b84ff, #ffda6b, #6bffda, #ff6b84, #ff9c6b, self.cov-soft1];
    property <[color]> pale1s: [#d6b4ff, #bfdbfe, #bbf7d0, #fbcfe8, #fde68a, #f4f4f5, #b2f2ff, #ffbdb2, #c6b2ff, #b2ffd9, #b2bfff, #ffecb2, #b2ffec, #ffb2bf, #ffccb2, self.cov-pale1];
    property <[color]> soft2s: [#ffa36b, #67e8f9, #bef264, #fda4af, #f87171, #fafafa, #ff6bff, #ffc16b, #ff6bce, #b56bff, #6bdaff, #ff976b, #b5ff6b, #ff906b, #ff6b9c, self.cov-soft2];
    property <[color]> deep1s: [#2a1748, #0f2448, #0f3320, #3f1030, #3a2508, #1f1f23, #173f47, #471d17, #231747, #17472f, #171f47, #473b17, #17473b, #47171f, #472717, self.cov-deep1];
    property <[color]> deep2s: [#3a1608, #083344, #1f330a, #3f0f1a, #3a0d0d, #2a2a2e, #3b093b, #3b2609, #3b092a, #22093b, #092e3b, #3b1809, #223b09, #3b1509, #3b0919, self.cov-deep2];
    property <[color]> glows: [#6d28d9, #1d4ed8, #15803d, #be185d, #b45309, #52525b, #27bbd9, #d93f27, #5327d9, #27d980, #2745d9, #d9ac27, #27d9ac, #d92745, #d96227, self.cov-glow];
    out property <color> c1: self.c1s[self.id];       // главный акцент
    out property <color> c2: self.c2s[self.id];       // второй конец градиента
    out property <color> soft1: self.soft1s[self.id]; // светлее главного: подсветки, иконки
    out property <color> pale1: self.pale1s[self.id]; // почти белый с оттенком: ссылки при наведении
    out property <color> soft2: self.soft2s[self.id]; // светлее второго: «играет», статусы
    out property <color> deep1: self.deep1s[self.id]; // тёмные подложки обложек
    out property <color> deep2: self.deep2s[self.id];
    out property <color> glow: self.glows[self.id];   // фоновое свечение окна
    out property <brush> accent: @linear-gradient(120deg, self.c1 0%, self.c2 100%);
}

